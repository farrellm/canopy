cabal-version:      3.14
name:               tendril
version:            0.1.0.0
synopsis:           A readline-style line editor
description:
  A pure editing model, keymaps, host input decoding and an inline
  renderer, with highlighting, completion, hints and validation as effects
  (DESIGN.md §5).

license:            BSD-3-Clause
license-file:       LICENSE
author:             Matthew Farrell
maintainer:         farrellm@alum.mit.edu
category:           Terminal
build-type:         Simple
tested-with:        GHC ==9.12.4

-- DESIGN.md §2.4. CI adds -Werror from the command line. The two common stanzas
-- are copied into every package; scripts/check-common-stanzas.sh keeps them equal.
common warnings
  ghc-options:
    -Wall -Wcompat -Widentities -Wincomplete-record-updates
    -Wincomplete-uni-patterns -Wmissing-export-lists -Wpartial-fields
    -Wredundant-constraints -Wmissing-deriving-strategies -Wunused-type-patterns

common extensions
  default-extensions:
    OverloadedRecordDot
    OverloadedStrings
    OverloadedLabels

library
  import:           warnings, extensions
  exposed-modules:
    Tendril
    Tendril.Edit.Command
    Tendril.Edit.KillRing
    Tendril.Edit.Motion
    Tendril.Edit.Register
    Tendril.Edit.Selection
    Tendril.Edit.Undo
    Tendril.Keymap
    Tendril.Keymap.Emacs
    Tendril.Term.Input
    Tendril.Text.Buffer
    Tendril.Text.Grapheme
    Tendril.Text.Unicode.Tables
    Tendril.Text.Units
    Tendril.Text.Width

  other-modules:    Paths_tendril
  autogen-modules:  Paths_tendril
  hs-source-dirs:   src
  build-depends:
    , base ^>=4.21.2.0
    , bytestring ^>=0.12
    , canopy-prelude
    , containers ^>=0.7
    , text ^>=2.1
    , text-rope ^>=0.3

  mixins:
    base hiding (Prelude),
    canopy-prelude (Canopy.Prelude as Prelude)

  default-language: GHC2024

executable tendril-demo
  import:           warnings, extensions
  main-is:          Main.hs
  hs-source-dirs:   demo
  build-depends:
    , base ^>=4.21.2.0
    , canopy-prelude
    , tendril

  mixins:
    base hiding (Prelude),
    canopy-prelude (Canopy.Prelude as Prelude)

  default-language: GHC2024

-- The test suite's dependency on ghostty-effectful is the one edge from
-- tendril to ghostty, and it is test-only (§1.3, §11.2: the oracle).
test-suite tendril-test
  import:           warnings, extensions
  type:             exitcode-stdio-1.0
  hs-source-dirs:   test
  main-is:          Main.hs
  other-modules:
    Test.Tendril
    Test.Tendril.Edit.Command
    Test.Tendril.Edit.KillRing
    Test.Tendril.Edit.Mode
    Test.Tendril.Edit.Undo
    Test.Tendril.Keymap
    Test.Tendril.Keymap.Emacs
    Test.Tendril.Term.Input
    Test.Tendril.Text.Buffer
    Test.Tendril.Text.Gen
    Test.Tendril.Text.Grapheme
    Test.Tendril.Text.Grapheme.Conformance
    Test.Tendril.Text.Oracle
    Test.Tendril.Text.Unicode
    Test.Tendril.Text.Unicode.Expected
    Test.Tendril.Text.Units
    Test.Tendril.Text.Width

  build-depends:
    , base ^>=4.21.2.0
    , bytestring ^>=0.12
    , canopy-prelude
    , effectful-core ^>=2.7.1
    , ghostty-effectful
    , QuickCheck ^>=2.19
    , tasty ^>=1.5
    , tasty-hunit ^>=0.10.2
    , tasty-quickcheck ^>=0.11.1
    , tendril
    , text ^>=2.1
    , text-rope ^>=0.3

  mixins:
    base hiding (Prelude),
    canopy-prelude (Canopy.Prelude as Prelude)

  default-language: GHC2024

-- DESIGN.md §12.3. Compiled with -O2, and -T so allocation is reported beside
-- time; the library is at cabal's default optimization, as in every build.
-- CI gates allocation against bench/baseline/ (§2.8 step 8).
benchmark tendril-bench
  import:           warnings, extensions
  type:             exitcode-stdio-1.0
  hs-source-dirs:   bench
  main-is:          Main.hs
  other-modules:    Bench.Tendril.Edit
  ghc-options:      -O2 -with-rtsopts=-T
  build-depends:
    , base ^>=4.21.2.0
    , canopy-prelude
    , tasty-bench ^>=0.5.1
    , tendril
    , text ^>=2.1

  mixins:
    base hiding (Prelude),
    canopy-prelude (Canopy.Prelude as Prelude)

  default-language: GHC2024
