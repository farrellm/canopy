    { name = "GhosttyModeReportState",
      size = (#size GhosttyModeReportState),
      values =
        [ ("GHOSTTY_MODE_REPORT_NOT_RECOGNIZED", (#const GHOSTTY_MODE_REPORT_NOT_RECOGNIZED)),
