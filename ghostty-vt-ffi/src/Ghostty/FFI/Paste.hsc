#include <gvtffi_shims.h>

-- | @GhosttyPasteSource@: Why a paste happened.
newtype GhosttyPasteSource = GhosttyPasteSource CInt
  deriving stock (Eq, Show)
  deriving newtype (Storable)

-- | @GHOSTTY_PASTE_SOURCE_CLIPBOARD@: The user pasted from a clipboard: keybind, menu, middle click.
pattern GhosttyPasteSourceClipboard :: GhosttyPasteSource
pattern GhosttyPasteSourceClipboard = GhosttyPasteSource (#const GHOSTTY_PASTE_SOURCE_CLIPBOARD)

-- | @GHOSTTY_PASTE_SOURCE_TEXT@: Text inserted some other way: IME commit, drag and drop, scripted input. Always written as text, never as a paste event, matching kitty. This is not a way to opt out of paste events; an embedder that doesn\'t want them doesn\'t install a clipboard\_read callback.
pattern GhosttyPasteSourceText :: GhosttyPasteSource
pattern GhosttyPasteSourceText = GhosttyPasteSource (#const GHOSTTY_PASTE_SOURCE_TEXT)

-- | Any value this binding does not name: a newer library's.
pattern GhosttyPasteSourceUnknown :: CInt -> GhosttyPasteSource
pattern GhosttyPasteSourceUnknown n <- GhosttyPasteSource (unnamed ghosttyPasteSourceEnum -> Just n)
  where
    GhosttyPasteSourceUnknown n = GhosttyPasteSource n

