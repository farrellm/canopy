  #-}

-- | Every value of @GhosttyPasteSource@, for the layout test (§3.4). It is also what
-- 'GhosttyPasteSourceUnknown' excludes.
ghosttyPasteSourceEnum :: CEnum
ghosttyPasteSourceEnum =
  CEnum
    { name = "GhosttyPasteSource",
      size = (#size GhosttyPasteSource),
      values =
        [ ("GHOSTTY_PASTE_SOURCE_CLIPBOARD", (#const GHOSTTY_PASTE_SOURCE_CLIPBOARD)),
          ("GHOSTTY_PASTE_SOURCE_TEXT", (#const GHOSTTY_PASTE_SOURCE_TEXT))
        ]
    }

-- | @GhosttyPaste@: A paste of clipboard contents into the terminal.
data GhosttyPaste = GhosttyPaste
  { -- | @size@: Size of this struct in bytes.
    size :: CSize,
    -- | @location@: The clipboard the contents came from. Reported to the program on a paste event (the selection and primary locations are both reported as the primary selection, the protocol knows only two); no effect on a text paste.
    location :: GhosttyClipboardLocation,
    -- | @source@: Why this paste happened.
    source :: GhosttyPasteSource,
    -- | @mimes@: Borrowed array of the MIME types of the representations available, in preferred order. A text paste reads and writes the first entry with a text MIME type such as \"text\/plain\" and ignores the rest. A paste event lists every entry and reads none. May be NULL when mimes\_len is zero, which is nothing to paste.
    mimes :: Ptr GhosttyString,
    -- | @mimes_len@: Number of entries in mimes.
    mimesLen :: CSize,
    -- | @reader@: Produces the data of a representation on demand. Required when mimes\_len is nonzero.
    reader :: GhosttyMimeReader,
    -- | @allow_unsafe@: Write text that could inject commands. Call with false, confirm with the user on GHOSTTY\_REJECTED, and call again with true.
    allowUnsafe :: CBool
  }
  deriving stock (Eq, Show)

instance Storable GhosttyPaste where
  sizeOf _ = (#size GhosttyPaste)
  alignment _ = (#alignment GhosttyPaste)
  peek p =
    GhosttyPaste
      <$> (#peek GhosttyPaste, size) p
      <*> (#peek GhosttyPaste, location) p
      <*> (#peek GhosttyPaste, source) p
      <*> (#peek GhosttyPaste, mimes) p
      <*> (#peek GhosttyPaste, mimes_len) p
      <*> (#peek GhosttyPaste, reader) p
      <*> (#peek GhosttyPaste, allow_unsafe) p
  poke p s = do
    (#poke GhosttyPaste, size) p s.size
    (#poke GhosttyPaste, location) p s.location
    (#poke GhosttyPaste, source) p s.source
    (#poke GhosttyPaste, mimes) p s.mimes
    (#poke GhosttyPaste, mimes_len) p s.mimesLen
    (#poke GhosttyPaste, reader) p s.reader
    (#poke GhosttyPaste, allow_unsafe) p s.allowUnsafe

-- | The layout of @GhosttyPaste@ as compiled, for the layout test (§3.4).
ghosttyPasteLayout :: CStruct
ghosttyPasteLayout =
  CStruct
    { name = "GhosttyPaste",
      size = (#size GhosttyPaste),
      align = (#alignment GhosttyPaste),
      fields =
        [ CField "size" (#offset GhosttyPaste, size) (#const GVTFFI_FIELD_SIZE(GhosttyPaste, size)),
          CField "location" (#offset GhosttyPaste, location) (#const GVTFFI_FIELD_SIZE(GhosttyPaste, location)),
          CField "source" (#offset GhosttyPaste, source) (#const GVTFFI_FIELD_SIZE(GhosttyPaste, source)),
          CField "mimes" (#offset GhosttyPaste, mimes) (#const GVTFFI_FIELD_SIZE(GhosttyPaste, mimes)),
          CField "mimes_len" (#offset GhosttyPaste, mimes_len) (#const GVTFFI_FIELD_SIZE(GhosttyPaste, mimes_len)),
          CField "reader" (#offset GhosttyPaste, reader) (#const GVTFFI_FIELD_SIZE(GhosttyPaste, reader)),
          CField "allow_unsafe" (#offset GhosttyPaste, allow_unsafe) (#const GVTFFI_FIELD_SIZE(GhosttyPaste, allow_unsafe))
        ]
    }

-- | @ghostty_terminal_paste@: paste into a terminal by its current modes. The
-- output goes to the @WRITE_PTY@ callback in chunks, in order; nothing is
-- written on an error. @GHOSTTY_REJECTED@ (nothing written) when the text
-- could inject commands and @allow_unsafe@ is false, and
-- @GHOSTTY_INVALID_VALUE@ without a @WRITE_PTY@ callback. The out flag (which
-- may be null) says whether anything was written. @safe@: it calls the MIME
-- reader and the @WRITE_PTY@ callback, which may be a Haskell function.
foreign import capi safe "ghostty/vt.h ghostty_terminal_paste"
  ghosttyTerminalPaste :: GhosttyTerminal -> Ptr GhosttyPaste -> Ptr CBool -> IO GhosttyResult

-- | @ghostty_paste_is_safe@: whether data holds nothing that could inject
-- commands (a newline or carriage return, or the bracketed-paste end
-- sequence), whatever the terminal's modes; stricter than
-- 'ghosttyTerminalPaste''s own rule. @unsafe@: it calls nothing back, and is
-- one pass over the data (above).
foreign import capi unsafe "ghostty/vt.h ghostty_paste_is_safe"
  ghosttyPasteIsSafe :: Ptr CChar -> CSize -> IO CBool

-- | @ghostty_paste_encode@: encode paste data for the pty: unsafe control bytes
-- become spaces, then the data is bracketed, or has its newlines made
-- carriage returns. __It modifies the input in place.__ A null buffer, or one
-- too small, returns @GHOSTTY_OUT_OF_SPACE@ with the size needed. @unsafe@:
-- it calls nothing back, and is one pass over the data (above).
foreign import capi unsafe "ghostty/vt.h ghostty_paste_encode"
  ghosttyPasteEncode :: Ptr CChar -> CSize -> CBool -> Ptr CChar -> CSize -> Ptr CSize -> IO GhosttyResult
