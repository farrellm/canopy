      <*> (#peek GhosttyClipboardReadReply, contents_len) p
      <*> (#peek GhosttyClipboardReadReply, available) p
      <*> (#peek GhosttyClipboardReadReply, available_len) p
      <*> (#peek GhosttyClipboardReadReply, remember) p
