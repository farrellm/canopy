          ("GHOSTTY_PROGRAM_STATUS_KIND_PERMISSION", (#const GHOSTTY_PROGRAM_STATUS_KIND_PERMISSION)),
          ("GHOSTTY_PROGRAM_STATUS_KIND_QUESTION", (#const GHOSTTY_PROGRAM_STATUS_KIND_QUESTION)),
