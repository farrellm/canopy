-- * Adjusting and comparing

-- | @GhosttySelectionAdjust@: Operation used to adjust a selection endpoint.
newtype GhosttySelectionAdjust = GhosttySelectionAdjust CInt
  deriving stock (Eq, Show)
  deriving newtype (Storable)

-- | @GHOSTTY_SELECTION_ADJUST_LEFT@: Move left to the previous non-empty cell, wrapping upward.
pattern GhosttySelectionAdjustLeft :: GhosttySelectionAdjust
pattern GhosttySelectionAdjustLeft = GhosttySelectionAdjust (#const GHOSTTY_SELECTION_ADJUST_LEFT)

-- | @GHOSTTY_SELECTION_ADJUST_RIGHT@: Move right to the next non-empty cell, wrapping downward.
pattern GhosttySelectionAdjustRight :: GhosttySelectionAdjust
pattern GhosttySelectionAdjustRight = GhosttySelectionAdjust (#const GHOSTTY_SELECTION_ADJUST_RIGHT)

-- | @GHOSTTY_SELECTION_ADJUST_UP@: Move up one row at the current column, or to the beginning of the line if already at the top.
pattern GhosttySelectionAdjustUp :: GhosttySelectionAdjust
pattern GhosttySelectionAdjustUp = GhosttySelectionAdjust (#const GHOSTTY_SELECTION_ADJUST_UP)

-- | @GHOSTTY_SELECTION_ADJUST_DOWN@: Move down to the next non-blank row at the current column, or to the end of the line if none exists.
pattern GhosttySelectionAdjustDown :: GhosttySelectionAdjust
pattern GhosttySelectionAdjustDown = GhosttySelectionAdjust (#const GHOSTTY_SELECTION_ADJUST_DOWN)

-- | @GHOSTTY_SELECTION_ADJUST_HOME@: Move to the top-left cell of the screen.
pattern GhosttySelectionAdjustHome :: GhosttySelectionAdjust
pattern GhosttySelectionAdjustHome = GhosttySelectionAdjust (#const GHOSTTY_SELECTION_ADJUST_HOME)

-- | @GHOSTTY_SELECTION_ADJUST_END@: Move to the right edge of the last non-blank row on the screen.
pattern GhosttySelectionAdjustEnd :: GhosttySelectionAdjust
pattern GhosttySelectionAdjustEnd = GhosttySelectionAdjust (#const GHOSTTY_SELECTION_ADJUST_END)

-- | @GHOSTTY_SELECTION_ADJUST_PAGE_UP@: Move up by one terminal page height, or to home if that would move past the top.
pattern GhosttySelectionAdjustPageUp :: GhosttySelectionAdjust
pattern GhosttySelectionAdjustPageUp = GhosttySelectionAdjust (#const GHOSTTY_SELECTION_ADJUST_PAGE_UP)

-- | @GHOSTTY_SELECTION_ADJUST_PAGE_DOWN@: Move down by one terminal page height, or to end if that would move past the bottom.
pattern GhosttySelectionAdjustPageDown :: GhosttySelectionAdjust
pattern GhosttySelectionAdjustPageDown = GhosttySelectionAdjust (#const GHOSTTY_SELECTION_ADJUST_PAGE_DOWN)

-- | @GHOSTTY_SELECTION_ADJUST_BEGINNING_OF_LINE@: Move to the left edge of the current line.
pattern GhosttySelectionAdjustBeginningOfLine :: GhosttySelectionAdjust
pattern GhosttySelectionAdjustBeginningOfLine = GhosttySelectionAdjust (#const GHOSTTY_SELECTION_ADJUST_BEGINNING_OF_LINE)

-- | @GHOSTTY_SELECTION_ADJUST_END_OF_LINE@: Move to the right edge of the current line.
pattern GhosttySelectionAdjustEndOfLine :: GhosttySelectionAdjust
pattern GhosttySelectionAdjustEndOfLine = GhosttySelectionAdjust (#const GHOSTTY_SELECTION_ADJUST_END_OF_LINE)

-- | Any value this binding does not name: a newer library's.
pattern GhosttySelectionAdjustUnknown :: CInt -> GhosttySelectionAdjust
pattern GhosttySelectionAdjustUnknown n <- GhosttySelectionAdjust (unnamed ghosttySelectionAdjustEnum -> Just n)
  where
    GhosttySelectionAdjustUnknown n = GhosttySelectionAdjust n

