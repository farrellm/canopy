-- | @GHOSTTY_SELECTION_GESTURE_EVENT_OPT_BEHAVIORS@: Selection behavior table: GhosttySelectionGestureBehaviors\*.
pattern GhosttySelectionGestureEventOptBehaviors :: GhosttySelectionGestureEventOption
pattern GhosttySelectionGestureEventOptBehaviors = GhosttySelectionGestureEventOption (#const GHOSTTY_SELECTION_GESTURE_EVENT_OPT_BEHAVIORS)

-- | @GHOSTTY_SELECTION_GESTURE_EVENT_OPT_RECTANGLE@: Whether a drag or autoscroll tick should produce a rectangular selection: bool\*.
pattern GhosttySelectionGestureEventOptRectangle :: GhosttySelectionGestureEventOption
pattern GhosttySelectionGestureEventOptRectangle = GhosttySelectionGestureEventOption (#const GHOSTTY_SELECTION_GESTURE_EVENT_OPT_RECTANGLE)

-- | @GHOSTTY_SELECTION_GESTURE_EVENT_OPT_GEOMETRY@: Drag display geometry: GhosttySelectionGestureGeometry\*. Required for DRAG and AUTOSCROLL\_TICK.
pattern GhosttySelectionGestureEventOptGeometry :: GhosttySelectionGestureEventOption
pattern GhosttySelectionGestureEventOptGeometry = GhosttySelectionGestureEventOption (#const GHOSTTY_SELECTION_GESTURE_EVENT_OPT_GEOMETRY)

-- | @GHOSTTY_SELECTION_GESTURE_EVENT_OPT_VIEWPORT@: Viewport coordinate for an autoscroll tick: GhosttyPointCoordinate\*. Required for AUTOSCROLL\_TICK.
pattern GhosttySelectionGestureEventOptViewport :: GhosttySelectionGestureEventOption
pattern GhosttySelectionGestureEventOptViewport = GhosttySelectionGestureEventOption (#const GHOSTTY_SELECTION_GESTURE_EVENT_OPT_VIEWPORT)

-- | Any value this binding does not name: a newer library's.
pattern GhosttySelectionGestureEventOptionUnknown :: CInt -> GhosttySelectionGestureEventOption
pattern GhosttySelectionGestureEventOptionUnknown n <- GhosttySelectionGestureEventOption (unnamed ghosttySelectionGestureEventOptionEnum -> Just n)
  where
    GhosttySelectionGestureEventOptionUnknown n = GhosttySelectionGestureEventOption n

