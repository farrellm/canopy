      size = (#size GhosttySelectionGestureBehaviors),
      align = (#alignment GhosttySelectionGestureBehaviors),
      fields =
        [ CField "single_click" (#offset GhosttySelectionGestureBehaviors, single_click) (#const GVTFFI_FIELD_SIZE(GhosttySelectionGestureBehaviors, single_click)),
          CField "double_click" (#offset GhosttySelectionGestureBehaviors, double_click) (#const GVTFFI_FIELD_SIZE(GhosttySelectionGestureBehaviors, double_click)),
          CField "triple_click" (#offset GhosttySelectionGestureBehaviors, triple_click) (#const GVTFFI_FIELD_SIZE(GhosttySelectionGestureBehaviors, triple_click))
        ]
    }

-- | @GhosttySelectionGestureGeometry@: Display geometry used to interpret selection gesture drag events.
data GhosttySelectionGestureGeometry = GhosttySelectionGestureGeometry
  { -- | @columns@: Number of columns in the rendered terminal grid. Must be non-zero.
    columns :: Word32,
    -- | @cell_width@: Width of one terminal cell in surface pixels. Must be non-zero.
    cellWidth :: Word32,
    -- | @padding_left@: Left padding before the terminal grid begins in surface pixels.
    paddingLeft :: Word32,
    -- | @screen_height@: Height of the rendered terminal surface in surface pixels. Must be non-zero.
    screenHeight :: Word32
  }
  deriving stock (Eq, Show)

instance Storable GhosttySelectionGestureGeometry where
  sizeOf _ = (#size GhosttySelectionGestureGeometry)
  alignment _ = (#alignment GhosttySelectionGestureGeometry)
  peek p =
    GhosttySelectionGestureGeometry
      <$> (#peek GhosttySelectionGestureGeometry, columns) p
      <*> (#peek GhosttySelectionGestureGeometry, cell_width) p
      <*> (#peek GhosttySelectionGestureGeometry, padding_left) p
      <*> (#peek GhosttySelectionGestureGeometry, screen_height) p
  poke p s = do
    (#poke GhosttySelectionGestureGeometry, columns) p s.columns
    (#poke GhosttySelectionGestureGeometry, cell_width) p s.cellWidth
    (#poke GhosttySelectionGestureGeometry, padding_left) p s.paddingLeft
    (#poke GhosttySelectionGestureGeometry, screen_height) p s.screenHeight

