  deriving stock (Eq, Show)
  deriving newtype (Storable)

-- | @GHOSTTY_SELECTION_ORDER_FORWARD@: Start is before end in top-left to bottom-right order.
pattern GhosttySelectionOrderForward :: GhosttySelectionOrder
pattern GhosttySelectionOrderForward = GhosttySelectionOrder (#const GHOSTTY_SELECTION_ORDER_FORWARD)

-- | @GHOSTTY_SELECTION_ORDER_REVERSE@: End is before start in top-left to bottom-right order.
pattern GhosttySelectionOrderReverse :: GhosttySelectionOrder
pattern GhosttySelectionOrderReverse = GhosttySelectionOrder (#const GHOSTTY_SELECTION_ORDER_REVERSE)

-- | @GHOSTTY_SELECTION_ORDER_MIRRORED_FORWARD@: Rectangular selection from top-right to bottom-left.
pattern GhosttySelectionOrderMirroredForward :: GhosttySelectionOrder
pattern GhosttySelectionOrderMirroredForward = GhosttySelectionOrder (#const GHOSTTY_SELECTION_ORDER_MIRRORED_FORWARD)

-- | @GHOSTTY_SELECTION_ORDER_MIRRORED_REVERSE@: Rectangular selection from bottom-left to top-right.
pattern GhosttySelectionOrderMirroredReverse :: GhosttySelectionOrder
pattern GhosttySelectionOrderMirroredReverse = GhosttySelectionOrder (#const GHOSTTY_SELECTION_ORDER_MIRRORED_REVERSE)

-- | Any value this binding does not name: a newer library's.
