  GhosttySelectionGestureEventOptInvalid,
  GhosttySelectionGestureEventOptRef,
  GhosttySelectionGestureEventOptPosition,
  GhosttySelectionGestureEventOptRepeatDistance,
  GhosttySelectionGestureEventOptTimeNs,
  GhosttySelectionGestureEventOptRepeatIntervalNs,
  GhosttySelectionGestureEventOptWordBoundaryCodepoints,
  GhosttySelectionGestureEventOptBehaviors,
  GhosttySelectionGestureEventOptRectangle,
  GhosttySelectionGestureEventOptGeometry,
  GhosttySelectionGestureEventOptViewport,
  GhosttySelectionGestureEventOptionUnknown
  #-}

-- | Every value of @GhosttySelectionGestureEventOption@, for the layout test (§3.4). It is also what
-- 'GhosttySelectionGestureEventOptionUnknown' excludes.
ghosttySelectionGestureEventOptionEnum :: CEnum
ghosttySelectionGestureEventOptionEnum =
  CEnum
    { name = "GhosttySelectionGestureEventOption",
      size = (#size GhosttySelectionGestureEventOption),
      values =
        [ ("GHOSTTY_SELECTION_GESTURE_EVENT_OPT_INVALID", (#const GHOSTTY_SELECTION_GESTURE_EVENT_OPT_INVALID)),
          ("GHOSTTY_SELECTION_GESTURE_EVENT_OPT_REF", (#const GHOSTTY_SELECTION_GESTURE_EVENT_OPT_REF)),
          ("GHOSTTY_SELECTION_GESTURE_EVENT_OPT_POSITION", (#const GHOSTTY_SELECTION_GESTURE_EVENT_OPT_POSITION)),
          ("GHOSTTY_SELECTION_GESTURE_EVENT_OPT_REPEAT_DISTANCE", (#const GHOSTTY_SELECTION_GESTURE_EVENT_OPT_REPEAT_DISTANCE)),
          ("GHOSTTY_SELECTION_GESTURE_EVENT_OPT_TIME_NS", (#const GHOSTTY_SELECTION_GESTURE_EVENT_OPT_TIME_NS)),
          ("GHOSTTY_SELECTION_GESTURE_EVENT_OPT_REPEAT_INTERVAL_NS", (#const GHOSTTY_SELECTION_GESTURE_EVENT_OPT_REPEAT_INTERVAL_NS)),
          ("GHOSTTY_SELECTION_GESTURE_EVENT_OPT_WORD_BOUNDARY_CODEPOINTS", (#const GHOSTTY_SELECTION_GESTURE_EVENT_OPT_WORD_BOUNDARY_CODEPOINTS)),
          ("GHOSTTY_SELECTION_GESTURE_EVENT_OPT_BEHAVIORS", (#const GHOSTTY_SELECTION_GESTURE_EVENT_OPT_BEHAVIORS)),
          ("GHOSTTY_SELECTION_GESTURE_EVENT_OPT_RECTANGLE", (#const GHOSTTY_SELECTION_GESTURE_EVENT_OPT_RECTANGLE)),
          ("GHOSTTY_SELECTION_GESTURE_EVENT_OPT_GEOMETRY", (#const GHOSTTY_SELECTION_GESTURE_EVENT_OPT_GEOMETRY)),
          ("GHOSTTY_SELECTION_GESTURE_EVENT_OPT_VIEWPORT", (#const GHOSTTY_SELECTION_GESTURE_EVENT_OPT_VIEWPORT))
        ]
    }

-- | @ghostty_selection_gesture_event_set@: set an option from a pointer to its
-- value; null clears it. @unsafe@: it does not call back into Haskell.
foreign import capi unsafe "ghostty/vt.h ghostty_selection_gesture_event_set"
  ghosttySelectionGestureEventSet :: GhosttySelectionGestureEvent -> GhosttySelectionGestureEventOption -> Ptr () -> IO GhosttyResult

-- | @ghostty_selection_gesture_event@: apply an event to a gesture, writing
-- the resulting selection (which the terminal does not install) when the out
-- pointer is not null. @GHOSTTY_NO_VALUE@ when the event makes no selection,
-- as a release never does. @unsafe@: it does not call back into Haskell.
foreign import capi unsafe "ghostty/vt.h ghostty_selection_gesture_event"
  ghosttySelectionGestureEvent :: GhosttySelectionGesture -> GhosttyTerminal -> GhosttySelectionGestureEvent -> Ptr GhosttySelection -> IO GhosttyResult
