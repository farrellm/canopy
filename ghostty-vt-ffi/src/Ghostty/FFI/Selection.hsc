      align = (#alignment GhosttySelectionGestureGeometry),
      fields =
        [ CField "columns" (#offset GhosttySelectionGestureGeometry, columns) (#const GVTFFI_FIELD_SIZE(GhosttySelectionGestureGeometry, columns)),
          CField "cell_width" (#offset GhosttySelectionGestureGeometry, cell_width) (#const GVTFFI_FIELD_SIZE(GhosttySelectionGestureGeometry, cell_width)),
          CField "padding_left" (#offset GhosttySelectionGestureGeometry, padding_left) (#const GVTFFI_FIELD_SIZE(GhosttySelectionGestureGeometry, padding_left)),
          CField "screen_height" (#offset GhosttySelectionGestureGeometry, screen_height) (#const GVTFFI_FIELD_SIZE(GhosttySelectionGestureGeometry, screen_height))
        ]
    }

