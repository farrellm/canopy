-- | @GhosttyColorPaletteMask@: a set of palette indices, 256 bits. Index @i@ is
-- in it when bit @i mod 64@ of word @i div 64@ is set.
newtype GhosttyColorPaletteMask = GhosttyColorPaletteMask
  { -- | @bits@: the whole fixed-size array of words. A 'peek' reads every
    -- element; a 'poke' writes the list's first elements and zeroes the rest.
    bits :: [Word64]
  }
  deriving stock (Eq, Show)

-- | How many elements @bits@ has in C.
bitsLen :: Int
bitsLen = (#const GVTFFI_ARRAY_LEN(GhosttyColorPaletteMask, bits))

instance Storable GhosttyColorPaletteMask where
  sizeOf _ = (#size GhosttyColorPaletteMask)
  alignment _ = (#alignment GhosttyColorPaletteMask)
  peek p = GhosttyColorPaletteMask <$> peekArray bitsLen ((#ptr GhosttyColorPaletteMask, bits) p)
  poke p m = pokeArray ((#ptr GhosttyColorPaletteMask, bits) p) (take bitsLen (m.bits <> repeat 0))

-- | The layout of @GhosttyColorPaletteMask@ as compiled, for the layout test (§3.4).
ghosttyColorPaletteMaskLayout :: CStruct
ghosttyColorPaletteMaskLayout =
  CStruct
    { name = "GhosttyColorPaletteMask",
      size = (#size GhosttyColorPaletteMask),
      align = (#alignment GhosttyColorPaletteMask),
      fields =
        [ CField "bits" (#offset GhosttyColorPaletteMask, bits) (#const GVTFFI_FIELD_SIZE(GhosttyColorPaletteMask, bits))
        ]
    }

