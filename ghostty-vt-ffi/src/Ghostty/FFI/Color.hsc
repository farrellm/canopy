-- * X11 names

-- | @GhosttyColorX11Entry@: An entry in Ghostty\'s X11 color name table.
data GhosttyColorX11Entry = GhosttyColorX11Entry
  { -- | @name@: Null-terminated color name. NULL marks the end of the table.
    name :: Ptr CChar,
    -- | @color@: The RGB value of the color.
    color :: GhosttyColorRgb
  }
  deriving stock (Eq, Show)

instance Storable GhosttyColorX11Entry where
  sizeOf _ = (#size GhosttyColorX11Entry)
  alignment _ = (#alignment GhosttyColorX11Entry)
  peek p =
    GhosttyColorX11Entry
      <$> (#peek GhosttyColorX11Entry, name) p
      <*> (#peek GhosttyColorX11Entry, color) p
  poke p s = do
    (#poke GhosttyColorX11Entry, name) p s.name
    (#poke GhosttyColorX11Entry, color) p s.color

-- | The layout of @GhosttyColorX11Entry@ as compiled, for the layout test (§3.4).
ghosttyColorX11EntryLayout :: CStruct
ghosttyColorX11EntryLayout =
  CStruct
    { name = "GhosttyColorX11Entry",
      size = (#size GhosttyColorX11Entry),
      align = (#alignment GhosttyColorX11Entry),
      fields =
        [ CField "name" (#offset GhosttyColorX11Entry, name) (#const GVTFFI_FIELD_SIZE(GhosttyColorX11Entry, name)),
          CField "color" (#offset GhosttyColorX11Entry, color) (#const GVTFFI_FIELD_SIZE(GhosttyColorX11Entry, color))
        ]
    }

