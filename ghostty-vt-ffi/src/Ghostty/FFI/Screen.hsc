          ("GHOSTTY_ROW_DATA_KITTY_VIRTUAL_PLACEHOLDER", (#const GHOSTTY_ROW_DATA_KITTY_VIRTUAL_PLACEHOLDER)),
          ("GHOSTTY_ROW_DATA_DIRTY", (#const GHOSTTY_ROW_DATA_DIRTY))
        ]
    }

-- | @ghostty_row_get@: read one key of a row into a pointer of its output
-- type. @unsafe@: it does not call back into Haskell.
foreign import capi unsafe "ghostty/vt.h ghostty_row_get"
  ghosttyRowGet :: GhosttyRow -> GhosttyRowData -> Ptr () -> IO GhosttyResult

-- | @ghostty_row_get_multi@: read several keys in one call, as
-- 'ghosttyCellGetMulti'. @unsafe@: it does not call back into Haskell.
foreign import capi unsafe "ghostty/vt.h ghostty_row_get_multi"
  ghosttyRowGetMulti :: GhosttyRow -> CSize -> Ptr GhosttyRowData -> Ptr (Ptr ()) -> Ptr CSize -> IO GhosttyResult
