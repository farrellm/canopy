-- | @GhosttyCell@: an opaque packed cell value. Read it with 'ghosttyCellGet'.
type GhosttyCell = Word64

-- | @GhosttyRow@: an opaque packed row value. Read it with 'ghosttyRowGet'.
type GhosttyRow = Word64

-- | @GhosttyCellsView@: A borrowed view of contiguous raw cell values.
data GhosttyCellsView = GhosttyCellsView
  { -- | @ptr@: Pointer to len contiguous cell values.
    ptr :: Ptr GhosttyCell,
    -- | @len@: Number of cells.
    len :: CSize
  }
  deriving stock (Eq, Show)

instance Storable GhosttyCellsView where
  sizeOf _ = (#size GhosttyCellsView)
  alignment _ = (#alignment GhosttyCellsView)
  peek p =
    GhosttyCellsView
      <$> (#peek GhosttyCellsView, ptr) p
      <*> (#peek GhosttyCellsView, len) p
  poke p s = do
    (#poke GhosttyCellsView, ptr) p s.ptr
    (#poke GhosttyCellsView, len) p s.len

-- | The layout of @GhosttyCellsView@ as compiled, for the layout test (§3.4).
ghosttyCellsViewLayout :: CStruct
ghosttyCellsViewLayout =
  CStruct
    { name = "GhosttyCellsView",
      size = (#size GhosttyCellsView),
      align = (#alignment GhosttyCellsView),
      fields =
        [ CField "ptr" (#offset GhosttyCellsView, ptr) (#const GVTFFI_FIELD_SIZE(GhosttyCellsView, ptr)),
          CField "len" (#offset GhosttyCellsView, len) (#const GVTFFI_FIELD_SIZE(GhosttyCellsView, len))
        ]
    }

