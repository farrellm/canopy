-- | Every value of @GhosttyKey@, for the layout test (§3.4). It is also what
-- 'GhosttyKeyUnknown' excludes.
ghosttyKeyEnum :: CEnum
ghosttyKeyEnum =
  CEnum
    { name = "GhosttyKey",
      size = (#size GhosttyKey),
      values =
        [ ("GHOSTTY_KEY_UNIDENTIFIED", (#const GHOSTTY_KEY_UNIDENTIFIED)),
          ("GHOSTTY_KEY_BACKQUOTE", (#const GHOSTTY_KEY_BACKQUOTE)),
          ("GHOSTTY_KEY_BACKSLASH", (#const GHOSTTY_KEY_BACKSLASH)),
          ("GHOSTTY_KEY_BRACKET_LEFT", (#const GHOSTTY_KEY_BRACKET_LEFT)),
          ("GHOSTTY_KEY_BRACKET_RIGHT", (#const GHOSTTY_KEY_BRACKET_RIGHT)),
          ("GHOSTTY_KEY_COMMA", (#const GHOSTTY_KEY_COMMA)),
          ("GHOSTTY_KEY_DIGIT_0", (#const GHOSTTY_KEY_DIGIT_0)),
          ("GHOSTTY_KEY_DIGIT_1", (#const GHOSTTY_KEY_DIGIT_1)),
          ("GHOSTTY_KEY_DIGIT_2", (#const GHOSTTY_KEY_DIGIT_2)),
          ("GHOSTTY_KEY_DIGIT_3", (#const GHOSTTY_KEY_DIGIT_3)),
          ("GHOSTTY_KEY_DIGIT_4", (#const GHOSTTY_KEY_DIGIT_4)),
          ("GHOSTTY_KEY_DIGIT_5", (#const GHOSTTY_KEY_DIGIT_5)),
          ("GHOSTTY_KEY_DIGIT_6", (#const GHOSTTY_KEY_DIGIT_6)),
          ("GHOSTTY_KEY_DIGIT_7", (#const GHOSTTY_KEY_DIGIT_7)),
          ("GHOSTTY_KEY_DIGIT_8", (#const GHOSTTY_KEY_DIGIT_8)),
          ("GHOSTTY_KEY_DIGIT_9", (#const GHOSTTY_KEY_DIGIT_9)),
          ("GHOSTTY_KEY_EQUAL", (#const GHOSTTY_KEY_EQUAL)),
          ("GHOSTTY_KEY_INTL_BACKSLASH", (#const GHOSTTY_KEY_INTL_BACKSLASH)),
