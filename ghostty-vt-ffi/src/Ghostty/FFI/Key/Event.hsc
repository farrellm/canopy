-- | Any value this binding does not name: a newer library's.
pattern GhosttyKeyUnknown :: CInt -> GhosttyKey
pattern GhosttyKeyUnknown n <- GhosttyKey (unnamed ghosttyKeyEnum -> Just n)
  where
    GhosttyKeyUnknown n = GhosttyKey n

