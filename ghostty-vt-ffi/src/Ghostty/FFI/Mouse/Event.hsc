    GhosttyMousePosition
      <$> (#peek GhosttyMousePosition, x) p
      <*> (#peek GhosttyMousePosition, y) p
  poke p s = do
    (#poke GhosttyMousePosition, x) p s.x
    (#poke GhosttyMousePosition, y) p s.y

