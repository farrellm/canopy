pattern GhosttyRenderStateImageDataUnknown :: CInt -> GhosttyRenderStateImageData
pattern GhosttyRenderStateImageDataUnknown n <- GhosttyRenderStateImageData (unnamed ghosttyRenderStateImageDataEnum -> Just n)
  where
