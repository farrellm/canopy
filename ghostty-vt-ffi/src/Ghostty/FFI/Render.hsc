-- | @GhosttyRenderStateOption@: Settable options for ghostty\_render\_state\_set().
newtype GhosttyRenderStateOption = GhosttyRenderStateOption CInt
  deriving stock (Eq, Show)
  deriving newtype (Storable)

-- | @GHOSTTY_RENDER_STATE_OPTION_DIRTY@: Set dirty state (GhosttyRenderStateDirty).
pattern GhosttyRenderStateOptionDirty :: GhosttyRenderStateOption
pattern GhosttyRenderStateOptionDirty = GhosttyRenderStateOption (#const GHOSTTY_RENDER_STATE_OPTION_DIRTY)

-- | @GHOSTTY_RENDER_STATE_OPTION_OVERSCAN@: Request overscan rows above and below the viewport (GhosttyRenderStateOverscan). The request takes effect on the next update and stays in effect until it is changed. Both sides are zero by default, which captures only the viewport. The rows of the last update can still be read after changing the request. Expect a full redraw on the update after a change. See \"Overscan\" in the render state overview.
pattern GhosttyRenderStateOptionOverscan :: GhosttyRenderStateOption
pattern GhosttyRenderStateOptionOverscan = GhosttyRenderStateOption (#const GHOSTTY_RENDER_STATE_OPTION_OVERSCAN)

-- | Any value this binding does not name: a newer library's.
pattern GhosttyRenderStateOptionUnknown :: CInt -> GhosttyRenderStateOption
pattern GhosttyRenderStateOptionUnknown n <- GhosttyRenderStateOption (unnamed ghosttyRenderStateOptionEnum -> Just n)
  where
    GhosttyRenderStateOptionUnknown n = GhosttyRenderStateOption n

{-# COMPLETE
  GhosttyRenderStateOptionDirty,
  GhosttyRenderStateOptionOverscan,
  GhosttyRenderStateOptionUnknown
  #-}

-- | Every value of @GhosttyRenderStateOption@, for the layout test (§3.4). It is also what
-- 'GhosttyRenderStateOptionUnknown' excludes.
ghosttyRenderStateOptionEnum :: CEnum
ghosttyRenderStateOptionEnum =
  CEnum
    { name = "GhosttyRenderStateOption",
      size = (#size GhosttyRenderStateOption),
      values =
        [ ("GHOSTTY_RENDER_STATE_OPTION_DIRTY", (#const GHOSTTY_RENDER_STATE_OPTION_DIRTY)),
          ("GHOSTTY_RENDER_STATE_OPTION_OVERSCAN", (#const GHOSTTY_RENDER_STATE_OPTION_OVERSCAN))
        ]
    }

-- | @ghostty_render_state_set@: set an option from a pointer to its value.
-- @unsafe@: it does not call back into Haskell.
foreign import capi unsafe "ghostty/vt.h ghostty_render_state_set"
  ghosttyRenderStateSet :: GhosttyRenderState -> GhosttyRenderStateOption -> Ptr () -> IO GhosttyResult

-- | @GhosttyRenderStateDirty@: Dirty state of a render state after update.
newtype GhosttyRenderStateDirty = GhosttyRenderStateDirty CInt
  deriving stock (Eq, Show)
  deriving newtype (Storable)

-- | @GHOSTTY_RENDER_STATE_DIRTY_FALSE@: Not dirty at all; rendering can be skipped.
pattern GhosttyRenderStateDirtyFalse :: GhosttyRenderStateDirty
pattern GhosttyRenderStateDirtyFalse = GhosttyRenderStateDirty (#const GHOSTTY_RENDER_STATE_DIRTY_FALSE)

-- | @GHOSTTY_RENDER_STATE_DIRTY_PARTIAL@: Some rows changed; renderer can redraw incrementally.
pattern GhosttyRenderStateDirtyPartial :: GhosttyRenderStateDirty
pattern GhosttyRenderStateDirtyPartial = GhosttyRenderStateDirty (#const GHOSTTY_RENDER_STATE_DIRTY_PARTIAL)

-- | @GHOSTTY_RENDER_STATE_DIRTY_FULL@: Global state changed; renderer should redraw everything.
pattern GhosttyRenderStateDirtyFull :: GhosttyRenderStateDirty
pattern GhosttyRenderStateDirtyFull = GhosttyRenderStateDirty (#const GHOSTTY_RENDER_STATE_DIRTY_FULL)

-- | Any value this binding does not name: a newer library's.
pattern GhosttyRenderStateDirtyUnknown :: CInt -> GhosttyRenderStateDirty
pattern GhosttyRenderStateDirtyUnknown n <- GhosttyRenderStateDirty (unnamed ghosttyRenderStateDirtyEnum -> Just n)
  where
    GhosttyRenderStateDirtyUnknown n = GhosttyRenderStateDirty n

