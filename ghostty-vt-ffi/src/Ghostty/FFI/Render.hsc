-- | @GhosttyRenderStateOverscan@: A number of rows above and below the viewport.
data GhosttyRenderStateOverscan = GhosttyRenderStateOverscan
  { -- | @above@: Rows above the top of the viewport.
    above :: Word16,
    -- | @below@: Rows below the bottom of the viewport.
    below :: Word16
  }
  deriving stock (Eq, Show)

instance Storable GhosttyRenderStateOverscan where
  sizeOf _ = (#size GhosttyRenderStateOverscan)
  alignment _ = (#alignment GhosttyRenderStateOverscan)
  peek p =
    GhosttyRenderStateOverscan
      <$> (#peek GhosttyRenderStateOverscan, above) p
      <*> (#peek GhosttyRenderStateOverscan, below) p
  poke p s = do
    (#poke GhosttyRenderStateOverscan, above) p s.above
    (#poke GhosttyRenderStateOverscan, below) p s.below

-- | The layout of @GhosttyRenderStateOverscan@ as compiled, for the layout test (§3.4).
ghosttyRenderStateOverscanLayout :: CStruct
ghosttyRenderStateOverscanLayout =
  CStruct
    { name = "GhosttyRenderStateOverscan",
      size = (#size GhosttyRenderStateOverscan),
      align = (#alignment GhosttyRenderStateOverscan),
      fields =
        [ CField "above" (#offset GhosttyRenderStateOverscan, above) (#const GVTFFI_FIELD_SIZE(GhosttyRenderStateOverscan, above)),
          CField "below" (#offset GhosttyRenderStateOverscan, below) (#const GVTFFI_FIELD_SIZE(GhosttyRenderStateOverscan, below))
        ]
    }

-- | @GhosttyRenderStateCursor@: Render-state cursor information.
data GhosttyRenderStateCursor = GhosttyRenderStateCursor
  { -- | @size@: Size of this struct in bytes. Must be set to sizeof(GhosttyRenderStateCursor).
    size :: CSize,
    -- | @viewport_has_value@: Whether the cursor is visible within the viewport.
    viewportHasValue :: CBool,
    -- | @viewport_x@: Cursor viewport x position in cells.
    viewportX :: Word16,
    -- | @viewport_y@: Cursor viewport y position in cells.
    viewportY :: Word16,
    -- | @wide_tail@: Whether the cursor is on the tail of a wide character.
    wideTail :: CBool,
    -- | @visible@: Whether the cursor is visible based on terminal modes.
    visible :: CBool,
    -- | @blinking@: Whether the cursor should blink based on terminal modes.
    blinking :: CBool,
    -- | @password_input@: Whether the cursor is at a password input field.
    passwordInput :: CBool,
    -- | @visual_style@: The visual style of the cursor.
    visualStyle :: GhosttyRenderStateCursorVisualStyle
  }
  deriving stock (Eq, Show)

instance Storable GhosttyRenderStateCursor where
  sizeOf _ = (#size GhosttyRenderStateCursor)
  alignment _ = (#alignment GhosttyRenderStateCursor)
  peek p =
    GhosttyRenderStateCursor
      <$> (#peek GhosttyRenderStateCursor, size) p
      <*> (#peek GhosttyRenderStateCursor, viewport_has_value) p
      <*> (#peek GhosttyRenderStateCursor, viewport_x) p
      <*> (#peek GhosttyRenderStateCursor, viewport_y) p
      <*> (#peek GhosttyRenderStateCursor, wide_tail) p
      <*> (#peek GhosttyRenderStateCursor, visible) p
      <*> (#peek GhosttyRenderStateCursor, blinking) p
      <*> (#peek GhosttyRenderStateCursor, password_input) p
      <*> (#peek GhosttyRenderStateCursor, visual_style) p
  poke p s = do
    (#poke GhosttyRenderStateCursor, size) p s.size
    (#poke GhosttyRenderStateCursor, viewport_has_value) p s.viewportHasValue
    (#poke GhosttyRenderStateCursor, viewport_x) p s.viewportX
    (#poke GhosttyRenderStateCursor, viewport_y) p s.viewportY
    (#poke GhosttyRenderStateCursor, wide_tail) p s.wideTail
    (#poke GhosttyRenderStateCursor, visible) p s.visible
    (#poke GhosttyRenderStateCursor, blinking) p s.blinking
    (#poke GhosttyRenderStateCursor, password_input) p s.passwordInput
    (#poke GhosttyRenderStateCursor, visual_style) p s.visualStyle

-- | The layout of @GhosttyRenderStateCursor@ as compiled, for the layout test (§3.4).
ghosttyRenderStateCursorLayout :: CStruct
ghosttyRenderStateCursorLayout =
  CStruct
    { name = "GhosttyRenderStateCursor",
      size = (#size GhosttyRenderStateCursor),
      align = (#alignment GhosttyRenderStateCursor),
      fields =
        [ CField "size" (#offset GhosttyRenderStateCursor, size) (#const GVTFFI_FIELD_SIZE(GhosttyRenderStateCursor, size)),
          CField "viewport_has_value" (#offset GhosttyRenderStateCursor, viewport_has_value) (#const GVTFFI_FIELD_SIZE(GhosttyRenderStateCursor, viewport_has_value)),
          CField "viewport_x" (#offset GhosttyRenderStateCursor, viewport_x) (#const GVTFFI_FIELD_SIZE(GhosttyRenderStateCursor, viewport_x)),
          CField "viewport_y" (#offset GhosttyRenderStateCursor, viewport_y) (#const GVTFFI_FIELD_SIZE(GhosttyRenderStateCursor, viewport_y)),
          CField "wide_tail" (#offset GhosttyRenderStateCursor, wide_tail) (#const GVTFFI_FIELD_SIZE(GhosttyRenderStateCursor, wide_tail)),
          CField "visible" (#offset GhosttyRenderStateCursor, visible) (#const GVTFFI_FIELD_SIZE(GhosttyRenderStateCursor, visible)),
          CField "blinking" (#offset GhosttyRenderStateCursor, blinking) (#const GVTFFI_FIELD_SIZE(GhosttyRenderStateCursor, blinking)),
          CField "password_input" (#offset GhosttyRenderStateCursor, password_input) (#const GVTFFI_FIELD_SIZE(GhosttyRenderStateCursor, password_input)),
          CField "visual_style" (#offset GhosttyRenderStateCursor, visual_style) (#const GVTFFI_FIELD_SIZE(GhosttyRenderStateCursor, visual_style))
        ]
    }

-- | @GhosttyRenderStateColors@: every colour of a render state, as one sized
-- struct.
data GhosttyRenderStateColors = GhosttyRenderStateColors
  { -- | @size@: the struct's size in bytes; set it before a read.
    size :: CSize,
    -- | @background@: the default or current background colour.
    background :: GhosttyColorRgb,
    -- | @foreground@: the default or current foreground colour.
    foreground :: GhosttyColorRgb,
    -- | @cursor@: the cursor colour, when @cursor_has_value@ says there is one.
    cursor :: GhosttyColorRgb,
    -- | @cursor_has_value@: whether @cursor@ holds an explicit colour.
    cursorHasValue :: CBool,
    -- | @palette@: the whole fixed-size array, the active 256-colour palette.
    -- A 'peek' reads every element; a 'poke' writes the list's first elements
    -- and zeroes the rest.
    palette :: [GhosttyColorRgb]
  }
  deriving stock (Eq, Show)

-- | How many elements @palette@ has in C.
paletteLen :: Int
paletteLen = (#const GVTFFI_ARRAY_LEN(GhosttyRenderStateColors, palette))

instance Storable GhosttyRenderStateColors where
  sizeOf _ = (#size GhosttyRenderStateColors)
  alignment _ = (#alignment GhosttyRenderStateColors)
  peek p =
    GhosttyRenderStateColors
      <$> (#peek GhosttyRenderStateColors, size) p
      <*> (#peek GhosttyRenderStateColors, background) p
      <*> (#peek GhosttyRenderStateColors, foreground) p
      <*> (#peek GhosttyRenderStateColors, cursor) p
      <*> (#peek GhosttyRenderStateColors, cursor_has_value) p
      <*> peekArray paletteLen ((#ptr GhosttyRenderStateColors, palette) p)
  poke p s = do
    (#poke GhosttyRenderStateColors, size) p s.size
    (#poke GhosttyRenderStateColors, background) p s.background
    (#poke GhosttyRenderStateColors, foreground) p s.foreground
    (#poke GhosttyRenderStateColors, cursor) p s.cursor
    (#poke GhosttyRenderStateColors, cursor_has_value) p s.cursorHasValue
    pokeArray
      ((#ptr GhosttyRenderStateColors, palette) p)
      (take paletteLen (s.palette <> repeat (GhosttyColorRgb 0 0 0)))

-- | The layout of @GhosttyRenderStateColors@ as compiled, for the layout test (§3.4).
ghosttyRenderStateColorsLayout :: CStruct
ghosttyRenderStateColorsLayout =
  CStruct
    { name = "GhosttyRenderStateColors",
      size = (#size GhosttyRenderStateColors),
      align = (#alignment GhosttyRenderStateColors),
      fields =
        [ CField "size" (#offset GhosttyRenderStateColors, size) (#const GVTFFI_FIELD_SIZE(GhosttyRenderStateColors, size)),
          CField "background" (#offset GhosttyRenderStateColors, background) (#const GVTFFI_FIELD_SIZE(GhosttyRenderStateColors, background)),
          CField "foreground" (#offset GhosttyRenderStateColors, foreground) (#const GVTFFI_FIELD_SIZE(GhosttyRenderStateColors, foreground)),
          CField "cursor" (#offset GhosttyRenderStateColors, cursor) (#const GVTFFI_FIELD_SIZE(GhosttyRenderStateColors, cursor)),
          CField "cursor_has_value" (#offset GhosttyRenderStateColors, cursor_has_value) (#const GVTFFI_FIELD_SIZE(GhosttyRenderStateColors, cursor_has_value)),
          CField "palette" (#offset GhosttyRenderStateColors, palette) (#const GVTFFI_FIELD_SIZE(GhosttyRenderStateColors, palette))
        ]
    }

