  ghosttyRenderStateImageIteratorNext :: GhosttyRenderStateImageIterator -> IO CBool

-- | @GhosttyRenderStateImageData@: Data you can read about the current placement of an image iterator with ghostty\_render\_state\_image\_get().
newtype GhosttyRenderStateImageData = GhosttyRenderStateImageData CInt
  deriving stock (Eq, Show)
  deriving newtype (Storable)

-- | @GHOSTTY_RENDER_STATE_IMAGE_DATA_INVALID@: Invalid value. Querying it returns GHOSTTY\_INVALID\_VALUE.
pattern GhosttyRenderStateImageDataInvalid :: GhosttyRenderStateImageData
pattern GhosttyRenderStateImageDataInvalid = GhosttyRenderStateImageData (#const GHOSTTY_RENDER_STATE_IMAGE_DATA_INVALID)

-- | @GHOSTTY_RENDER_STATE_IMAGE_DATA_PROTOCOL@: The protocol the image came from (GhosttyImageProtocol).
pattern GhosttyRenderStateImageDataProtocol :: GhosttyRenderStateImageData
pattern GhosttyRenderStateImageDataProtocol = GhosttyRenderStateImageData (#const GHOSTTY_RENDER_STATE_IMAGE_DATA_PROTOCOL)

-- | @GHOSTTY_RENDER_STATE_IMAGE_DATA_IMAGE_ID@: The ID of the image to draw (uint32\_t). IDs are only unique within one protocol, so look the image up in the storage of its protocol. For Kitty graphics, use ghostty\_kitty\_graphics\_image().
pattern GhosttyRenderStateImageDataImageId :: GhosttyRenderStateImageData
pattern GhosttyRenderStateImageDataImageId = GhosttyRenderStateImageData (#const GHOSTTY_RENDER_STATE_IMAGE_DATA_IMAGE_ID)

-- | @GHOSTTY_RENDER_STATE_IMAGE_DATA_IMAGE_GENERATION@: The generation of the image\'s contents (uint64\_t). It changes whenever the image\'s pixels change, including when an animation moves to a new frame. Use it as part of your texture cache key, with the protocol and image ID: if it matches the texture you have, you don\'t need to read the pixels again. For Kitty graphics, this is the same value as GHOSTTY\_KITTY\_IMAGE\_DATA\_GENERATION.
pattern GhosttyRenderStateImageDataImageGeneration :: GhosttyRenderStateImageData
pattern GhosttyRenderStateImageDataImageGeneration = GhosttyRenderStateImageData (#const GHOSTTY_RENDER_STATE_IMAGE_DATA_IMAGE_GENERATION)

-- | @GHOSTTY_RENDER_STATE_IMAGE_DATA_LAYER@: The layer to draw the image in (GhosttyRenderStateImageLayer).
pattern GhosttyRenderStateImageDataLayer :: GhosttyRenderStateImageData
pattern GhosttyRenderStateImageDataLayer = GhosttyRenderStateImageData (#const GHOSTTY_RENDER_STATE_IMAGE_DATA_LAYER)

-- | @GHOSTTY_RENDER_STATE_IMAGE_DATA_Z@: The z-index (int32\_t), which orders images within a layer. Images with a lower z-index are drawn first. The value comes from the image\'s protocol. For Kitty graphics, it is the z-index the program asked for, and virtual placements are always -1.
pattern GhosttyRenderStateImageDataZ :: GhosttyRenderStateImageData
pattern GhosttyRenderStateImageDataZ = GhosttyRenderStateImageData (#const GHOSTTY_RENDER_STATE_IMAGE_DATA_Z)

-- | @GHOSTTY_RENDER_STATE_IMAGE_DATA_VIEWPORT_COL@: The column of the top-left cell (int32\_t), where 0 is the leftmost column of the viewport. Fixed and relative placements are reported at their full size, so they can start to the left of the viewport, which gives a negative value. Virtual placements never do. See \"Images Partly Outside the Captured Rows\" in the @render@ documentation.
pattern GhosttyRenderStateImageDataViewportCol :: GhosttyRenderStateImageData
pattern GhosttyRenderStateImageDataViewportCol = GhosttyRenderStateImageData (#const GHOSTTY_RENDER_STATE_IMAGE_DATA_VIEWPORT_COL)

-- | @GHOSTTY_RENDER_STATE_IMAGE_DATA_VIEWPORT_ROW@: The row of the top-left cell (int32\_t), where 0 is the top row of the viewport. A placement in an overscan row above the viewport has a negative row, the same as GHOSTTY\_RENDER\_STATE\_ROW\_DATA\_VIEWPORT\_Y. Fixed and relative placements are reported at their full size, so they can also start above the first overscan row. Virtual placements are always inside the captured rows. See \"Images Partly Outside the Captured Rows\" in the @render@ documentation.
pattern GhosttyRenderStateImageDataViewportRow :: GhosttyRenderStateImageData
pattern GhosttyRenderStateImageDataViewportRow = GhosttyRenderStateImageData (#const GHOSTTY_RENDER_STATE_IMAGE_DATA_VIEWPORT_ROW)

-- | @GHOSTTY_RENDER_STATE_IMAGE_DATA_GRID_COLS@: The number of columns of cells the placement covers (uint32\_t).
pattern GhosttyRenderStateImageDataGridCols :: GhosttyRenderStateImageData
pattern GhosttyRenderStateImageDataGridCols = GhosttyRenderStateImageData (#const GHOSTTY_RENDER_STATE_IMAGE_DATA_GRID_COLS)

-- | @GHOSTTY_RENDER_STATE_IMAGE_DATA_GRID_ROWS@: The number of rows of cells the placement covers (uint32\_t).
pattern GhosttyRenderStateImageDataGridRows :: GhosttyRenderStateImageData
pattern GhosttyRenderStateImageDataGridRows = GhosttyRenderStateImageData (#const GHOSTTY_RENDER_STATE_IMAGE_DATA_GRID_ROWS)

-- | @GHOSTTY_RENDER_STATE_IMAGE_DATA_CELL_OFFSET_X@: How far the image starts from the left edge of the top-left cell, in pixels (uint32\_t). For a virtual placement, an image that is narrower than its cells is centered, so this can be larger than a cell is wide. For fixed and relative placements, this is the offset the program asked for, limited to less than one cell.
pattern GhosttyRenderStateImageDataCellOffsetX :: GhosttyRenderStateImageData
pattern GhosttyRenderStateImageDataCellOffsetX = GhosttyRenderStateImageData (#const GHOSTTY_RENDER_STATE_IMAGE_DATA_CELL_OFFSET_X)

-- | @GHOSTTY_RENDER_STATE_IMAGE_DATA_CELL_OFFSET_Y@: How far the image starts from the top edge of the top-left cell, in pixels (uint32\_t). For a virtual placement, an image that is shorter than its cells is centered, so this can be larger than a cell is tall. For fixed and relative placements, this is the offset the program asked for, limited to less than one cell.
pattern GhosttyRenderStateImageDataCellOffsetY :: GhosttyRenderStateImageData
pattern GhosttyRenderStateImageDataCellOffsetY = GhosttyRenderStateImageData (#const GHOSTTY_RENDER_STATE_IMAGE_DATA_CELL_OFFSET_Y)

-- | @GHOSTTY_RENDER_STATE_IMAGE_DATA_PIXEL_WIDTH@: The width to draw the image at, in pixels (uint32\_t).
pattern GhosttyRenderStateImageDataPixelWidth :: GhosttyRenderStateImageData
pattern GhosttyRenderStateImageDataPixelWidth = GhosttyRenderStateImageData (#const GHOSTTY_RENDER_STATE_IMAGE_DATA_PIXEL_WIDTH)

-- | @GHOSTTY_RENDER_STATE_IMAGE_DATA_PIXEL_HEIGHT@: The height to draw the image at, in pixels (uint32\_t).
pattern GhosttyRenderStateImageDataPixelHeight :: GhosttyRenderStateImageData
pattern GhosttyRenderStateImageDataPixelHeight = GhosttyRenderStateImageData (#const GHOSTTY_RENDER_STATE_IMAGE_DATA_PIXEL_HEIGHT)

-- | @GHOSTTY_RENDER_STATE_IMAGE_DATA_SOURCE_X@: The left edge of the part of the image to draw, in image pixels (uint32\_t).
pattern GhosttyRenderStateImageDataSourceX :: GhosttyRenderStateImageData
pattern GhosttyRenderStateImageDataSourceX = GhosttyRenderStateImageData (#const GHOSTTY_RENDER_STATE_IMAGE_DATA_SOURCE_X)

-- | @GHOSTTY_RENDER_STATE_IMAGE_DATA_SOURCE_Y@: The top edge of the part of the image to draw, in image pixels (uint32\_t).
pattern GhosttyRenderStateImageDataSourceY :: GhosttyRenderStateImageData
pattern GhosttyRenderStateImageDataSourceY = GhosttyRenderStateImageData (#const GHOSTTY_RENDER_STATE_IMAGE_DATA_SOURCE_Y)

-- | @GHOSTTY_RENDER_STATE_IMAGE_DATA_SOURCE_WIDTH@: The width of the part of the image to draw, in image pixels (uint32\_t). Scale it to PIXEL\_WIDTH when drawing.
pattern GhosttyRenderStateImageDataSourceWidth :: GhosttyRenderStateImageData
pattern GhosttyRenderStateImageDataSourceWidth = GhosttyRenderStateImageData (#const GHOSTTY_RENDER_STATE_IMAGE_DATA_SOURCE_WIDTH)

-- | @GHOSTTY_RENDER_STATE_IMAGE_DATA_SOURCE_HEIGHT@: The height of the part of the image to draw, in image pixels (uint32\_t). Scale it to PIXEL\_HEIGHT when drawing.
pattern GhosttyRenderStateImageDataSourceHeight :: GhosttyRenderStateImageData
pattern GhosttyRenderStateImageDataSourceHeight = GhosttyRenderStateImageData (#const GHOSTTY_RENDER_STATE_IMAGE_DATA_SOURCE_HEIGHT)

-- | @GHOSTTY_RENDER_STATE_IMAGE_DATA_KITTY_PLACEMENT_ID@: Kitty graphics only: the placement ID (uint32\_t), or 0 if there isn\'t one.
pattern GhosttyRenderStateImageDataKittyPlacementId :: GhosttyRenderStateImageData
pattern GhosttyRenderStateImageDataKittyPlacementId = GhosttyRenderStateImageData (#const GHOSTTY_RENDER_STATE_IMAGE_DATA_KITTY_PLACEMENT_ID)

-- | @GHOSTTY_RENDER_STATE_IMAGE_DATA_KITTY_KIND@: Kitty graphics only: the kind of placement (GhosttyRenderStateKittyPlacementKind).
pattern GhosttyRenderStateImageDataKittyKind :: GhosttyRenderStateImageData
pattern GhosttyRenderStateImageDataKittyKind = GhosttyRenderStateImageData (#const GHOSTTY_RENDER_STATE_IMAGE_DATA_KITTY_KIND)

