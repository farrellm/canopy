          ("GHOSTTY_RENDER_STATE_IMAGE_DATA_SOURCE_WIDTH", (#const GHOSTTY_RENDER_STATE_IMAGE_DATA_SOURCE_WIDTH)),
          ("GHOSTTY_RENDER_STATE_IMAGE_DATA_SOURCE_HEIGHT", (#const GHOSTTY_RENDER_STATE_IMAGE_DATA_SOURCE_HEIGHT)),
          ("GHOSTTY_RENDER_STATE_IMAGE_DATA_KITTY_PLACEMENT_ID", (#const GHOSTTY_RENDER_STATE_IMAGE_DATA_KITTY_PLACEMENT_ID)),
          ("GHOSTTY_RENDER_STATE_IMAGE_DATA_KITTY_KIND", (#const GHOSTTY_RENDER_STATE_IMAGE_DATA_KITTY_KIND))
        ]
    }

-- | @ghostty_render_state_image_get@: read one key of the current placement
-- into a pointer of its type; @GHOSTTY_NO_VALUE@ for a key of another
-- protocol. @unsafe@: it does not call back into Haskell.
foreign import capi unsafe "ghostty/vt.h ghostty_render_state_image_get"
  ghosttyRenderStateImageGet :: GhosttyRenderStateImageIterator -> GhosttyRenderStateImageData -> Ptr () -> IO GhosttyResult

-- | @ghostty_render_state_image_get_multi@: read several keys of the current
-- placement in one call, as 'ghosttyRenderStateGetMulti'. @unsafe@: it does
-- not call back into Haskell.
foreign import capi unsafe "ghostty/vt.h ghostty_render_state_image_get_multi"
  ghosttyRenderStateImageGetMulti :: GhosttyRenderStateImageIterator -> CSize -> Ptr GhosttyRenderStateImageData -> Ptr (Ptr ()) -> Ptr CSize -> IO GhosttyResult

-- | @GhosttyImageProtocol@: The image protocols that a terminal supports.
newtype GhosttyImageProtocol = GhosttyImageProtocol CInt
  deriving stock (Eq, Show)
  deriving newtype (Storable)

-- | @GHOSTTY_IMAGE_PROTOCOL_KITTY@: The Kitty graphics protocol. Read the image with ghostty\_kitty\_graphics\_image().
pattern GhosttyImageProtocolKitty :: GhosttyImageProtocol
pattern GhosttyImageProtocolKitty = GhosttyImageProtocol (#const GHOSTTY_IMAGE_PROTOCOL_KITTY)

-- | Any value this binding does not name: a newer library's.
pattern GhosttyImageProtocolUnknown :: CInt -> GhosttyImageProtocol
pattern GhosttyImageProtocolUnknown n <- GhosttyImageProtocol (unnamed ghosttyImageProtocolEnum -> Just n)
  where
    GhosttyImageProtocolUnknown n = GhosttyImageProtocol n

{-# COMPLETE
  GhosttyImageProtocolKitty,
  GhosttyImageProtocolUnknown
  #-}

-- | Every value of @GhosttyImageProtocol@, for the layout test (§3.4). It is also what
-- 'GhosttyImageProtocolUnknown' excludes.
ghosttyImageProtocolEnum :: CEnum
ghosttyImageProtocolEnum =
  CEnum
    { name = "GhosttyImageProtocol",
      size = (#size GhosttyImageProtocol),
      values =
        [ ("GHOSTTY_IMAGE_PROTOCOL_KITTY", (#const GHOSTTY_IMAGE_PROTOCOL_KITTY))
        ]
    }

-- | @GhosttyRenderStateImageLayer@: Where an image is drawn relative to the terminal\'s text.
newtype GhosttyRenderStateImageLayer = GhosttyRenderStateImageLayer CInt
  deriving stock (Eq, Show)
  deriving newtype (Storable)

-- | @GHOSTTY_RENDER_STATE_IMAGE_LAYER_BELOW_BACKGROUND@: Below the cell background colors.
pattern GhosttyRenderStateImageLayerBelowBackground :: GhosttyRenderStateImageLayer
pattern GhosttyRenderStateImageLayerBelowBackground = GhosttyRenderStateImageLayer (#const GHOSTTY_RENDER_STATE_IMAGE_LAYER_BELOW_BACKGROUND)

-- | @GHOSTTY_RENDER_STATE_IMAGE_LAYER_BELOW_TEXT@: Above the cell background colors and below the text.
pattern GhosttyRenderStateImageLayerBelowText :: GhosttyRenderStateImageLayer
pattern GhosttyRenderStateImageLayerBelowText = GhosttyRenderStateImageLayer (#const GHOSTTY_RENDER_STATE_IMAGE_LAYER_BELOW_TEXT)

-- | @GHOSTTY_RENDER_STATE_IMAGE_LAYER_ABOVE_TEXT@: Above the text.
pattern GhosttyRenderStateImageLayerAboveText :: GhosttyRenderStateImageLayer
pattern GhosttyRenderStateImageLayerAboveText = GhosttyRenderStateImageLayer (#const GHOSTTY_RENDER_STATE_IMAGE_LAYER_ABOVE_TEXT)

-- | Any value this binding does not name: a newer library's.
pattern GhosttyRenderStateImageLayerUnknown :: CInt -> GhosttyRenderStateImageLayer
pattern GhosttyRenderStateImageLayerUnknown n <- GhosttyRenderStateImageLayer (unnamed ghosttyRenderStateImageLayerEnum -> Just n)
  where
    GhosttyRenderStateImageLayerUnknown n = GhosttyRenderStateImageLayer n

{-# COMPLETE
  GhosttyRenderStateImageLayerBelowBackground,
  GhosttyRenderStateImageLayerBelowText,
  GhosttyRenderStateImageLayerAboveText,
  GhosttyRenderStateImageLayerUnknown
  #-}

-- | Every value of @GhosttyRenderStateImageLayer@, for the layout test (§3.4). It is also what
-- 'GhosttyRenderStateImageLayerUnknown' excludes.
ghosttyRenderStateImageLayerEnum :: CEnum
ghosttyRenderStateImageLayerEnum =
  CEnum
    { name = "GhosttyRenderStateImageLayer",
      size = (#size GhosttyRenderStateImageLayer),
      values =
        [ ("GHOSTTY_RENDER_STATE_IMAGE_LAYER_BELOW_BACKGROUND", (#const GHOSTTY_RENDER_STATE_IMAGE_LAYER_BELOW_BACKGROUND)),
          ("GHOSTTY_RENDER_STATE_IMAGE_LAYER_BELOW_TEXT", (#const GHOSTTY_RENDER_STATE_IMAGE_LAYER_BELOW_TEXT)),
          ("GHOSTTY_RENDER_STATE_IMAGE_LAYER_ABOVE_TEXT", (#const GHOSTTY_RENDER_STATE_IMAGE_LAYER_ABOVE_TEXT))
        ]
    }

-- | @GhosttyRenderStateKittyPlacementKind@: The kinds of Kitty graphics placements in a render state\'s image list.
newtype GhosttyRenderStateKittyPlacementKind = GhosttyRenderStateKittyPlacementKind CInt
  deriving stock (Eq, Show)
  deriving newtype (Storable)

-- | @GHOSTTY_RENDER_STATE_KITTY_PLACEMENT_KIND_VIRTUAL@: Part of a virtual placement: one run of neighboring placeholder cells in a single row. It is always one row tall.
pattern GhosttyRenderStateKittyPlacementKindVirtual :: GhosttyRenderStateKittyPlacementKind
pattern GhosttyRenderStateKittyPlacementKindVirtual = GhosttyRenderStateKittyPlacementKind (#const GHOSTTY_RENDER_STATE_KITTY_PLACEMENT_KIND_VIRTUAL)

-- | @GHOSTTY_RENDER_STATE_KITTY_PLACEMENT_KIND_RELATIVE@: A placement that a program positioned relative to another placement, its parent. Kitty graphics lets a program attach one image to another so that they move together. The parent is either a virtual or a fixed placement, possibly through a chain of other relative placements.
pattern GhosttyRenderStateKittyPlacementKindRelative :: GhosttyRenderStateKittyPlacementKind
pattern GhosttyRenderStateKittyPlacementKindRelative = GhosttyRenderStateKittyPlacementKind (#const GHOSTTY_RENDER_STATE_KITTY_PLACEMENT_KIND_RELATIVE)

-- | @GHOSTTY_RENDER_STATE_KITTY_PLACEMENT_KIND_FIXED@: A placement at a cell on the screen. It scrolls with the text, like a line of output would. Its z-index is the one the program chose, so it can be in any layer.
pattern GhosttyRenderStateKittyPlacementKindFixed :: GhosttyRenderStateKittyPlacementKind
pattern GhosttyRenderStateKittyPlacementKindFixed = GhosttyRenderStateKittyPlacementKind (#const GHOSTTY_RENDER_STATE_KITTY_PLACEMENT_KIND_FIXED)

-- | Any value this binding does not name: a newer library's.
pattern GhosttyRenderStateKittyPlacementKindUnknown :: CInt -> GhosttyRenderStateKittyPlacementKind
pattern GhosttyRenderStateKittyPlacementKindUnknown n <- GhosttyRenderStateKittyPlacementKind (unnamed ghosttyRenderStateKittyPlacementKindEnum -> Just n)
  where
    GhosttyRenderStateKittyPlacementKindUnknown n = GhosttyRenderStateKittyPlacementKind n

{-# COMPLETE
  GhosttyRenderStateKittyPlacementKindVirtual,
  GhosttyRenderStateKittyPlacementKindRelative,
  GhosttyRenderStateKittyPlacementKindFixed,
  GhosttyRenderStateKittyPlacementKindUnknown
  #-}

-- | Every value of @GhosttyRenderStateKittyPlacementKind@, for the layout test (§3.4). It is also what
-- 'GhosttyRenderStateKittyPlacementKindUnknown' excludes.
ghosttyRenderStateKittyPlacementKindEnum :: CEnum
ghosttyRenderStateKittyPlacementKindEnum =
  CEnum
    { name = "GhosttyRenderStateKittyPlacementKind",
      size = (#size GhosttyRenderStateKittyPlacementKind),
      values =
        [ ("GHOSTTY_RENDER_STATE_KITTY_PLACEMENT_KIND_VIRTUAL", (#const GHOSTTY_RENDER_STATE_KITTY_PLACEMENT_KIND_VIRTUAL)),
          ("GHOSTTY_RENDER_STATE_KITTY_PLACEMENT_KIND_RELATIVE", (#const GHOSTTY_RENDER_STATE_KITTY_PLACEMENT_KIND_RELATIVE)),
          ("GHOSTTY_RENDER_STATE_KITTY_PLACEMENT_KIND_FIXED", (#const GHOSTTY_RENDER_STATE_KITTY_PLACEMENT_KIND_FIXED))
        ]
    }

