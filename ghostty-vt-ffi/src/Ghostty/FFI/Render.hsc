  ghosttyRenderStateRowSet :: GhosttyRenderStateRowIterator -> GhosttyRenderStateRowOption -> Ptr () -> IO GhosttyResult

-- | @GhosttyRenderStateRowId@: a row's identity across updates. Opaque: two
-- ids are the same row when both words are equal, and nothing else about
-- them means anything. All zeros is never a row.
newtype GhosttyRenderStateRowId = GhosttyRenderStateRowId
  { -- | @bits@: the whole fixed-size array of words. A 'peek' reads every
    -- element; a 'poke' writes the list's first elements and zeroes the rest.
    bits :: [Word64]
  }
  deriving stock (Eq, Show)

-- | How many elements @bits@ has in C.
bitsLen :: Int
bitsLen = (#const GVTFFI_ARRAY_LEN(GhosttyRenderStateRowId, bits))

instance Storable GhosttyRenderStateRowId where
  sizeOf _ = (#size GhosttyRenderStateRowId)
  alignment _ = (#alignment GhosttyRenderStateRowId)
  peek p = GhosttyRenderStateRowId <$> peekArray bitsLen ((#ptr GhosttyRenderStateRowId, bits) p)
  poke p s = pokeArray ((#ptr GhosttyRenderStateRowId, bits) p) (take bitsLen (s.bits <> repeat 0))

-- | The layout of @GhosttyRenderStateRowId@ as compiled, for the layout test (§3.4).
ghosttyRenderStateRowIdLayout :: CStruct
ghosttyRenderStateRowIdLayout =
  CStruct
    { name = "GhosttyRenderStateRowId",
      size = (#size GhosttyRenderStateRowId),
      align = (#alignment GhosttyRenderStateRowId),
      fields =
        [ CField "bits" (#offset GhosttyRenderStateRowId, bits) (#const GVTFFI_FIELD_SIZE(GhosttyRenderStateRowId, bits))
        ]
    }

-- | @GhosttyRenderStateRowSelection@: Row-local selection range.
data GhosttyRenderStateRowSelection = GhosttyRenderStateRowSelection
  { -- | @size@: Size of this struct in bytes. Must be set to sizeof(GhosttyRenderStateRowSelection).
    size :: CSize,
    -- | @start_x@: Start column of the row-local selection range, inclusive.
    startX :: Word16,
    -- | @end_x@: End column of the row-local selection range, inclusive.
    endX :: Word16
  }
  deriving stock (Eq, Show)

instance Storable GhosttyRenderStateRowSelection where
  sizeOf _ = (#size GhosttyRenderStateRowSelection)
  alignment _ = (#alignment GhosttyRenderStateRowSelection)
  peek p =
    GhosttyRenderStateRowSelection
      <$> (#peek GhosttyRenderStateRowSelection, size) p
      <*> (#peek GhosttyRenderStateRowSelection, start_x) p
      <*> (#peek GhosttyRenderStateRowSelection, end_x) p
  poke p s = do
    (#poke GhosttyRenderStateRowSelection, size) p s.size
    (#poke GhosttyRenderStateRowSelection, start_x) p s.startX
    (#poke GhosttyRenderStateRowSelection, end_x) p s.endX

-- | The layout of @GhosttyRenderStateRowSelection@ as compiled, for the layout test (§3.4).
ghosttyRenderStateRowSelectionLayout :: CStruct
ghosttyRenderStateRowSelectionLayout =
  CStruct
    { name = "GhosttyRenderStateRowSelection",
      size = (#size GhosttyRenderStateRowSelection),
      align = (#alignment GhosttyRenderStateRowSelection),
      fields =
        [ CField "size" (#offset GhosttyRenderStateRowSelection, size) (#const GVTFFI_FIELD_SIZE(GhosttyRenderStateRowSelection, size)),
          CField "start_x" (#offset GhosttyRenderStateRowSelection, start_x) (#const GVTFFI_FIELD_SIZE(GhosttyRenderStateRowSelection, start_x)),
          CField "end_x" (#offset GhosttyRenderStateRowSelection, end_x) (#const GVTFFI_FIELD_SIZE(GhosttyRenderStateRowSelection, end_x))
        ]
    }

