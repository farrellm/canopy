  ghosttyRenderStateRowIteratorNextDirty :: GhosttyRenderStateRowIterator -> Ptr Word16 -> IO CBool

-- | @GhosttyRenderStateRowData@: Queryable data kinds for ghostty\_render\_state\_row\_get().
newtype GhosttyRenderStateRowData = GhosttyRenderStateRowData CInt
  deriving stock (Eq, Show)
  deriving newtype (Storable)

-- | @GHOSTTY_RENDER_STATE_ROW_DATA_INVALID@: Invalid \/ sentinel value.
pattern GhosttyRenderStateRowDataInvalid :: GhosttyRenderStateRowData
pattern GhosttyRenderStateRowDataInvalid = GhosttyRenderStateRowData (#const GHOSTTY_RENDER_STATE_ROW_DATA_INVALID)

-- | @GHOSTTY_RENDER_STATE_ROW_DATA_DIRTY@: Whether the current row is dirty (bool).
pattern GhosttyRenderStateRowDataDirty :: GhosttyRenderStateRowData
pattern GhosttyRenderStateRowDataDirty = GhosttyRenderStateRowData (#const GHOSTTY_RENDER_STATE_ROW_DATA_DIRTY)

-- | @GHOSTTY_RENDER_STATE_ROW_DATA_RAW@: The raw row value (GhosttyRow).
pattern GhosttyRenderStateRowDataRaw :: GhosttyRenderStateRowData
pattern GhosttyRenderStateRowDataRaw = GhosttyRenderStateRowData (#const GHOSTTY_RENDER_STATE_ROW_DATA_RAW)

-- | @GHOSTTY_RENDER_STATE_ROW_DATA_CELLS@: Populate a pre-allocated GhosttyRenderStateRowCells with cell data for the current row (GhosttyRenderStateRowCells). Cell data is only valid as long as the underlying render state is not updated. It is unsafe to use cell data after updating the render state.
pattern GhosttyRenderStateRowDataCells :: GhosttyRenderStateRowData
pattern GhosttyRenderStateRowDataCells = GhosttyRenderStateRowData (#const GHOSTTY_RENDER_STATE_ROW_DATA_CELLS)

-- | @GHOSTTY_RENDER_STATE_ROW_DATA_SELECTION@: Row-local selected cell range (GhosttyRenderStateRowSelection).
pattern GhosttyRenderStateRowDataSelection :: GhosttyRenderStateRowData
pattern GhosttyRenderStateRowDataSelection = GhosttyRenderStateRowData (#const GHOSTTY_RENDER_STATE_ROW_DATA_SELECTION)

-- | @GHOSTTY_RENDER_STATE_ROW_DATA_CELLS_RAW@: A borrowed view of the raw cell values for the current row (GhosttyCellsView). One value per column, identical to querying GHOSTTY\_RENDER\_STATE\_ROW\_CELLS\_DATA\_RAW for each cell. The view is only valid as long as the underlying render state is not updated; it is unsafe to use after updating the render state.
pattern GhosttyRenderStateRowDataCellsRaw :: GhosttyRenderStateRowData
pattern GhosttyRenderStateRowDataCellsRaw = GhosttyRenderStateRowData (#const GHOSTTY_RENDER_STATE_ROW_DATA_CELLS_RAW)

-- | @GHOSTTY_RENDER_STATE_ROW_DATA_VIEWPORT_Y@: The row\'s position relative to the top of the viewport (int32\_t). Viewport rows are 0 through rows - 1. Overscan rows above the viewport are negative, and overscan rows below it start at rows. Without overscan, this equals the y reported by ghostty\_render\_state\_row\_iterator\_next\_dirty().
pattern GhosttyRenderStateRowDataViewportY :: GhosttyRenderStateRowData
pattern GhosttyRenderStateRowDataViewportY = GhosttyRenderStateRowData (#const GHOSTTY_RENDER_STATE_ROW_DATA_VIEWPORT_Y)

-- | @GHOSTTY_RENDER_STATE_ROW_DATA_ID@: The row\'s identity across updates (GhosttyRenderStateRowId). This works with or without overscan. See \"Row Identity\" in the render state overview.
pattern GhosttyRenderStateRowDataId :: GhosttyRenderStateRowData
pattern GhosttyRenderStateRowDataId = GhosttyRenderStateRowData (#const GHOSTTY_RENDER_STATE_ROW_DATA_ID)

-- | Any value this binding does not name: a newer library's.
pattern GhosttyRenderStateRowDataUnknown :: CInt -> GhosttyRenderStateRowData
pattern GhosttyRenderStateRowDataUnknown n <- GhosttyRenderStateRowData (unnamed ghosttyRenderStateRowDataEnum -> Just n)
  where
    GhosttyRenderStateRowDataUnknown n = GhosttyRenderStateRowData n

