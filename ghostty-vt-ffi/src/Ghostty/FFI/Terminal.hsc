pattern GhosttyTerminalDataKittyKeyboardFlags = GhosttyTerminalData (#const GHOSTTY_TERMINAL_DATA_KITTY_KEYBOARD_FLAGS)

-- | @GHOSTTY_TERMINAL_DATA_SCROLLBAR@: Scrollbar state for the terminal viewport.
