-- | @ghostty_terminal_get@: read one key into a pointer of its output type.
-- @unsafe@: it does not call back into Haskell.
foreign import capi unsafe "ghostty/vt.h ghostty_terminal_get"
  ghosttyTerminalGet :: GhosttyTerminal -> GhosttyTerminalData -> Ptr () -> IO GhosttyResult

-- | @ghostty_terminal_get_multi@: read several keys in one call, stopping at
-- the first error; the out count is how many succeeded. @unsafe@: it does not
-- call back into Haskell.
foreign import capi unsafe "ghostty/vt.h ghostty_terminal_get_multi"
  ghosttyTerminalGetMulti :: GhosttyTerminal -> CSize -> Ptr GhosttyTerminalData -> Ptr (Ptr ()) -> Ptr CSize -> IO GhosttyResult

