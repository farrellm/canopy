-- Output type: @GhosttyStyle *@.
pattern GhosttyTerminalDataCursorStyle :: GhosttyTerminalData
pattern GhosttyTerminalDataCursorStyle = GhosttyTerminalData (#const GHOSTTY_TERMINAL_DATA_CURSOR_STYLE)

-- | @GHOSTTY_TERMINAL_DATA_MOUSE_TRACKING@: Whether any mouse tracking mode is active.
--
-- Output type: @bool *@.
pattern GhosttyTerminalDataMouseTracking :: GhosttyTerminalData
pattern GhosttyTerminalDataMouseTracking = GhosttyTerminalData (#const GHOSTTY_TERMINAL_DATA_MOUSE_TRACKING)

-- | @GHOSTTY_TERMINAL_DATA_TITLE@: The terminal title as set by escape sequences (e.g. OSC 0\/2).
--
-- Output type: @GhosttyString *@.
