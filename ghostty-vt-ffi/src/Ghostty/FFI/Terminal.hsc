pattern GhosttyTerminalDataScrollbar = GhosttyTerminalData (#const GHOSTTY_TERMINAL_DATA_SCROLLBAR)

-- | @GHOSTTY_TERMINAL_DATA_CURSOR_STYLE@: The current SGR style of the cursor.
