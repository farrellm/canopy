-- | @GHOSTTY_TERMINAL_OPT_CLIPBOARD_READ@: Callback invoked when the running program requests clipboard contents via OSC 52 with a \"?\" payload or a Kitty clipboard (OSC 5522) read. The read is synchronous and must be answered before the callback returns. Set to NULL (the default) to ignore OSC 52 read requests and refuse OSC 5522 reads with EPERM.
--
-- Input type: @GhosttyTerminalClipboardReadFn@.
pattern GhosttyTerminalOptClipboardRead :: GhosttyTerminalOption
pattern GhosttyTerminalOptClipboardRead = GhosttyTerminalOption (#const GHOSTTY_TERMINAL_OPT_CLIPBOARD_READ)

-- | @GHOSTTY_TERMINAL_OPT_CLIPBOARD_WRITE_MAX_BYTES@: Set the maximum total decoded bytes a single Kitty clipboard protocol (OSC 5522) write transaction may accumulate. The limit is captured when a transaction begins; an in-flight transaction keeps the limit it started with.
--
-- Input type: @size_t*@.
pattern GhosttyTerminalOptClipboardWriteMaxBytes :: GhosttyTerminalOption
pattern GhosttyTerminalOptClipboardWriteMaxBytes = GhosttyTerminalOption (#const GHOSTTY_TERMINAL_OPT_CLIPBOARD_WRITE_MAX_BYTES)

-- | @GHOSTTY_TERMINAL_OPT_RESIZE_PULL_SCROLLBACK@: Set whether a resize may pull rows out of scrollback back into the active area.
--
-- Input type: @bool*@.
pattern GhosttyTerminalOptResizePullScrollback :: GhosttyTerminalOption
pattern GhosttyTerminalOptResizePullScrollback = GhosttyTerminalOption (#const GHOSTTY_TERMINAL_OPT_RESIZE_PULL_SCROLLBACK)

-- | @GHOSTTY_TERMINAL_OPT_RENDER_HOLD@: Callback invoked when the running program asks the terminal to stop updating the screen and when it allows updates again. Today this is driven by synchronized output (mode 2026). Set to NULL to ignore these events.
--
-- Input type: @GhosttyTerminalRenderHoldFn@.
pattern GhosttyTerminalOptRenderHold :: GhosttyTerminalOption
pattern GhosttyTerminalOptRenderHold = GhosttyTerminalOption (#const GHOSTTY_TERMINAL_OPT_RENDER_HOLD)

-- | @GHOSTTY_TERMINAL_OPT_SEMANTIC_PROMPT@: Callback invoked when the shell reports a step of a command: a prompt starts, input starts, output starts, or the command ends. Set to NULL to ignore these events.
--
-- Input type: @GhosttyTerminalSemanticPromptFn@.
pattern GhosttyTerminalOptSemanticPrompt :: GhosttyTerminalOption
pattern GhosttyTerminalOptSemanticPrompt = GhosttyTerminalOption (#const GHOSTTY_TERMINAL_OPT_SEMANTIC_PROMPT)

-- | @GHOSTTY_TERMINAL_OPT_RESET@: Callback invoked after the running program performs a full reset (RIS, ESC c). Set to NULL to ignore resets.
--
-- Input type: @GhosttyTerminalResetFn@.
pattern GhosttyTerminalOptReset :: GhosttyTerminalOption
pattern GhosttyTerminalOptReset = GhosttyTerminalOption (#const GHOSTTY_TERMINAL_OPT_RESET)

-- | @GHOSTTY_TERMINAL_OPT_XT_CHECKSUM_REPORT@: Enable checksum reports in response to DECRQCRA (CSI Pi ; Pg ; Pt ; Pl ; Pb ; Pr \* y).
--
-- Input type: @bool*@.
pattern GhosttyTerminalOptXtChecksumReport :: GhosttyTerminalOption
pattern GhosttyTerminalOptXtChecksumReport = GhosttyTerminalOption (#const GHOSTTY_TERMINAL_OPT_XT_CHECKSUM_REPORT)

-- | @GHOSTTY_TERMINAL_OPT_XT_CHECKSUM_EXTENSION@: Set how the DECRQCRA checksum is calculated after a reset (RIS or DECSTR). This also changes the current calculation.
--
-- Input type: @uint8_t*@.
pattern GhosttyTerminalOptXtChecksumExtension :: GhosttyTerminalOption
pattern GhosttyTerminalOptXtChecksumExtension = GhosttyTerminalOption (#const GHOSTTY_TERMINAL_OPT_XT_CHECKSUM_EXTENSION)

-- | @GHOSTTY_TERMINAL_OPT_PROGRAM_STATUS@: Callback invoked when the running program sends a program status report via OSC 7501. Set to NULL to ignore these reports.
--
-- Input type: @GhosttyTerminalProgramStatusFn@.
pattern GhosttyTerminalOptProgramStatus :: GhosttyTerminalOption
pattern GhosttyTerminalOptProgramStatus = GhosttyTerminalOption (#const GHOSTTY_TERMINAL_OPT_PROGRAM_STATUS)

-- | @GHOSTTY_TERMINAL_OPT_RESIZE_WINDOW@: Callback invoked when the running program asks to resize the window, such as with CSI 8 ; rows ; columns t. Set to NULL to ignore resize requests.
--
-- Input type: @GhosttyTerminalResizeWindowFn@.
pattern GhosttyTerminalOptResizeWindow :: GhosttyTerminalOption
pattern GhosttyTerminalOptResizeWindow = GhosttyTerminalOption (#const GHOSTTY_TERMINAL_OPT_RESIZE_WINDOW)

-- | Any value this binding does not name: a newer library's.
pattern GhosttyTerminalOptionUnknown :: CInt -> GhosttyTerminalOption
pattern GhosttyTerminalOptionUnknown n <- GhosttyTerminalOption (unnamed ghosttyTerminalOptionEnum -> Just n)
  where
    GhosttyTerminalOptionUnknown n = GhosttyTerminalOption n

