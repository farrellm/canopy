-- | Every value of @GhosttyTerminalOption@, for the layout test (§3.4). It is also what
-- 'GhosttyTerminalOptionUnknown' excludes.
ghosttyTerminalOptionEnum :: CEnum
ghosttyTerminalOptionEnum =
  CEnum
    { name = "GhosttyTerminalOption",
      size = (#size GhosttyTerminalOption),
      values =
        [ ("GHOSTTY_TERMINAL_OPT_USERDATA", (#const GHOSTTY_TERMINAL_OPT_USERDATA)),
          ("GHOSTTY_TERMINAL_OPT_WRITE_PTY", (#const GHOSTTY_TERMINAL_OPT_WRITE_PTY)),
          ("GHOSTTY_TERMINAL_OPT_BELL", (#const GHOSTTY_TERMINAL_OPT_BELL)),
          ("GHOSTTY_TERMINAL_OPT_ENQUIRY", (#const GHOSTTY_TERMINAL_OPT_ENQUIRY)),
          ("GHOSTTY_TERMINAL_OPT_XTVERSION", (#const GHOSTTY_TERMINAL_OPT_XTVERSION)),
          ("GHOSTTY_TERMINAL_OPT_TITLE_CHANGED", (#const GHOSTTY_TERMINAL_OPT_TITLE_CHANGED)),
          ("GHOSTTY_TERMINAL_OPT_SIZE", (#const GHOSTTY_TERMINAL_OPT_SIZE)),
          ("GHOSTTY_TERMINAL_OPT_COLOR_SCHEME", (#const GHOSTTY_TERMINAL_OPT_COLOR_SCHEME)),
          ("GHOSTTY_TERMINAL_OPT_DEVICE_ATTRIBUTES", (#const GHOSTTY_TERMINAL_OPT_DEVICE_ATTRIBUTES)),
          ("GHOSTTY_TERMINAL_OPT_TITLE", (#const GHOSTTY_TERMINAL_OPT_TITLE)),
          ("GHOSTTY_TERMINAL_OPT_PWD", (#const GHOSTTY_TERMINAL_OPT_PWD)),
          ("GHOSTTY_TERMINAL_OPT_COLOR_FOREGROUND", (#const GHOSTTY_TERMINAL_OPT_COLOR_FOREGROUND)),
          ("GHOSTTY_TERMINAL_OPT_COLOR_BACKGROUND", (#const GHOSTTY_TERMINAL_OPT_COLOR_BACKGROUND)),
          ("GHOSTTY_TERMINAL_OPT_COLOR_CURSOR", (#const GHOSTTY_TERMINAL_OPT_COLOR_CURSOR)),
          ("GHOSTTY_TERMINAL_OPT_COLOR_PALETTE", (#const GHOSTTY_TERMINAL_OPT_COLOR_PALETTE)),
          ("GHOSTTY_TERMINAL_OPT_KITTY_IMAGE_STORAGE_LIMIT", (#const GHOSTTY_TERMINAL_OPT_KITTY_IMAGE_STORAGE_LIMIT)),
          ("GHOSTTY_TERMINAL_OPT_KITTY_IMAGE_MEDIUM_FILE", (#const GHOSTTY_TERMINAL_OPT_KITTY_IMAGE_MEDIUM_FILE)),
          ("GHOSTTY_TERMINAL_OPT_KITTY_IMAGE_MEDIUM_TEMP_FILE", (#const GHOSTTY_TERMINAL_OPT_KITTY_IMAGE_MEDIUM_TEMP_FILE)),
          ("GHOSTTY_TERMINAL_OPT_KITTY_IMAGE_MEDIUM_SHARED_MEM", (#const GHOSTTY_TERMINAL_OPT_KITTY_IMAGE_MEDIUM_SHARED_MEM)),
          ("GHOSTTY_TERMINAL_OPT_APC_MAX_BYTES", (#const GHOSTTY_TERMINAL_OPT_APC_MAX_BYTES)),
          ("GHOSTTY_TERMINAL_OPT_APC_MAX_BYTES_KITTY", (#const GHOSTTY_TERMINAL_OPT_APC_MAX_BYTES_KITTY)),
          ("GHOSTTY_TERMINAL_OPT_SELECTION", (#const GHOSTTY_TERMINAL_OPT_SELECTION)),
          ("GHOSTTY_TERMINAL_OPT_DEFAULT_CURSOR_STYLE", (#const GHOSTTY_TERMINAL_OPT_DEFAULT_CURSOR_STYLE)),
          ("GHOSTTY_TERMINAL_OPT_DEFAULT_CURSOR_BLINK", (#const GHOSTTY_TERMINAL_OPT_DEFAULT_CURSOR_BLINK)),
          ("GHOSTTY_TERMINAL_OPT_GLYPH_PROTOCOL", (#const GHOSTTY_TERMINAL_OPT_GLYPH_PROTOCOL)),
          ("GHOSTTY_TERMINAL_OPT_PWD_CHANGED", (#const GHOSTTY_TERMINAL_OPT_PWD_CHANGED)),
          ("GHOSTTY_TERMINAL_OPT_CLIPBOARD_WRITE", (#const GHOSTTY_TERMINAL_OPT_CLIPBOARD_WRITE)),
          ("GHOSTTY_TERMINAL_OPT_SCROLLBACK_MAX_BYTES", (#const GHOSTTY_TERMINAL_OPT_SCROLLBACK_MAX_BYTES)),
          ("GHOSTTY_TERMINAL_OPT_SCROLLBACK_MAX_LINES", (#const GHOSTTY_TERMINAL_OPT_SCROLLBACK_MAX_LINES)),
          ("GHOSTTY_TERMINAL_OPT_DESKTOP_NOTIFICATION", (#const GHOSTTY_TERMINAL_OPT_DESKTOP_NOTIFICATION)),
          ("GHOSTTY_TERMINAL_OPT_PROGRESS_REPORT", (#const GHOSTTY_TERMINAL_OPT_PROGRESS_REPORT)),
          ("GHOSTTY_TERMINAL_OPT_CONTINUATION_MAX_BYTES", (#const GHOSTTY_TERMINAL_OPT_CONTINUATION_MAX_BYTES)),
          ("GHOSTTY_TERMINAL_OPT_TITLE_REPORT", (#const GHOSTTY_TERMINAL_OPT_TITLE_REPORT)),
          ("GHOSTTY_TERMINAL_OPT_MODE_DEFAULT", (#const GHOSTTY_TERMINAL_OPT_MODE_DEFAULT)),
          ("GHOSTTY_TERMINAL_OPT_MODE", (#const GHOSTTY_TERMINAL_OPT_MODE)),
          ("GHOSTTY_TERMINAL_OPT_UNKNOWN_SEQUENCE", (#const GHOSTTY_TERMINAL_OPT_UNKNOWN_SEQUENCE)),
          ("GHOSTTY_TERMINAL_OPT_UNKNOWN_MAX_BYTES", (#const GHOSTTY_TERMINAL_OPT_UNKNOWN_MAX_BYTES)),
          ("GHOSTTY_TERMINAL_OPT_TERMINFO_NAME", (#const GHOSTTY_TERMINAL_OPT_TERMINFO_NAME)),
          ("GHOSTTY_TERMINAL_OPT_CLIPBOARD_READ", (#const GHOSTTY_TERMINAL_OPT_CLIPBOARD_READ)),
          ("GHOSTTY_TERMINAL_OPT_CLIPBOARD_WRITE_MAX_BYTES", (#const GHOSTTY_TERMINAL_OPT_CLIPBOARD_WRITE_MAX_BYTES)),
          ("GHOSTTY_TERMINAL_OPT_RESIZE_PULL_SCROLLBACK", (#const GHOSTTY_TERMINAL_OPT_RESIZE_PULL_SCROLLBACK)),
          ("GHOSTTY_TERMINAL_OPT_RENDER_HOLD", (#const GHOSTTY_TERMINAL_OPT_RENDER_HOLD)),
          ("GHOSTTY_TERMINAL_OPT_SEMANTIC_PROMPT", (#const GHOSTTY_TERMINAL_OPT_SEMANTIC_PROMPT)),
          ("GHOSTTY_TERMINAL_OPT_RESET", (#const GHOSTTY_TERMINAL_OPT_RESET)),
          ("GHOSTTY_TERMINAL_OPT_XT_CHECKSUM_REPORT", (#const GHOSTTY_TERMINAL_OPT_XT_CHECKSUM_REPORT)),
          ("GHOSTTY_TERMINAL_OPT_XT_CHECKSUM_EXTENSION", (#const GHOSTTY_TERMINAL_OPT_XT_CHECKSUM_EXTENSION)),
          ("GHOSTTY_TERMINAL_OPT_PROGRAM_STATUS", (#const GHOSTTY_TERMINAL_OPT_PROGRAM_STATUS)),
          ("GHOSTTY_TERMINAL_OPT_RESIZE_WINDOW", (#const GHOSTTY_TERMINAL_OPT_RESIZE_WINDOW))
        ]
    }

-- | @ghostty_terminal_set@: set an option. The value is the option's input
-- type: a pointer to the value, or the pointer itself for callbacks and
-- userdata; null clears. @safe@: the header does not promise that setting an
-- option never reports through a callback, and setting is not on a hot path.
foreign import capi safe "ghostty/vt.h ghostty_terminal_set"
  ghosttyTerminalSet :: GhosttyTerminal -> GhosttyTerminalOption -> Ptr () -> IO GhosttyResult

-- * Data

-- | @GhosttyTerminalData@: Terminal data types.
newtype GhosttyTerminalData = GhosttyTerminalData CInt
  deriving stock (Eq, Show)
  deriving newtype (Storable)

-- | @GHOSTTY_TERMINAL_DATA_INVALID@: Invalid data type. Never results in any data extraction.
pattern GhosttyTerminalDataInvalid :: GhosttyTerminalData
pattern GhosttyTerminalDataInvalid = GhosttyTerminalData (#const GHOSTTY_TERMINAL_DATA_INVALID)

-- | @GHOSTTY_TERMINAL_DATA_COLS@: Terminal width in cells.
--
-- Output type: @uint16_t *@.
pattern GhosttyTerminalDataCols :: GhosttyTerminalData
pattern GhosttyTerminalDataCols = GhosttyTerminalData (#const GHOSTTY_TERMINAL_DATA_COLS)

-- | @GHOSTTY_TERMINAL_DATA_ROWS@: Terminal height in cells.
--
-- Output type: @uint16_t *@.
pattern GhosttyTerminalDataRows :: GhosttyTerminalData
pattern GhosttyTerminalDataRows = GhosttyTerminalData (#const GHOSTTY_TERMINAL_DATA_ROWS)

-- | @GHOSTTY_TERMINAL_DATA_CURSOR_X@: Cursor column position (0-indexed).
--
-- Output type: @uint16_t *@.
pattern GhosttyTerminalDataCursorX :: GhosttyTerminalData
pattern GhosttyTerminalDataCursorX = GhosttyTerminalData (#const GHOSTTY_TERMINAL_DATA_CURSOR_X)

-- | @GHOSTTY_TERMINAL_DATA_CURSOR_Y@: Cursor row position within the active area (0-indexed).
--
-- Output type: @uint16_t *@.
pattern GhosttyTerminalDataCursorY :: GhosttyTerminalData
pattern GhosttyTerminalDataCursorY = GhosttyTerminalData (#const GHOSTTY_TERMINAL_DATA_CURSOR_Y)

-- | @GHOSTTY_TERMINAL_DATA_CURSOR_PENDING_WRAP@: Whether the cursor has a pending wrap (next print will soft-wrap).
--
-- Output type: @bool *@.
pattern GhosttyTerminalDataCursorPendingWrap :: GhosttyTerminalData
pattern GhosttyTerminalDataCursorPendingWrap = GhosttyTerminalData (#const GHOSTTY_TERMINAL_DATA_CURSOR_PENDING_WRAP)

-- | @GHOSTTY_TERMINAL_DATA_ACTIVE_SCREEN@: The currently active screen.
--
-- Output type: @GhosttyTerminalScreen *@.
pattern GhosttyTerminalDataActiveScreen :: GhosttyTerminalData
pattern GhosttyTerminalDataActiveScreen = GhosttyTerminalData (#const GHOSTTY_TERMINAL_DATA_ACTIVE_SCREEN)

-- | @GHOSTTY_TERMINAL_DATA_CURSOR_VISIBLE@: Whether the cursor is visible (DEC mode 25).
--
-- Output type: @bool *@.
pattern GhosttyTerminalDataCursorVisible :: GhosttyTerminalData
pattern GhosttyTerminalDataCursorVisible = GhosttyTerminalData (#const GHOSTTY_TERMINAL_DATA_CURSOR_VISIBLE)

