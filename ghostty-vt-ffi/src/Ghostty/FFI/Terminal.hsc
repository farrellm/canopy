    { name = "GhosttyTerminalStringKind",
      size = (#size GhosttyTerminalStringKind),
      values =
        [ ("GHOSTTY_TERMINAL_STRING_KIND_APC", (#const GHOSTTY_TERMINAL_STRING_KIND_APC)),
          ("GHOSTTY_TERMINAL_STRING_KIND_DCS", (#const GHOSTTY_TERMINAL_STRING_KIND_DCS)),
          ("GHOSTTY_TERMINAL_STRING_KIND_OSC", (#const GHOSTTY_TERMINAL_STRING_KIND_OSC))
        ]
    }

-- | @GhosttyTerminalStringIntroducer@: How a control string started.
newtype GhosttyTerminalStringIntroducer = GhosttyTerminalStringIntroducer CInt
  deriving stock (Eq, Show)
  deriving newtype (Storable)

-- | @GHOSTTY_TERMINAL_STRING_INTRODUCER_ESC@: ESC followed by @_@, @X@, @^@, @P@ or @]@. The stop\'s @consumed@ count includes only the final byte, because the ESC may have arrived in an earlier call.
pattern GhosttyTerminalStringIntroducerEsc :: GhosttyTerminalStringIntroducer
pattern GhosttyTerminalStringIntroducerEsc = GhosttyTerminalStringIntroducer (#const GHOSTTY_TERMINAL_STRING_INTRODUCER_ESC)

-- | @GHOSTTY_TERMINAL_STRING_INTRODUCER_C1@: A single 8-bit byte: 0x9F (APC), 0x98 (SOS), 0x9E (PM), 0x90 (DCS) or 0x9D (OSC).
pattern GhosttyTerminalStringIntroducerC1 :: GhosttyTerminalStringIntroducer
pattern GhosttyTerminalStringIntroducerC1 = GhosttyTerminalStringIntroducer (#const GHOSTTY_TERMINAL_STRING_INTRODUCER_C1)

-- | Any value this binding does not name: a newer library's.
pattern GhosttyTerminalStringIntroducerUnknown :: CInt -> GhosttyTerminalStringIntroducer
pattern GhosttyTerminalStringIntroducerUnknown n <- GhosttyTerminalStringIntroducer (unnamed ghosttyTerminalStringIntroducerEnum -> Just n)
  where
    GhosttyTerminalStringIntroducerUnknown n = GhosttyTerminalStringIntroducer n

{-# COMPLETE
  GhosttyTerminalStringIntroducerEsc,
  GhosttyTerminalStringIntroducerC1,
  GhosttyTerminalStringIntroducerUnknown
  #-}

-- | Every value of @GhosttyTerminalStringIntroducer@, for the layout test (§3.4). It is also what
-- 'GhosttyTerminalStringIntroducerUnknown' excludes.
ghosttyTerminalStringIntroducerEnum :: CEnum
ghosttyTerminalStringIntroducerEnum =
  CEnum
    { name = "GhosttyTerminalStringIntroducer",
      size = (#size GhosttyTerminalStringIntroducer),
      values =
        [ ("GHOSTTY_TERMINAL_STRING_INTRODUCER_ESC", (#const GHOSTTY_TERMINAL_STRING_INTRODUCER_ESC)),
          ("GHOSTTY_TERMINAL_STRING_INTRODUCER_C1", (#const GHOSTTY_TERMINAL_STRING_INTRODUCER_C1))
        ]
    }

-- | @GhosttyTerminalStringEnd@: How a control string ended.
newtype GhosttyTerminalStringEnd = GhosttyTerminalStringEnd CInt
  deriving stock (Eq, Show)
  deriving newtype (Storable)

-- | @GHOSTTY_TERMINAL_STRING_END_ST_ESC@: ESC, the first byte of the string terminator @ESC \\@.
pattern GhosttyTerminalStringEndStEsc :: GhosttyTerminalStringEnd
pattern GhosttyTerminalStringEndStEsc = GhosttyTerminalStringEnd (#const GHOSTTY_TERMINAL_STRING_END_ST_ESC)

-- | @GHOSTTY_TERMINAL_STRING_END_ST_C1@: 0x9C, the 8-bit string terminator. The stream is now at ground.
pattern GhosttyTerminalStringEndStC1 :: GhosttyTerminalStringEnd
pattern GhosttyTerminalStringEndStC1 = GhosttyTerminalStringEnd (#const GHOSTTY_TERMINAL_STRING_END_ST_C1)

-- | @GHOSTTY_TERMINAL_STRING_END_CANCELLED@: CAN (0x18) or SUB (0x1A) cancelled the string. The stream is now at ground.
pattern GhosttyTerminalStringEndCancelled :: GhosttyTerminalStringEnd
pattern GhosttyTerminalStringEndCancelled = GhosttyTerminalStringEnd (#const GHOSTTY_TERMINAL_STRING_END_CANCELLED)

-- | @GHOSTTY_TERMINAL_STRING_END_ABORTED@: Another 8-bit control byte cut the string short. Most of these return the stream to ground. CSI (0x9B) starts a CSI sequence instead. The introducers DCS (0x90), OSC (0x9D), APC (0x9F), SOS (0x98) and PM (0x9E) start a new string on the same byte, which the stop reports with a START flag as well. See GhosttyTerminalWriteStop.reached.
pattern GhosttyTerminalStringEndAborted :: GhosttyTerminalStringEnd
pattern GhosttyTerminalStringEndAborted = GhosttyTerminalStringEnd (#const GHOSTTY_TERMINAL_STRING_END_ABORTED)

-- | @GHOSTTY_TERMINAL_STRING_END_BEL@: BEL (0x07) terminated the string. Only an OSC ends this way.
pattern GhosttyTerminalStringEndBel :: GhosttyTerminalStringEnd
pattern GhosttyTerminalStringEndBel = GhosttyTerminalStringEnd (#const GHOSTTY_TERMINAL_STRING_END_BEL)

-- | Any value this binding does not name: a newer library's.
pattern GhosttyTerminalStringEndUnknown :: CInt -> GhosttyTerminalStringEnd
pattern GhosttyTerminalStringEndUnknown n <- GhosttyTerminalStringEnd (unnamed ghosttyTerminalStringEndEnum -> Just n)
  where
    GhosttyTerminalStringEndUnknown n = GhosttyTerminalStringEnd n

{-# COMPLETE
  GhosttyTerminalStringEndStEsc,
  GhosttyTerminalStringEndStC1,
  GhosttyTerminalStringEndCancelled,
  GhosttyTerminalStringEndAborted,
  GhosttyTerminalStringEndBel,
  GhosttyTerminalStringEndUnknown
  #-}

-- | Every value of @GhosttyTerminalStringEnd@, for the layout test (§3.4). It is also what
-- 'GhosttyTerminalStringEndUnknown' excludes.
ghosttyTerminalStringEndEnum :: CEnum
ghosttyTerminalStringEndEnum =
  CEnum
    { name = "GhosttyTerminalStringEnd",
      size = (#size GhosttyTerminalStringEnd),
      values =
        [ ("GHOSTTY_TERMINAL_STRING_END_ST_ESC", (#const GHOSTTY_TERMINAL_STRING_END_ST_ESC)),
          ("GHOSTTY_TERMINAL_STRING_END_ST_C1", (#const GHOSTTY_TERMINAL_STRING_END_ST_C1)),
          ("GHOSTTY_TERMINAL_STRING_END_CANCELLED", (#const GHOSTTY_TERMINAL_STRING_END_CANCELLED)),
          ("GHOSTTY_TERMINAL_STRING_END_ABORTED", (#const GHOSTTY_TERMINAL_STRING_END_ABORTED)),
          ("GHOSTTY_TERMINAL_STRING_END_BEL", (#const GHOSTTY_TERMINAL_STRING_END_BEL))
        ]
    }

-- | @GhosttyTerminalWriteStop@: Where ghostty\_terminal\_vt\_write\_until() stopped, and why.
data GhosttyTerminalWriteStop = GhosttyTerminalWriteStop
  { -- | @size@: Size of this struct in bytes. Set by GHOSTTY\_INIT\_SIZED().
    size :: CSize,
    -- | @consumed@: Number of input bytes consumed, including the byte that reached the boundary. This is 0 when the stream was already at ground and you asked for GHOSTTY\_TERMINAL\_BOUNDARY\_GROUND.
    consumed :: CSize,
    -- | @reached@: The GhosttyTerminalBoundary flags that the stopping byte reached. Only flags you asked for are set, and this is 0 when no boundary was reached.
    reached :: Word32,
    -- | @kind@: The kind of string. Valid when @reached@ has a START or END flag.
    kind :: GhosttyTerminalStringKind,
    -- | @introducer@: How the string started. Valid when @reached@ has a START flag.
    introducer :: GhosttyTerminalStringIntroducer,
    -- | @end@: How the string ended. Valid when @reached@ has an END flag.
    end :: GhosttyTerminalStringEnd,
    -- | @byte@: The byte that started or ended the string, such as @]@, 0x90, ESC or BEL. Valid when @reached@ has a START or END flag.
    byte :: Word8
  }
  deriving stock (Eq, Show)

instance Storable GhosttyTerminalWriteStop where
  sizeOf _ = (#size GhosttyTerminalWriteStop)
  alignment _ = (#alignment GhosttyTerminalWriteStop)
  peek p =
    GhosttyTerminalWriteStop
      <$> (#peek GhosttyTerminalWriteStop, size) p
      <*> (#peek GhosttyTerminalWriteStop, consumed) p
      <*> (#peek GhosttyTerminalWriteStop, reached) p
      <*> (#peek GhosttyTerminalWriteStop, kind) p
      <*> (#peek GhosttyTerminalWriteStop, introducer) p
      <*> (#peek GhosttyTerminalWriteStop, end) p
      <*> (#peek GhosttyTerminalWriteStop, byte) p
  poke p s = do
    (#poke GhosttyTerminalWriteStop, size) p s.size
    (#poke GhosttyTerminalWriteStop, consumed) p s.consumed
    (#poke GhosttyTerminalWriteStop, reached) p s.reached
    (#poke GhosttyTerminalWriteStop, kind) p s.kind
    (#poke GhosttyTerminalWriteStop, introducer) p s.introducer
    (#poke GhosttyTerminalWriteStop, end) p s.end
    (#poke GhosttyTerminalWriteStop, byte) p s.byte

-- | The layout of @GhosttyTerminalWriteStop@ as compiled, for the layout test (§3.4).
ghosttyTerminalWriteStopLayout :: CStruct
ghosttyTerminalWriteStopLayout =
  CStruct
    { name = "GhosttyTerminalWriteStop",
      size = (#size GhosttyTerminalWriteStop),
      align = (#alignment GhosttyTerminalWriteStop),
      fields =
        [ CField "size" (#offset GhosttyTerminalWriteStop, size) (#const GVTFFI_FIELD_SIZE(GhosttyTerminalWriteStop, size)),
          CField "consumed" (#offset GhosttyTerminalWriteStop, consumed) (#const GVTFFI_FIELD_SIZE(GhosttyTerminalWriteStop, consumed)),
          CField "reached" (#offset GhosttyTerminalWriteStop, reached) (#const GVTFFI_FIELD_SIZE(GhosttyTerminalWriteStop, reached)),
          CField "kind" (#offset GhosttyTerminalWriteStop, kind) (#const GVTFFI_FIELD_SIZE(GhosttyTerminalWriteStop, kind)),
          CField "introducer" (#offset GhosttyTerminalWriteStop, introducer) (#const GVTFFI_FIELD_SIZE(GhosttyTerminalWriteStop, introducer)),
          CField "end" (#offset GhosttyTerminalWriteStop, end) (#const GVTFFI_FIELD_SIZE(GhosttyTerminalWriteStop, end)),
          CField "byte" (#offset GhosttyTerminalWriteStop, byte) (#const GVTFFI_FIELD_SIZE(GhosttyTerminalWriteStop, byte))
        ]
    }

-- * Continuations

-- | @ghostty_terminal_continuation_write@: write the replay-safe continuation
-- (the bytes that rebuild an unfinished sequence) to a writer. The C function
-- takes the writer by value, so this calls a pointer shim (@gvtffi_shims.h@,
-- §3.3). @safe@: it calls the writer, which may be a Haskell function.
foreign import capi safe "gvtffi_shims.h gvtffi_terminal_continuation_write"
  ghosttyTerminalContinuationWrite :: GhosttyTerminal -> Ptr GhosttyWriter -> IO GhosttyResult

-- | @ghostty_terminal_continuation_buf@: copy the continuation into a buffer;
-- @GHOSTTY_OUT_OF_SPACE@ reports the size needed. @unsafe@: it does not call
-- back into Haskell.
foreign import capi unsafe "ghostty/vt.h ghostty_terminal_continuation_buf"
  ghosttyTerminalContinuationBuf :: GhosttyTerminal -> Ptr Word8 -> CSize -> Ptr CSize -> IO GhosttyResult

-- | @ghostty_terminal_continuation_alloc@: an allocated copy of the
-- continuation, to be released with 'Ghostty.FFI.Allocator.ghosttyFree'.
-- @unsafe@: it does not call back into Haskell.
foreign import capi unsafe "ghostty/vt.h ghostty_terminal_continuation_alloc"
  ghosttyTerminalContinuationAlloc :: GhosttyTerminal -> Ptr GhosttyAllocator -> Ptr (Ptr Word8) -> Ptr CSize -> IO GhosttyResult

-- * Viewport

-- | @GhosttyTerminalScrollViewportTag@: Scroll viewport behavior tag.
newtype GhosttyTerminalScrollViewportTag = GhosttyTerminalScrollViewportTag CInt
  deriving stock (Eq, Show)
  deriving newtype (Storable)

-- | @GHOSTTY_SCROLL_VIEWPORT_TOP@: Scroll to the top of the scrollback.
pattern GhosttyScrollViewportTop :: GhosttyTerminalScrollViewportTag
pattern GhosttyScrollViewportTop = GhosttyTerminalScrollViewportTag (#const GHOSTTY_SCROLL_VIEWPORT_TOP)

-- | @GHOSTTY_SCROLL_VIEWPORT_BOTTOM@: Scroll to the bottom (active area).
pattern GhosttyScrollViewportBottom :: GhosttyTerminalScrollViewportTag
pattern GhosttyScrollViewportBottom = GhosttyTerminalScrollViewportTag (#const GHOSTTY_SCROLL_VIEWPORT_BOTTOM)

-- | @GHOSTTY_SCROLL_VIEWPORT_DELTA@: Scroll by a delta amount (up is negative).
pattern GhosttyScrollViewportDelta :: GhosttyTerminalScrollViewportTag
pattern GhosttyScrollViewportDelta = GhosttyTerminalScrollViewportTag (#const GHOSTTY_SCROLL_VIEWPORT_DELTA)

-- | @GHOSTTY_SCROLL_VIEWPORT_ROW@: Scroll to an absolute row offset from the top of the scrollable area. Row 0 is the top of the scrollback and the requested row becomes the first visible row of the viewport. The value is clamped so the viewport never scrolls beyond the top of the active area. If the terminal has no scrollback (e.g. the alternate screen is active), the viewport always remains on the active area.
pattern GhosttyScrollViewportRow :: GhosttyTerminalScrollViewportTag
pattern GhosttyScrollViewportRow = GhosttyTerminalScrollViewportTag (#const GHOSTTY_SCROLL_VIEWPORT_ROW)

-- | @GHOSTTY_SCROLL_VIEWPORT_DELTA_PROMPT@: Scroll by a number of prompts relative to the viewport top. Negative values move backward and positive values move forward. Requires semantic prompt markers from the shell. Zero or no matching prompt is a no-op. If fewer prompts remain than requested, move to the last matching prompt, clamped to the active area.
pattern GhosttyScrollViewportDeltaPrompt :: GhosttyTerminalScrollViewportTag
pattern GhosttyScrollViewportDeltaPrompt = GhosttyTerminalScrollViewportTag (#const GHOSTTY_SCROLL_VIEWPORT_DELTA_PROMPT)

-- | Any value this binding does not name: a newer library's.
pattern GhosttyTerminalScrollViewportTagUnknown :: CInt -> GhosttyTerminalScrollViewportTag
pattern GhosttyTerminalScrollViewportTagUnknown n <- GhosttyTerminalScrollViewportTag (unnamed ghosttyTerminalScrollViewportTagEnum -> Just n)
  where
    GhosttyTerminalScrollViewportTagUnknown n = GhosttyTerminalScrollViewportTag n

{-# COMPLETE
  GhosttyScrollViewportTop,
  GhosttyScrollViewportBottom,
  GhosttyScrollViewportDelta,
  GhosttyScrollViewportRow,
  GhosttyScrollViewportDeltaPrompt,
  GhosttyTerminalScrollViewportTagUnknown
  #-}

-- | Every value of @GhosttyTerminalScrollViewportTag@, for the layout test (§3.4). It is also what
-- 'GhosttyTerminalScrollViewportTagUnknown' excludes.
ghosttyTerminalScrollViewportTagEnum :: CEnum
ghosttyTerminalScrollViewportTagEnum =
  CEnum
    { name = "GhosttyTerminalScrollViewportTag",
      size = (#size GhosttyTerminalScrollViewportTag),
      values =
        [ ("GHOSTTY_SCROLL_VIEWPORT_TOP", (#const GHOSTTY_SCROLL_VIEWPORT_TOP)),
          ("GHOSTTY_SCROLL_VIEWPORT_BOTTOM", (#const GHOSTTY_SCROLL_VIEWPORT_BOTTOM)),
          ("GHOSTTY_SCROLL_VIEWPORT_DELTA", (#const GHOSTTY_SCROLL_VIEWPORT_DELTA)),
          ("GHOSTTY_SCROLL_VIEWPORT_ROW", (#const GHOSTTY_SCROLL_VIEWPORT_ROW)),
          ("GHOSTTY_SCROLL_VIEWPORT_DELTA_PROMPT", (#const GHOSTTY_SCROLL_VIEWPORT_DELTA_PROMPT))
        ]
    }

-- | @GhosttyTerminalScrollViewport@: how to scroll the viewport. A tagged union
-- in C, so a sum here with an arm per tag (§3.3).
data GhosttyTerminalScrollViewport
  = -- | @GHOSTTY_SCROLL_VIEWPORT_TOP@: to the top of the scrollback.
    ScrollViewportTop
  | -- | @GHOSTTY_SCROLL_VIEWPORT_BOTTOM@: to the active area.
    ScrollViewportBottom
  | -- | @GHOSTTY_SCROLL_VIEWPORT_DELTA@: by @value.delta@ rows, up negative.
    ScrollViewportDelta CIntPtr
  | -- | @GHOSTTY_SCROLL_VIEWPORT_ROW@: to the absolute row @value.row@.
    ScrollViewportRow CSize
  | -- | @GHOSTTY_SCROLL_VIEWPORT_DELTA_PROMPT@: by @value.delta_prompt@
    -- semantic prompts, back negative.
    ScrollViewportDeltaPrompt CIntPtr
  | -- | A tag this binding does not name, whose value it cannot read.
    ScrollViewportOther GhosttyTerminalScrollViewportTag
  deriving stock (Eq, Show)

instance Storable GhosttyTerminalScrollViewport where
  sizeOf _ = (#size GhosttyTerminalScrollViewport)
  alignment _ = (#alignment GhosttyTerminalScrollViewport)
  peek p =
    (#peek GhosttyTerminalScrollViewport, tag) p >>= \case
      GhosttyScrollViewportTop -> pure ScrollViewportTop
      GhosttyScrollViewportBottom -> pure ScrollViewportBottom
      GhosttyScrollViewportDelta -> ScrollViewportDelta <$> (#peek GhosttyTerminalScrollViewport, value.delta) p
      GhosttyScrollViewportRow -> ScrollViewportRow <$> (#peek GhosttyTerminalScrollViewport, value.row) p
      GhosttyScrollViewportDeltaPrompt -> ScrollViewportDeltaPrompt <$> (#peek GhosttyTerminalScrollViewport, value.delta_prompt) p
      tag@(GhosttyTerminalScrollViewportTagUnknown _) -> pure (ScrollViewportOther tag)
  poke p = \case
    ScrollViewportTop -> (#poke GhosttyTerminalScrollViewport, tag) p GhosttyScrollViewportTop
    ScrollViewportBottom -> (#poke GhosttyTerminalScrollViewport, tag) p GhosttyScrollViewportBottom
    ScrollViewportDelta n -> do
      (#poke GhosttyTerminalScrollViewport, tag) p GhosttyScrollViewportDelta
      (#poke GhosttyTerminalScrollViewport, value.delta) p n
    ScrollViewportRow n -> do
      (#poke GhosttyTerminalScrollViewport, tag) p GhosttyScrollViewportRow
      (#poke GhosttyTerminalScrollViewport, value.row) p n
    ScrollViewportDeltaPrompt n -> do
      (#poke GhosttyTerminalScrollViewport, tag) p GhosttyScrollViewportDeltaPrompt
      (#poke GhosttyTerminalScrollViewport, value.delta_prompt) p n
    ScrollViewportOther tag -> (#poke GhosttyTerminalScrollViewport, tag) p tag

-- | The layout of @GhosttyTerminalScrollViewport@ as compiled, for the layout test (§3.4).
ghosttyTerminalScrollViewportLayout :: CStruct
ghosttyTerminalScrollViewportLayout =
  CStruct
    { name = "GhosttyTerminalScrollViewport",
      size = (#size GhosttyTerminalScrollViewport),
      align = (#alignment GhosttyTerminalScrollViewport),
      fields =
        [ CField "tag" (#offset GhosttyTerminalScrollViewport, tag) (#const GVTFFI_FIELD_SIZE(GhosttyTerminalScrollViewport, tag)),
          CField "value" (#offset GhosttyTerminalScrollViewport, value) (#const GVTFFI_FIELD_SIZE(GhosttyTerminalScrollViewport, value))
        ]
    }

-- | @ghostty_terminal_scroll_viewport@. The C function takes the behaviour by
-- value, so this calls a pointer shim (@gvtffi_shims.h@, §3.3). @unsafe@: it
-- does not call back into Haskell.
foreign import capi unsafe "gvtffi_shims.h gvtffi_terminal_scroll_viewport"
  ghosttyTerminalScrollViewport :: GhosttyTerminal -> Ptr GhosttyTerminalScrollViewport -> IO ()

-- * Compression

-- | @GhosttyTerminalCompressionMode@: Amount of compression work to perform before returning.
newtype GhosttyTerminalCompressionMode = GhosttyTerminalCompressionMode CInt
  deriving stock (Eq, Show)
  deriving newtype (Storable)

-- | @GHOSTTY_TERMINAL_COMPRESSION_MODE_INCREMENTAL@: Perform one bounded compression step suitable for idle scheduling.
pattern GhosttyTerminalCompressionModeIncremental :: GhosttyTerminalCompressionMode
pattern GhosttyTerminalCompressionModeIncremental = GhosttyTerminalCompressionMode (#const GHOSTTY_TERMINAL_COMPRESSION_MODE_INCREMENTAL)

-- | @GHOSTTY_TERMINAL_COMPRESSION_MODE_FULL@: Synchronously inspect every currently eligible page.
pattern GhosttyTerminalCompressionModeFull :: GhosttyTerminalCompressionMode
pattern GhosttyTerminalCompressionModeFull = GhosttyTerminalCompressionMode (#const GHOSTTY_TERMINAL_COMPRESSION_MODE_FULL)

-- | Any value this binding does not name: a newer library's.
pattern GhosttyTerminalCompressionModeUnknown :: CInt -> GhosttyTerminalCompressionMode
pattern GhosttyTerminalCompressionModeUnknown n <- GhosttyTerminalCompressionMode (unnamed ghosttyTerminalCompressionModeEnum -> Just n)
  where
    GhosttyTerminalCompressionModeUnknown n = GhosttyTerminalCompressionMode n

{-# COMPLETE
  GhosttyTerminalCompressionModeIncremental,
  GhosttyTerminalCompressionModeFull,
  GhosttyTerminalCompressionModeUnknown
  #-}

-- | Every value of @GhosttyTerminalCompressionMode@, for the layout test (§3.4). It is also what
-- 'GhosttyTerminalCompressionModeUnknown' excludes.
ghosttyTerminalCompressionModeEnum :: CEnum
ghosttyTerminalCompressionModeEnum =
  CEnum
    { name = "GhosttyTerminalCompressionMode",
      size = (#size GhosttyTerminalCompressionMode),
      values =
        [ ("GHOSTTY_TERMINAL_COMPRESSION_MODE_INCREMENTAL", (#const GHOSTTY_TERMINAL_COMPRESSION_MODE_INCREMENTAL)),
          ("GHOSTTY_TERMINAL_COMPRESSION_MODE_FULL", (#const GHOSTTY_TERMINAL_COMPRESSION_MODE_FULL))
        ]
    }

-- | @GhosttyTerminalCompressionResult@: Scheduling result from terminal compression.
newtype GhosttyTerminalCompressionResult = GhosttyTerminalCompressionResult CInt
  deriving stock (Eq, Show)
  deriving newtype (Storable)

-- | @GHOSTTY_TERMINAL_COMPRESSION_RESULT_UNSUPPORTED@: Retained-mapping reclamation is unavailable on this target.
pattern GhosttyTerminalCompressionResultUnsupported :: GhosttyTerminalCompressionResult
pattern GhosttyTerminalCompressionResultUnsupported = GhosttyTerminalCompressionResult (#const GHOSTTY_TERMINAL_COMPRESSION_RESULT_UNSUPPORTED)

-- | @GHOSTTY_TERMINAL_COMPRESSION_RESULT_PENDING@: More incremental compression work remains.
pattern GhosttyTerminalCompressionResultPending :: GhosttyTerminalCompressionResult
pattern GhosttyTerminalCompressionResultPending = GhosttyTerminalCompressionResult (#const GHOSTTY_TERMINAL_COMPRESSION_RESULT_PENDING)

-- | @GHOSTTY_TERMINAL_COMPRESSION_RESULT_COMPLETE@: The pass has no continuation to schedule.
pattern GhosttyTerminalCompressionResultComplete :: GhosttyTerminalCompressionResult
pattern GhosttyTerminalCompressionResultComplete = GhosttyTerminalCompressionResult (#const GHOSTTY_TERMINAL_COMPRESSION_RESULT_COMPLETE)

-- | Any value this binding does not name: a newer library's.
pattern GhosttyTerminalCompressionResultUnknown :: CInt -> GhosttyTerminalCompressionResult
pattern GhosttyTerminalCompressionResultUnknown n <- GhosttyTerminalCompressionResult (unnamed ghosttyTerminalCompressionResultEnum -> Just n)
  where
    GhosttyTerminalCompressionResultUnknown n = GhosttyTerminalCompressionResult n

{-# COMPLETE
  GhosttyTerminalCompressionResultUnsupported,
  GhosttyTerminalCompressionResultPending,
  GhosttyTerminalCompressionResultComplete,
  GhosttyTerminalCompressionResultUnknown
  #-}

-- | Every value of @GhosttyTerminalCompressionResult@, for the layout test (§3.4). It is also what
-- 'GhosttyTerminalCompressionResultUnknown' excludes.
ghosttyTerminalCompressionResultEnum :: CEnum
ghosttyTerminalCompressionResultEnum =
  CEnum
    { name = "GhosttyTerminalCompressionResult",
      size = (#size GhosttyTerminalCompressionResult),
      values =
        [ ("GHOSTTY_TERMINAL_COMPRESSION_RESULT_UNSUPPORTED", (#const GHOSTTY_TERMINAL_COMPRESSION_RESULT_UNSUPPORTED)),
          ("GHOSTTY_TERMINAL_COMPRESSION_RESULT_PENDING", (#const GHOSTTY_TERMINAL_COMPRESSION_RESULT_PENDING)),
          ("GHOSTTY_TERMINAL_COMPRESSION_RESULT_COMPLETE", (#const GHOSTTY_TERMINAL_COMPRESSION_RESULT_COMPLETE))
        ]
    }

-- | @ghostty_terminal_compression_activity@: an opaque token that changes when
-- compression-relevant state does. @unsafe@: it does not call back into
-- Haskell.
foreign import capi unsafe "ghostty/vt.h ghostty_terminal_compression_activity"
  ghosttyTerminalCompressionActivity :: GhosttyTerminal -> Ptr Word64 -> IO GhosttyResult

-- | @ghostty_terminal_compress@: compress eligible scrollback, one bounded
-- step or a full pass. @safe@: it calls nothing back, but a full pass can
-- stall, and an @unsafe@ call would hold every other Haskell thread up at the
-- next garbage collection.
foreign import capi safe "ghostty/vt.h ghostty_terminal_compress"
  ghosttyTerminalCompress :: GhosttyTerminal -> GhosttyTerminalCompressionMode -> Ptr GhosttyTerminalCompressionResult -> IO GhosttyResult

-- * Grid references

-- | @ghostty_terminal_grid_ref@: an untracked reference to the cell at a point,
-- valid until the next mutating call. The C function takes the point by value,
-- so this calls a pointer shim (@gvtffi_shims.h@, §3.3). @unsafe@: it does not
-- call back into Haskell.
foreign import capi unsafe "gvtffi_shims.h gvtffi_terminal_grid_ref"
  ghosttyTerminalGridRef :: GhosttyTerminal -> Ptr GhosttyPoint -> Ptr GhosttyGridRef -> IO GhosttyResult

-- | @ghostty_terminal_grid_ref_track@: a tracked reference to the cell at a
-- point, to be freed with 'Ghostty.FFI.GridRef.ghosttyTrackedGridRefFree'.
-- The C function takes the point by value, so this calls a pointer shim
-- (@gvtffi_shims.h@, §3.3). @unsafe@: it does not call back into Haskell.
foreign import capi unsafe "gvtffi_shims.h gvtffi_terminal_grid_ref_track"
  ghosttyTerminalGridRefTrack :: GhosttyTerminal -> Ptr GhosttyPoint -> Ptr GhosttyTrackedGridRef -> IO GhosttyResult

-- | @ghostty_terminal_point_from_grid_ref@: an untracked reference's position
-- in a coordinate system, or @GHOSTTY_NO_VALUE@ if it has none there.
-- @unsafe@: it does not call back into Haskell.
foreign import capi unsafe "ghostty/vt.h ghostty_terminal_point_from_grid_ref"
  ghosttyTerminalPointFromGridRef :: GhosttyTerminal -> Ptr GhosttyGridRef -> GhosttyPointTag -> Ptr GhosttyPointCoordinate -> IO GhosttyResult
