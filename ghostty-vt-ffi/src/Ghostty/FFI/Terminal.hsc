-- | @GhosttyTerminalScrollbar@: Scrollbar state for the terminal viewport.
data GhosttyTerminalScrollbar = GhosttyTerminalScrollbar
  { -- | @total@: Total size of the scrollable area in rows.
    total :: Word64,
    -- | @offset@: Offset into the total area that the viewport is at.
    offset :: Word64,
    -- | @len@: Length of the visible area in rows.
    len :: Word64
  }
  deriving stock (Eq, Show)

instance Storable GhosttyTerminalScrollbar where
  sizeOf _ = (#size GhosttyTerminalScrollbar)
  alignment _ = (#alignment GhosttyTerminalScrollbar)
  peek p =
    GhosttyTerminalScrollbar
      <$> (#peek GhosttyTerminalScrollbar, total) p
      <*> (#peek GhosttyTerminalScrollbar, offset) p
      <*> (#peek GhosttyTerminalScrollbar, len) p
  poke p s = do
    (#poke GhosttyTerminalScrollbar, total) p s.total
    (#poke GhosttyTerminalScrollbar, offset) p s.offset
    (#poke GhosttyTerminalScrollbar, len) p s.len

-- | The layout of @GhosttyTerminalScrollbar@ as compiled, for the layout test (§3.4).
ghosttyTerminalScrollbarLayout :: CStruct
ghosttyTerminalScrollbarLayout =
  CStruct
    { name = "GhosttyTerminalScrollbar",
      size = (#size GhosttyTerminalScrollbar),
      align = (#alignment GhosttyTerminalScrollbar),
      fields =
        [ CField "total" (#offset GhosttyTerminalScrollbar, total) (#const GVTFFI_FIELD_SIZE(GhosttyTerminalScrollbar, total)),
          CField "offset" (#offset GhosttyTerminalScrollbar, offset) (#const GVTFFI_FIELD_SIZE(GhosttyTerminalScrollbar, offset)),
          CField "len" (#offset GhosttyTerminalScrollbar, len) (#const GVTFFI_FIELD_SIZE(GhosttyTerminalScrollbar, len))
        ]
    }

-- | @GhosttyTerminalMemoryUsage@: Memory held by a terminal.
data GhosttyTerminalMemoryUsage = GhosttyTerminalMemoryUsage
  { -- | @size@: Size of this struct in bytes. Set by the caller.
    size :: CSize,
    -- | @compression_supported@: Whether compressing scrollback can free memory on this platform. When false, ghostty\_terminal\_compress() reports @GHOSTTY_TERMINAL_COMPRESSION_RESULT_UNSUPPORTED@ and the compressed fields are always zero. To reduce a terminal\'s memory on such a platform, you have to do something else, such as closing it.
    compressionSupported :: CBool,
    -- | @primary_pages@: Number of pages in the primary screen, including compressed pages.
    primaryPages :: Word64,
    -- | @primary_virtual_bytes@: Bytes of address space reserved for the primary screen\'s pages. This includes compressed pages and spare pages kept ready for reuse. Always at least @primary_resident_bytes@.
    primaryVirtualBytes :: Word64,
    -- | @primary_resident_bytes@: Bytes of physical memory used by the primary screen\'s pages. A compressed page counts only its compressed size. Use this figure for memory budgets.
    primaryResidentBytes :: Word64,
    -- | @primary_compressed_pages@: Number of the primary screen\'s pages that are compressed.
    primaryCompressedPages :: Word64,
    -- | @primary_compressed_bytes@: Bytes of compressed data held for the primary screen\'s compressed pages. This is already included in @primary_resident_bytes@.
    primaryCompressedBytes :: Word64,
    -- | @primary_image_bytes@: Bytes of image data stored for the primary screen through the Kitty graphics protocol. This is not included in @primary_resident_bytes@. Always zero when libghostty-vt is built without Kitty graphics.
    primaryImageBytes :: Word64,
    -- | @alternate_pages@: The same as @primary_pages@, for the alternate screen.
    alternatePages :: Word64,
    -- | @alternate_virtual_bytes@: The same as @primary_virtual_bytes@, for the alternate screen.
    alternateVirtualBytes :: Word64,
    -- | @alternate_resident_bytes@: The same as @primary_resident_bytes@, for the alternate screen.
    alternateResidentBytes :: Word64,
    -- | @alternate_compressed_pages@: The same as @primary_compressed_pages@, for the alternate screen.
    alternateCompressedPages :: Word64,
    -- | @alternate_compressed_bytes@: The same as @primary_compressed_bytes@, for the alternate screen.
    alternateCompressedBytes :: Word64,
    -- | @alternate_image_bytes@: The same as @primary_image_bytes@, for the alternate screen.
    alternateImageBytes :: Word64
  }
  deriving stock (Eq, Show)

instance Storable GhosttyTerminalMemoryUsage where
  sizeOf _ = (#size GhosttyTerminalMemoryUsage)
  alignment _ = (#alignment GhosttyTerminalMemoryUsage)
  peek p =
    GhosttyTerminalMemoryUsage
      <$> (#peek GhosttyTerminalMemoryUsage, size) p
      <*> (#peek GhosttyTerminalMemoryUsage, compression_supported) p
      <*> (#peek GhosttyTerminalMemoryUsage, primary_pages) p
      <*> (#peek GhosttyTerminalMemoryUsage, primary_virtual_bytes) p
      <*> (#peek GhosttyTerminalMemoryUsage, primary_resident_bytes) p
      <*> (#peek GhosttyTerminalMemoryUsage, primary_compressed_pages) p
      <*> (#peek GhosttyTerminalMemoryUsage, primary_compressed_bytes) p
      <*> (#peek GhosttyTerminalMemoryUsage, primary_image_bytes) p
      <*> (#peek GhosttyTerminalMemoryUsage, alternate_pages) p
      <*> (#peek GhosttyTerminalMemoryUsage, alternate_virtual_bytes) p
      <*> (#peek GhosttyTerminalMemoryUsage, alternate_resident_bytes) p
      <*> (#peek GhosttyTerminalMemoryUsage, alternate_compressed_pages) p
      <*> (#peek GhosttyTerminalMemoryUsage, alternate_compressed_bytes) p
      <*> (#peek GhosttyTerminalMemoryUsage, alternate_image_bytes) p
  poke p s = do
    (#poke GhosttyTerminalMemoryUsage, size) p s.size
    (#poke GhosttyTerminalMemoryUsage, compression_supported) p s.compressionSupported
    (#poke GhosttyTerminalMemoryUsage, primary_pages) p s.primaryPages
    (#poke GhosttyTerminalMemoryUsage, primary_virtual_bytes) p s.primaryVirtualBytes
    (#poke GhosttyTerminalMemoryUsage, primary_resident_bytes) p s.primaryResidentBytes
    (#poke GhosttyTerminalMemoryUsage, primary_compressed_pages) p s.primaryCompressedPages
    (#poke GhosttyTerminalMemoryUsage, primary_compressed_bytes) p s.primaryCompressedBytes
    (#poke GhosttyTerminalMemoryUsage, primary_image_bytes) p s.primaryImageBytes
    (#poke GhosttyTerminalMemoryUsage, alternate_pages) p s.alternatePages
    (#poke GhosttyTerminalMemoryUsage, alternate_virtual_bytes) p s.alternateVirtualBytes
    (#poke GhosttyTerminalMemoryUsage, alternate_resident_bytes) p s.alternateResidentBytes
    (#poke GhosttyTerminalMemoryUsage, alternate_compressed_pages) p s.alternateCompressedPages
    (#poke GhosttyTerminalMemoryUsage, alternate_compressed_bytes) p s.alternateCompressedBytes
    (#poke GhosttyTerminalMemoryUsage, alternate_image_bytes) p s.alternateImageBytes

-- | The layout of @GhosttyTerminalMemoryUsage@ as compiled, for the layout test (§3.4).
ghosttyTerminalMemoryUsageLayout :: CStruct
ghosttyTerminalMemoryUsageLayout =
  CStruct
    { name = "GhosttyTerminalMemoryUsage",
      size = (#size GhosttyTerminalMemoryUsage),
      align = (#alignment GhosttyTerminalMemoryUsage),
      fields =
        [ CField "size" (#offset GhosttyTerminalMemoryUsage, size) (#const GVTFFI_FIELD_SIZE(GhosttyTerminalMemoryUsage, size)),
          CField "compression_supported" (#offset GhosttyTerminalMemoryUsage, compression_supported) (#const GVTFFI_FIELD_SIZE(GhosttyTerminalMemoryUsage, compression_supported)),
          CField "primary_pages" (#offset GhosttyTerminalMemoryUsage, primary_pages) (#const GVTFFI_FIELD_SIZE(GhosttyTerminalMemoryUsage, primary_pages)),
          CField "primary_virtual_bytes" (#offset GhosttyTerminalMemoryUsage, primary_virtual_bytes) (#const GVTFFI_FIELD_SIZE(GhosttyTerminalMemoryUsage, primary_virtual_bytes)),
          CField "primary_resident_bytes" (#offset GhosttyTerminalMemoryUsage, primary_resident_bytes) (#const GVTFFI_FIELD_SIZE(GhosttyTerminalMemoryUsage, primary_resident_bytes)),
          CField "primary_compressed_pages" (#offset GhosttyTerminalMemoryUsage, primary_compressed_pages) (#const GVTFFI_FIELD_SIZE(GhosttyTerminalMemoryUsage, primary_compressed_pages)),
          CField "primary_compressed_bytes" (#offset GhosttyTerminalMemoryUsage, primary_compressed_bytes) (#const GVTFFI_FIELD_SIZE(GhosttyTerminalMemoryUsage, primary_compressed_bytes)),
          CField "primary_image_bytes" (#offset GhosttyTerminalMemoryUsage, primary_image_bytes) (#const GVTFFI_FIELD_SIZE(GhosttyTerminalMemoryUsage, primary_image_bytes)),
          CField "alternate_pages" (#offset GhosttyTerminalMemoryUsage, alternate_pages) (#const GVTFFI_FIELD_SIZE(GhosttyTerminalMemoryUsage, alternate_pages)),
          CField "alternate_virtual_bytes" (#offset GhosttyTerminalMemoryUsage, alternate_virtual_bytes) (#const GVTFFI_FIELD_SIZE(GhosttyTerminalMemoryUsage, alternate_virtual_bytes)),
          CField "alternate_resident_bytes" (#offset GhosttyTerminalMemoryUsage, alternate_resident_bytes) (#const GVTFFI_FIELD_SIZE(GhosttyTerminalMemoryUsage, alternate_resident_bytes)),
          CField "alternate_compressed_pages" (#offset GhosttyTerminalMemoryUsage, alternate_compressed_pages) (#const GVTFFI_FIELD_SIZE(GhosttyTerminalMemoryUsage, alternate_compressed_pages)),
          CField "alternate_compressed_bytes" (#offset GhosttyTerminalMemoryUsage, alternate_compressed_bytes) (#const GVTFFI_FIELD_SIZE(GhosttyTerminalMemoryUsage, alternate_compressed_bytes)),
          CField "alternate_image_bytes" (#offset GhosttyTerminalMemoryUsage, alternate_image_bytes) (#const GVTFFI_FIELD_SIZE(GhosttyTerminalMemoryUsage, alternate_image_bytes))
        ]
    }

-- | @GhosttyTerminalModeConfig@: A terminal mode and boolean value used for mode configuration and queries.
data GhosttyTerminalModeConfig = GhosttyTerminalModeConfig
  { -- | @mode@: Mode to configure or query.
    mode :: GhosttyMode,
    -- | @value@: Value to set, or the current value returned by a query.
    value :: CBool
  }
  deriving stock (Eq, Show)

instance Storable GhosttyTerminalModeConfig where
  sizeOf _ = (#size GhosttyTerminalModeConfig)
  alignment _ = (#alignment GhosttyTerminalModeConfig)
  peek p =
    GhosttyTerminalModeConfig
      <$> (#peek GhosttyTerminalModeConfig, mode) p
      <*> (#peek GhosttyTerminalModeConfig, value) p
  poke p s = do
    (#poke GhosttyTerminalModeConfig, mode) p s.mode
    (#poke GhosttyTerminalModeConfig, value) p s.value

-- | The layout of @GhosttyTerminalModeConfig@ as compiled, for the layout test (§3.4).
ghosttyTerminalModeConfigLayout :: CStruct
ghosttyTerminalModeConfigLayout =
  CStruct
    { name = "GhosttyTerminalModeConfig",
      size = (#size GhosttyTerminalModeConfig),
      align = (#alignment GhosttyTerminalModeConfig),
      fields =
        [ CField "mode" (#offset GhosttyTerminalModeConfig, mode) (#const GVTFFI_FIELD_SIZE(GhosttyTerminalModeConfig, mode)),
          CField "value" (#offset GhosttyTerminalModeConfig, value) (#const GVTFFI_FIELD_SIZE(GhosttyTerminalModeConfig, value))
        ]
    }

-- * VT input

-- | @ghostty_terminal_vt_write@: feed bytes through the VT parser. Never
-- fails. Callbacks must not write to the same terminal. @safe@: it runs the
-- terminal's callbacks.
foreign import capi safe "ghostty/vt.h ghostty_terminal_vt_write"
  ghosttyTerminalVtWrite :: GhosttyTerminal -> Ptr Word8 -> CSize -> IO ()

-- | @ghostty_terminal_vt_write_until@: feed bytes, stopping right after the
-- first that reaches one of the 'GhosttyTerminalBoundary' flags (or'd
-- together). @GHOSTTY_NO_VALUE@ when every byte was consumed without one.
-- The stop's @size@ must be set. @safe@: it runs the terminal's callbacks.
foreign import capi safe "ghostty/vt.h ghostty_terminal_vt_write_until"
  ghosttyTerminalVtWriteUntil :: GhosttyTerminal -> Ptr Word8 -> CSize -> Word32 -> Ptr GhosttyTerminalWriteStop -> IO GhosttyResult

-- | @GhosttyTerminalBoundary@: A point in the VT stream where ghostty\_terminal\_vt\_write\_until() can stop.
newtype GhosttyTerminalBoundary = GhosttyTerminalBoundary CInt
  deriving stock (Eq, Show)
  deriving newtype (Storable)

-- | @GHOSTTY_TERMINAL_BOUNDARY_GROUND@: The stream is not inside any escape sequence or partial UTF-8 character. This is a safe point to insert your own sequences.
pattern GhosttyTerminalBoundaryGround :: GhosttyTerminalBoundary
pattern GhosttyTerminalBoundaryGround = GhosttyTerminalBoundary (#const GHOSTTY_TERMINAL_BOUNDARY_GROUND)

-- | @GHOSTTY_TERMINAL_BOUNDARY_APC_START@: The byte that started an APC string: @_@ after ESC, or 0x9F.
pattern GhosttyTerminalBoundaryApcStart :: GhosttyTerminalBoundary
pattern GhosttyTerminalBoundaryApcStart = GhosttyTerminalBoundary (#const GHOSTTY_TERMINAL_BOUNDARY_APC_START)

-- | @GHOSTTY_TERMINAL_BOUNDARY_APC_END@: The byte that ended an APC, SOS or PM string.
pattern GhosttyTerminalBoundaryApcEnd :: GhosttyTerminalBoundary
pattern GhosttyTerminalBoundaryApcEnd = GhosttyTerminalBoundary (#const GHOSTTY_TERMINAL_BOUNDARY_APC_END)

-- | @GHOSTTY_TERMINAL_BOUNDARY_DCS_START@: The byte that started a DCS string: @P@ after ESC, or 0x90.
pattern GhosttyTerminalBoundaryDcsStart :: GhosttyTerminalBoundary
pattern GhosttyTerminalBoundaryDcsStart = GhosttyTerminalBoundary (#const GHOSTTY_TERMINAL_BOUNDARY_DCS_START)

-- | @GHOSTTY_TERMINAL_BOUNDARY_DCS_END@: The byte that ended a DCS string, whether it was still in its header or already in its payload. A DCS cut short in its header reports this without ever having had a payload.
pattern GhosttyTerminalBoundaryDcsEnd :: GhosttyTerminalBoundary
pattern GhosttyTerminalBoundaryDcsEnd = GhosttyTerminalBoundary (#const GHOSTTY_TERMINAL_BOUNDARY_DCS_END)

-- | @GHOSTTY_TERMINAL_BOUNDARY_OSC_START@: The byte that started an OSC string: @]@ after ESC, or 0x9D.
pattern GhosttyTerminalBoundaryOscStart :: GhosttyTerminalBoundary
pattern GhosttyTerminalBoundaryOscStart = GhosttyTerminalBoundary (#const GHOSTTY_TERMINAL_BOUNDARY_OSC_START)

-- | @GHOSTTY_TERMINAL_BOUNDARY_OSC_END@: The byte that ended an OSC string. This is reported for every OSC, including ones the terminal does not understand.
pattern GhosttyTerminalBoundaryOscEnd :: GhosttyTerminalBoundary
pattern GhosttyTerminalBoundaryOscEnd = GhosttyTerminalBoundary (#const GHOSTTY_TERMINAL_BOUNDARY_OSC_END)

-- | Any value this binding does not name: a newer library's.
pattern GhosttyTerminalBoundaryUnknown :: CInt -> GhosttyTerminalBoundary
pattern GhosttyTerminalBoundaryUnknown n <- GhosttyTerminalBoundary (unnamed ghosttyTerminalBoundaryEnum -> Just n)
  where
    GhosttyTerminalBoundaryUnknown n = GhosttyTerminalBoundary n

