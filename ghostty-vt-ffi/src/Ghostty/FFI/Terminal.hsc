  GhosttyTerminalBoundaryGround,
  GhosttyTerminalBoundaryApcStart,
  GhosttyTerminalBoundaryApcEnd,
  GhosttyTerminalBoundaryDcsStart,
  GhosttyTerminalBoundaryDcsEnd,
  GhosttyTerminalBoundaryOscStart,
  GhosttyTerminalBoundaryOscEnd,
  GhosttyTerminalBoundaryUnknown
  #-}

-- | Every value of @GhosttyTerminalBoundary@, for the layout test (§3.4). It is also what
-- 'GhosttyTerminalBoundaryUnknown' excludes.
ghosttyTerminalBoundaryEnum :: CEnum
ghosttyTerminalBoundaryEnum =
  CEnum
    { name = "GhosttyTerminalBoundary",
      size = (#size GhosttyTerminalBoundary),
      values =
        [ ("GHOSTTY_TERMINAL_BOUNDARY_GROUND", (#const GHOSTTY_TERMINAL_BOUNDARY_GROUND)),
          ("GHOSTTY_TERMINAL_BOUNDARY_APC_START", (#const GHOSTTY_TERMINAL_BOUNDARY_APC_START)),
          ("GHOSTTY_TERMINAL_BOUNDARY_APC_END", (#const GHOSTTY_TERMINAL_BOUNDARY_APC_END)),
          ("GHOSTTY_TERMINAL_BOUNDARY_DCS_START", (#const GHOSTTY_TERMINAL_BOUNDARY_DCS_START)),
          ("GHOSTTY_TERMINAL_BOUNDARY_DCS_END", (#const GHOSTTY_TERMINAL_BOUNDARY_DCS_END)),
          ("GHOSTTY_TERMINAL_BOUNDARY_OSC_START", (#const GHOSTTY_TERMINAL_BOUNDARY_OSC_START)),
          ("GHOSTTY_TERMINAL_BOUNDARY_OSC_END", (#const GHOSTTY_TERMINAL_BOUNDARY_OSC_END))
        ]
    }

-- | @GhosttyTerminalStringKind@: The kind of control string that started or ended.
newtype GhosttyTerminalStringKind = GhosttyTerminalStringKind CInt
  deriving stock (Eq, Show)
  deriving newtype (Storable)

-- | @GHOSTTY_TERMINAL_STRING_KIND_APC@: An APC, SOS or PM string. GhosttyTerminalWriteStop.byte at the start of the string tells you which one it is:
pattern GhosttyTerminalStringKindApc :: GhosttyTerminalStringKind
pattern GhosttyTerminalStringKindApc = GhosttyTerminalStringKind (#const GHOSTTY_TERMINAL_STRING_KIND_APC)

-- | @GHOSTTY_TERMINAL_STRING_KIND_DCS@: A DCS string, started by @P@ (0x50) after ESC or by 0x90.
pattern GhosttyTerminalStringKindDcs :: GhosttyTerminalStringKind
pattern GhosttyTerminalStringKindDcs = GhosttyTerminalStringKind (#const GHOSTTY_TERMINAL_STRING_KIND_DCS)

-- | @GHOSTTY_TERMINAL_STRING_KIND_OSC@: An OSC string, started by @]@ (0x5D) after ESC or by 0x9D.
pattern GhosttyTerminalStringKindOsc :: GhosttyTerminalStringKind
pattern GhosttyTerminalStringKindOsc = GhosttyTerminalStringKind (#const GHOSTTY_TERMINAL_STRING_KIND_OSC)

-- | Any value this binding does not name: a newer library's.
pattern GhosttyTerminalStringKindUnknown :: CInt -> GhosttyTerminalStringKind
pattern GhosttyTerminalStringKindUnknown n <- GhosttyTerminalStringKind (unnamed ghosttyTerminalStringKindEnum -> Just n)
  where
    GhosttyTerminalStringKindUnknown n = GhosttyTerminalStringKind n

