{-# LANGUAGE CApiFFI #-}
{-# LANGUAGE PatternSynonyms #-}
{-# LANGUAGE ViewPatterns #-}

-- | @include/ghostty/vt/key/encoder.h@: encoding a key event
-- ("Ghostty.FFI.Key.Event") as the bytes a terminal program reads, in the
-- legacy encodings or the Kitty keyboard protocol, as the encoder's options
-- (or a terminal's modes) say.
--
-- Every call here is @unsafe@: none calls back into Haskell, and an encode
-- writes one short sequence.
module Ghostty.FFI.Key.Encoder
  ( -- * Handles
    GhosttyKeyEncoder (..),
    GhosttyKeyEncoderImpl,

    -- * Kitty keyboard flags
    GhosttyKittyKeyFlags,
    {{xdefines key/encoder.h GhosttyKittyKeyFlags GHOSTTY_KITTY_KEY_}}

    -- * Options
    {{xenum key/encoder.h GhosttyOptionAsAlt}}
    {{xenum key/encoder.h GhosttyKeyEncoderOption}}

    -- * Encoders
    ghosttyKeyEncoderNew,
    ghosttyKeyEncoderFree,
    ghosttyKeyEncoderSetopt,
    ghosttyKeyEncoderSetoptFromTerminal,
    ghosttyKeyEncoderEncode,
  )
where

import Foreign.C.Types (CChar, CInt (..), CSize (..))
import Foreign.Ptr (Ptr)
import Foreign.Storable (Storable (..))
import Ghostty.FFI.Allocator (GhosttyAllocator)
import Ghostty.FFI.Key.Event (GhosttyKeyEvent (..))
import Ghostty.FFI.Layout (CEnum (..), unnamed)
import Ghostty.FFI.Terminal.Handle (GhosttyTerminal (..))
import Ghostty.FFI.Types (GhosttyResult (..))

#include <gvtffi_shims.h>

-- * Handles

-- | The C side of a 'GhosttyKeyEncoder'. Never dereferenced.
data GhosttyKeyEncoderImpl

-- | @GhosttyKeyEncoder@: a key encoder, from 'ghosttyKeyEncoderNew' and
-- released by 'ghosttyKeyEncoderFree'.
newtype GhosttyKeyEncoder = GhosttyKeyEncoder (Ptr GhosttyKeyEncoderImpl)
  deriving stock (Eq, Show)
  deriving newtype (Storable)

-- * Kitty keyboard flags

-- | @GhosttyKittyKeyFlags@: the Kitty keyboard protocol's progressive
-- enhancement flags, a bit set of the @GHOSTTY_KITTY_KEY_*@ values below. A
-- terminal reports its own through @GHOSTTY_TERMINAL_DATA_KITTY_KEYBOARD_FLAGS@.
type GhosttyKittyKeyFlags = Word8

{{defines key/encoder.h GhosttyKittyKeyFlags GHOSTTY_KITTY_KEY_}}
-- * Options

{{enum key/encoder.h GhosttyOptionAsAlt}}
{{enum key/encoder.h GhosttyKeyEncoderOption}}
-- * Encoders

-- | @ghostty_key_encoder_new@: an encoder with default options, with the
-- allocator (null for the default). @unsafe@: it does not call back into
-- Haskell.
foreign import capi unsafe "ghostty/vt.h ghostty_key_encoder_new"
  ghosttyKeyEncoderNew :: Ptr GhosttyAllocator -> Ptr GhosttyKeyEncoder -> IO GhosttyResult

-- | @ghostty_key_encoder_free@ (null is a no-op). @unsafe@: it does not call
-- back into Haskell.
foreign import capi unsafe "ghostty/vt.h ghostty_key_encoder_free"
  ghosttyKeyEncoderFree :: GhosttyKeyEncoder -> IO ()

-- | @ghostty_key_encoder_setopt@: set an option, the value's type depending
-- on the option ('GhosttyKeyEncoderOption' says which). A null value does
-- nothing; it does not restore the default. @unsafe@: it does not call back
-- into Haskell.
foreign import capi unsafe "ghostty/vt.h ghostty_key_encoder_setopt"
  ghosttyKeyEncoderSetopt :: GhosttyKeyEncoder -> GhosttyKeyEncoderOption -> Ptr () -> IO ()

-- | @ghostty_key_encoder_setopt_from_terminal@: set every option a terminal's
-- modes and flags decide (cursor and keypad application modes, alt's escape
-- prefix, modifyOtherKeys, the Kitty flags), and reset
-- @GHOSTTY_KEY_ENCODER_OPT_MACOS_OPTION_AS_ALT@, which no terminal state
-- decides. @unsafe@: it reads the terminal and calls nothing back.
foreign import capi unsafe "ghostty/vt.h ghostty_key_encoder_setopt_from_terminal"
  ghosttyKeyEncoderSetoptFromTerminal :: GhosttyKeyEncoder -> GhosttyTerminal -> IO ()

-- | @ghostty_key_encoder_encode@: encode an event into a buffer. Some events
-- encode to nothing (a bare modifier, say). A null buffer, or one too small,
-- returns @GHOSTTY_OUT_OF_SPACE@ with the size needed. @unsafe@: it does not
-- call back into Haskell.
foreign import capi unsafe "ghostty/vt.h ghostty_key_encoder_encode"
  ghosttyKeyEncoderEncode :: GhosttyKeyEncoder -> GhosttyKeyEvent -> Ptr CChar -> CSize -> Ptr CSize -> IO GhosttyResult
