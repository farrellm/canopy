{-# LANGUAGE CApiFFI #-}
{-# LANGUAGE DuplicateRecordFields #-}
{-# LANGUAGE PatternSynonyms #-}
{-# LANGUAGE ViewPatterns #-}

-- | @include/ghostty/vt/mouse/event.h@: a mouse event, the input to the mouse
-- encoder ("Ghostty.FFI.Mouse.Encoder"). An event is a mutable handle, set
-- field by field and reusable across encodes.
--
-- Every call here is @unsafe@: none calls back into Haskell, and each is a
-- field read or write.
module Ghostty.FFI.Mouse.Event
  ( -- * Handles
    GhosttyMouseEvent (..),
    GhosttyMouseEventImpl,

    -- * Actions and buttons
    {{xenum mouse/event.h GhosttyMouseAction}}
    {{xenum mouse/event.h GhosttyMouseButton}}

    -- * Positions
    {{xstruct mouse/event.h GhosttyMousePosition}}

    -- * Events
    ghosttyMouseEventNew,
    ghosttyMouseEventFree,
    ghosttyMouseEventSetAction,
    ghosttyMouseEventGetAction,
    ghosttyMouseEventSetButton,
    ghosttyMouseEventClearButton,
    ghosttyMouseEventGetButton,
    ghosttyMouseEventSetMods,
    ghosttyMouseEventGetMods,
    ghosttyMouseEventSetPosition,
    ghosttyMouseEventGetPosition,
  )
where

import Foreign.C.Types (CBool (..), CFloat (..), CInt (..))
import Foreign.Ptr (Ptr)
import Foreign.Storable (Storable (..))
import Ghostty.FFI.Allocator (GhosttyAllocator)
import Ghostty.FFI.Key.Event (GhosttyMods)
import Ghostty.FFI.Layout (CEnum (..), CField (..), CStruct (..), unnamed)
import Ghostty.FFI.Types (GhosttyResult (..))

#include <gvtffi_shims.h>

-- * Handles

-- | The C side of a 'GhosttyMouseEvent'. Never dereferenced.
data GhosttyMouseEventImpl

-- | @GhosttyMouseEvent@: a mouse event, from 'ghosttyMouseEventNew' and
-- released by 'ghosttyMouseEventFree'.
newtype GhosttyMouseEvent = GhosttyMouseEvent (Ptr GhosttyMouseEventImpl)
  deriving stock (Eq, Show)
  deriving newtype (Storable)

-- * Actions and buttons

{{enum mouse/event.h GhosttyMouseAction}}
{{enum mouse/event.h GhosttyMouseButton}}
-- * Positions

{{struct mouse/event.h GhosttyMousePosition}}
-- * Events

-- | @ghostty_mouse_event_new@: a mouse event, with the allocator (null for the
-- default). @unsafe@: it does not call back into Haskell.
foreign import capi unsafe "ghostty/vt.h ghostty_mouse_event_new"
  ghosttyMouseEventNew :: Ptr GhosttyAllocator -> Ptr GhosttyMouseEvent -> IO GhosttyResult

-- | @ghostty_mouse_event_free@ (null is a no-op). @unsafe@: it does not call
-- back into Haskell.
foreign import capi unsafe "ghostty/vt.h ghostty_mouse_event_free"
  ghosttyMouseEventFree :: GhosttyMouseEvent -> IO ()

-- | @ghostty_mouse_event_set_action@: press, release or motion. @unsafe@: it
-- does not call back into Haskell.
foreign import capi unsafe "ghostty/vt.h ghostty_mouse_event_set_action"
  ghosttyMouseEventSetAction :: GhosttyMouseEvent -> GhosttyMouseAction -> IO ()

-- | @ghostty_mouse_event_get_action@. @unsafe@: it does not call back into
-- Haskell.
foreign import capi unsafe "ghostty/vt.h ghostty_mouse_event_get_action"
  ghosttyMouseEventGetAction :: GhosttyMouseEvent -> IO GhosttyMouseAction

-- | @ghostty_mouse_event_set_button@: the button. A motion with no button
-- clears it instead ('ghosttyMouseEventClearButton'). @unsafe@: it does not
-- call back into Haskell.
foreign import capi unsafe "ghostty/vt.h ghostty_mouse_event_set_button"
  ghosttyMouseEventSetButton :: GhosttyMouseEvent -> GhosttyMouseButton -> IO ()

-- | @ghostty_mouse_event_clear_button@: no button. @unsafe@: it does not call
-- back into Haskell.
foreign import capi unsafe "ghostty/vt.h ghostty_mouse_event_clear_button"
  ghosttyMouseEventClearButton :: GhosttyMouseEvent -> IO ()

-- | @ghostty_mouse_event_get_button@: whether a button is set, and which
-- through the out pointer (which may be null). @unsafe@: it does not call
-- back into Haskell.
foreign import capi unsafe "ghostty/vt.h ghostty_mouse_event_get_button"
  ghosttyMouseEventGetButton :: GhosttyMouseEvent -> Ptr GhosttyMouseButton -> IO CBool

-- | @ghostty_mouse_event_set_mods@: the modifiers held. @unsafe@: it does not
-- call back into Haskell.
foreign import capi unsafe "ghostty/vt.h ghostty_mouse_event_set_mods"
  ghosttyMouseEventSetMods :: GhosttyMouseEvent -> GhosttyMods -> IO ()

-- | @ghostty_mouse_event_get_mods@. @unsafe@: it does not call back into
-- Haskell.
foreign import capi unsafe "ghostty/vt.h ghostty_mouse_event_get_mods"
  ghosttyMouseEventGetMods :: GhosttyMouseEvent -> IO GhosttyMods

-- | @ghostty_mouse_event_set_position@: the position in surface pixels. The C
-- function takes the position by value, so this calls a pointer shim
-- (@gvtffi_shims.h@, §3.3). @unsafe@: it does not call back into Haskell.
foreign import capi unsafe "gvtffi_shims.h gvtffi_mouse_event_set_position"
  ghosttyMouseEventSetPosition :: GhosttyMouseEvent -> Ptr GhosttyMousePosition -> IO ()

-- | @ghostty_mouse_event_get_position@. The C function returns the position by
-- value, so this calls a pointer shim that writes it through the out pointer
-- (@gvtffi_shims.h@, §3.3). @unsafe@: it does not call back into Haskell.
foreign import capi unsafe "gvtffi_shims.h gvtffi_mouse_event_get_position"
  ghosttyMouseEventGetPosition :: GhosttyMouseEvent -> Ptr GhosttyMousePosition -> IO ()
