{-# LANGUAGE CApiFFI #-}
{-# LANGUAGE DuplicateRecordFields #-}
{-# LANGUAGE PatternSynonyms #-}
{-# LANGUAGE ViewPatterns #-}

-- | Types shared by every libghostty-vt header (@include/ghostty/vt/types.h@,
-- DESIGN.md §3.2): the result code, borrowed strings and codepoint lists,
-- caller buffers, surface positions, the formatter's output format, and the
-- cursor shape and image layer that @terminal.h@ and @render.h@ share.
--
-- The header's opaque handles are bound in the module of the header that
-- uses each: @GhosttyRenderState@ in "Ghostty.FFI.Render",
-- and so on. Those of the parsers, kitty graphics, search and snapshots arrive
-- with the steps that bind them.
--
-- C enums are open, so each is a newtype over the C integer with pattern
-- synonyms and an @Unknown@ view (§3.3).
module Ghostty.FFI.Types
  ( -- * Results
    {{xenum types.h GhosttyResult}}

    -- * Strings
    GhosttyString (..),
    ghosttyStringBytes,
    ghosttyStringLayout,
    {{xstruct types.h GhosttyCodepoints}}

    -- * Buffers
    {{xstruct types.h GhosttyBuffer}}
    {{xstruct types.h GhosttyCodepointBuffer}}

    -- * Surface positions
    {{xstruct types.h GhosttySurfacePosition}}

    -- * Formatter output
    {{xenum types.h GhosttyFormatterFormat}}

    -- * Cursor shapes
    {{xenum types.h GhosttyCursorStyle}}

    -- * Image layers
    {{xenum types.h GhosttyImageLayer}}
    {{xdefines types.h Word32 GHOSTTY_IMAGE_LAYER_MASK_}}

    -- * Type manifest
    ghosttyTypeJson,
  )
where

import Data.ByteString qualified as BS
import Foreign.C.ConstPtr (ConstPtr (..))
import Foreign.C.Types (CChar, CDouble (..), CInt (..), CSize (..))
import Foreign.Ptr (Ptr, castPtr, nullPtr)
import Foreign.Storable (Storable (..))
import Ghostty.FFI.Layout (CEnum (..), CField (..), CStruct (..), unnamed)

#include <gvtffi_shims.h>

{{enum types.h GhosttyResult}}
-- | @GhosttyString@: a borrowed byte string. The pointer's lifetime is the
-- producing call's to document.
data GhosttyString = GhosttyString
  { -- | @ptr@: the bytes.
    ptr :: Ptr Word8,
    -- | @len@: their count.
    len :: CSize
  }
  deriving stock (Eq, Show)

instance Storable GhosttyString where
  sizeOf _ = (#size GhosttyString)
  alignment _ = (#alignment GhosttyString)
  peek p =
    GhosttyString
      <$> (#peek GhosttyString, ptr) p
      <*> (#peek GhosttyString, len) p
  poke p s = do
    (#poke GhosttyString, ptr) p s.ptr
    (#poke GhosttyString, len) p s.len

-- | Copy a borrowed string's bytes out, while the pointer is still valid. A
-- null pointer is the empty string, whatever its length says. The one
-- marshalling helper this package has (DESIGN.md §3.3): every reader of a
-- 'GhosttyString' goes through it.
ghosttyStringBytes :: GhosttyString -> IO ByteString
ghosttyStringBytes s
  | s.ptr == nullPtr = pure BS.empty
  | otherwise = BS.packCStringLen (castPtr s.ptr, fromIntegral s.len)

-- | The layout of @GhosttyString@ as compiled, for the layout test (§3.4).
ghosttyStringLayout :: CStruct
ghosttyStringLayout =
  CStruct
    { name = "GhosttyString",
      size = (#size GhosttyString),
      align = (#alignment GhosttyString),
      fields =
        [ CField "ptr" (#offset GhosttyString, ptr) (#const GVTFFI_FIELD_SIZE(GhosttyString, ptr)),
          CField "len" (#offset GhosttyString, len) (#const GVTFFI_FIELD_SIZE(GhosttyString, len))
        ]
    }

{{struct types.h GhosttyCodepoints}}
{{struct types.h GhosttyBuffer}}
{{struct types.h GhosttyCodepointBuffer}}
{{struct types.h GhosttySurfacePosition}}
{{enum types.h GhosttyFormatterFormat}}
{{enum types.h GhosttyCursorStyle}}
{{enum types.h GhosttyImageLayer}}
{{defines types.h Word32 GHOSTTY_IMAGE_LAYER_MASK_}}
-- | @ghostty_type_json@: the linked library's description of every public
-- type (sizes, alignments, field offsets, enum values), as a static
-- NUL-terminated JSON string valid for the life of the process. What the
-- layout test checks the binding against (§3.4). @unsafe@: it does not call
-- back into Haskell.
foreign import capi unsafe "ghostty/vt.h ghostty_type_json"
  ghosttyTypeJson :: IO (ConstPtr CChar)
