{-# LANGUAGE CApiFFI #-}
{-# LANGUAGE DuplicateRecordFields #-}
{-# LANGUAGE PatternSynonyms #-}
{-# LANGUAGE ViewPatterns #-}

-- | @include/ghostty/vt/terminal.h@: the terminal emulator, its keyed options
-- and data, VT input, the viewport, and grid references into it. The
-- callbacks ("effects") are in "Ghostty.FFI.Terminal.Callbacks".
--
-- The type behind each 'GhosttyTerminalOption' and 'GhosttyTerminalData' key
-- is documented on its pattern, as the header documents it on the enum value.
-- Nothing checks it: that is @ghostty-effectful@'s typed keys (§4.4).
--
-- __@safe@ and @unsafe@.__ Every call that can run a callback is @safe@, so
-- that a callback made with a @wrapper@ may re-enter Haskell: the two VT
-- writes; 'ghosttyTerminalReset' and 'ghosttyTerminalResize', which end a
-- render hold through its callback and (resize) send an in-band size report;
-- 'ghosttyTerminalSet', because the header does not rule out an option whose
-- setting reports through a callback; and 'ghosttyTerminalContinuationWrite',
-- which calls its writer. 'ghosttyTerminalCompress' is @safe@ for another
-- reason: a full pass can stall, and an @unsafe@ call would hold up every
-- other Haskell thread at the next garbage collection. The rest are @unsafe@.
module Ghostty.FFI.Terminal
  ( -- * Handles
    GhosttyTerminal (..),
    GhosttyTerminalImpl,

    -- * Lifecycle
    ghosttyTerminalNew,
    ghosttyTerminalFree,
    ghosttyTerminalReset,
    ghosttyTerminalResize,

    -- * Options
    {{xenum terminal.h GhosttyTerminalOption}}
    ghosttyTerminalSet,

    -- * Data
    {{xenum terminal.h GhosttyTerminalData}}
    ghosttyTerminalGet,
    ghosttyTerminalGetMulti,
    {{xenum terminal.h GhosttyTerminalScreen}}
    {{xstruct terminal.h GhosttyTerminalScrollbar}}
    {{xstruct terminal.h GhosttyTerminalMemoryUsage}}
    {{xstruct terminal.h GhosttyTerminalModeConfig}}

    -- * VT input
    ghosttyTerminalVtWrite,
    ghosttyTerminalVtWriteUntil,
    {{xenum terminal.h GhosttyTerminalBoundary}}
    {{xenum terminal.h GhosttyTerminalStringKind}}
    {{xenum terminal.h GhosttyTerminalStringIntroducer}}
    {{xenum terminal.h GhosttyTerminalStringEnd}}
    {{xstruct terminal.h GhosttyTerminalWriteStop}}

    -- * Continuations
    ghosttyTerminalContinuationWrite,
    ghosttyTerminalContinuationBuf,
    ghosttyTerminalContinuationAlloc,

    -- * Viewport
    {{xenum terminal.h GhosttyTerminalScrollViewportTag}}
    GhosttyTerminalScrollViewport (..),
    ghosttyTerminalScrollViewportLayout,
    ghosttyTerminalScrollViewport,

    -- * Compression
    {{xenum terminal.h GhosttyTerminalCompressionMode}}
    {{xenum terminal.h GhosttyTerminalCompressionResult}}
    ghosttyTerminalCompressionActivity,
    ghosttyTerminalCompress,

    -- * Grid references
    ghosttyTerminalGridRef,
    ghosttyTerminalGridRefTrack,
    ghosttyTerminalPointFromGridRef,
  )
where

import Foreign.C.Types (CBool (..), CInt (..), CIntPtr (..), CSize (..))
import Foreign.Ptr (Ptr)
import Foreign.Storable (Storable (..))
import Ghostty.FFI.Allocator (GhosttyAllocator)
import Ghostty.FFI.GridRef (GhosttyGridRef, GhosttyTrackedGridRef (..))
import Ghostty.FFI.Io (GhosttyWriter)
import Ghostty.FFI.Layout (CEnum (..), CField (..), CStruct (..), unnamed)
import Ghostty.FFI.Modes (GhosttyMode)
import Ghostty.FFI.Point (GhosttyPoint, GhosttyPointCoordinate, GhosttyPointTag (..))
import Ghostty.FFI.Terminal.Handle (GhosttyTerminal (..), GhosttyTerminalImpl)
import Ghostty.FFI.Types (GhosttyResult (..))

#include <gvtffi_shims.h>

-- * Lifecycle

-- | @ghostty_terminal_new@: a terminal of the given columns and rows (both
-- non-zero), with the allocator (null for the default). @unsafe@: it does not
-- call back into Haskell.
foreign import capi unsafe "ghostty/vt.h ghostty_terminal_new"
  ghosttyTerminalNew :: Ptr GhosttyAllocator -> Ptr GhosttyTerminal -> Word16 -> Word16 -> IO GhosttyResult

-- | @ghostty_terminal_free@ (null is a no-op). @unsafe@: it does not call back
-- into Haskell.
foreign import capi unsafe "ghostty/vt.h ghostty_terminal_free"
  ghosttyTerminalFree :: GhosttyTerminal -> IO ()

-- | @ghostty_terminal_reset@: a full reset (RIS), keeping the size. @safe@: it
-- ends a render hold through the @RENDER_HOLD@ callback.
foreign import capi safe "ghostty/vt.h ghostty_terminal_reset"
  ghosttyTerminalReset :: GhosttyTerminal -> IO ()

-- | @ghostty_terminal_resize@: columns, rows, and the cell's width and height
-- in pixels. @safe@: it ends a render hold through the @RENDER_HOLD@ callback,
-- and with mode 2048 set it reports the size through @SIZE@ and @WRITE_PTY@.
foreign import capi safe "ghostty/vt.h ghostty_terminal_resize"
  ghosttyTerminalResize :: GhosttyTerminal -> Word16 -> Word16 -> Word32 -> Word32 -> IO GhosttyResult

-- * Options

{{enumT terminal.h GhosttyTerminalOption}}
-- | @ghostty_terminal_set@: set an option. The value is the option's input
-- type: a pointer to the value, or the pointer itself for callbacks and
-- userdata; null clears. @safe@: the header does not promise that setting an
-- option never reports through a callback, and setting is not on a hot path.
foreign import capi safe "ghostty/vt.h ghostty_terminal_set"
  ghosttyTerminalSet :: GhosttyTerminal -> GhosttyTerminalOption -> Ptr () -> IO GhosttyResult

-- * Data

{{enumT terminal.h GhosttyTerminalData}}
-- | @ghostty_terminal_get@: read one key into a pointer of its output type.
-- @unsafe@: it does not call back into Haskell.
foreign import capi unsafe "ghostty/vt.h ghostty_terminal_get"
  ghosttyTerminalGet :: GhosttyTerminal -> GhosttyTerminalData -> Ptr () -> IO GhosttyResult

-- | @ghostty_terminal_get_multi@: read several keys in one call, stopping at
-- the first error; the out count is how many succeeded. @unsafe@: it does not
-- call back into Haskell.
foreign import capi unsafe "ghostty/vt.h ghostty_terminal_get_multi"
  ghosttyTerminalGetMulti :: GhosttyTerminal -> CSize -> Ptr GhosttyTerminalData -> Ptr (Ptr ()) -> Ptr CSize -> IO GhosttyResult

{{enum terminal.h GhosttyTerminalScreen}}
{{struct terminal.h GhosttyTerminalScrollbar}}
{{struct terminal.h GhosttyTerminalMemoryUsage}}
{{struct terminal.h GhosttyTerminalModeConfig}}
-- * VT input

-- | @ghostty_terminal_vt_write@: feed bytes through the VT parser. Never
-- fails. Callbacks must not write to the same terminal. @safe@: it runs the
-- terminal's callbacks.
foreign import capi safe "ghostty/vt.h ghostty_terminal_vt_write"
  ghosttyTerminalVtWrite :: GhosttyTerminal -> Ptr Word8 -> CSize -> IO ()

-- | @ghostty_terminal_vt_write_until@: feed bytes, stopping right after the
-- first that reaches one of the 'GhosttyTerminalBoundary' flags (or'd
-- together). @GHOSTTY_NO_VALUE@ when every byte was consumed without one.
-- The stop's @size@ must be set. @safe@: it runs the terminal's callbacks.
foreign import capi safe "ghostty/vt.h ghostty_terminal_vt_write_until"
  ghosttyTerminalVtWriteUntil :: GhosttyTerminal -> Ptr Word8 -> CSize -> Word32 -> Ptr GhosttyTerminalWriteStop -> IO GhosttyResult

{{enum terminal.h GhosttyTerminalBoundary}}
{{enum terminal.h GhosttyTerminalStringKind}}
{{enum terminal.h GhosttyTerminalStringIntroducer}}
{{enum terminal.h GhosttyTerminalStringEnd}}
{{struct terminal.h GhosttyTerminalWriteStop}}
-- * Continuations

-- | @ghostty_terminal_continuation_write@: write the replay-safe continuation
-- (the bytes that rebuild an unfinished sequence) to a writer. The C function
-- takes the writer by value, so this calls a pointer shim (@gvtffi_shims.h@,
-- §3.3). @safe@: it calls the writer, which may be a Haskell function.
foreign import capi safe "gvtffi_shims.h gvtffi_terminal_continuation_write"
  ghosttyTerminalContinuationWrite :: GhosttyTerminal -> Ptr GhosttyWriter -> IO GhosttyResult

-- | @ghostty_terminal_continuation_buf@: copy the continuation into a buffer;
-- @GHOSTTY_OUT_OF_SPACE@ reports the size needed. @unsafe@: it does not call
-- back into Haskell.
foreign import capi unsafe "ghostty/vt.h ghostty_terminal_continuation_buf"
  ghosttyTerminalContinuationBuf :: GhosttyTerminal -> Ptr Word8 -> CSize -> Ptr CSize -> IO GhosttyResult

-- | @ghostty_terminal_continuation_alloc@: an allocated copy of the
-- continuation, to be released with 'Ghostty.FFI.Allocator.ghosttyFree'.
-- @unsafe@: it does not call back into Haskell.
foreign import capi unsafe "ghostty/vt.h ghostty_terminal_continuation_alloc"
  ghosttyTerminalContinuationAlloc :: GhosttyTerminal -> Ptr GhosttyAllocator -> Ptr (Ptr Word8) -> Ptr CSize -> IO GhosttyResult

-- * Viewport

{{enum terminal.h GhosttyTerminalScrollViewportTag}}
-- | @GhosttyTerminalScrollViewport@: how to scroll the viewport. A tagged union
-- in C, so a sum here with an arm per tag (§3.3).
data GhosttyTerminalScrollViewport
  = -- | @GHOSTTY_TERMINAL_SCROLL_VIEWPORT_TOP@: to the top of the scrollback.
    ScrollViewportTop
  | -- | @GHOSTTY_TERMINAL_SCROLL_VIEWPORT_BOTTOM@: to the active area.
    ScrollViewportBottom
  | -- | @GHOSTTY_TERMINAL_SCROLL_VIEWPORT_DELTA@: by @value.delta@ rows, up negative.
    ScrollViewportDelta CIntPtr
  | -- | @GHOSTTY_TERMINAL_SCROLL_VIEWPORT_ROW@: to the absolute row @value.row@.
    ScrollViewportRow CSize
  | -- | @GHOSTTY_TERMINAL_SCROLL_VIEWPORT_DELTA_PROMPT@: by @value.delta_prompt@
    -- semantic prompts, back negative.
    ScrollViewportDeltaPrompt CIntPtr
  | -- | A tag this binding does not name, whose value it cannot read.
    ScrollViewportOther GhosttyTerminalScrollViewportTag
  deriving stock (Eq, Show)

instance Storable GhosttyTerminalScrollViewport where
  sizeOf _ = (#size GhosttyTerminalScrollViewport)
  alignment _ = (#alignment GhosttyTerminalScrollViewport)
  peek p =
    (#peek GhosttyTerminalScrollViewport, tag) p >>= \case
      GhosttyTerminalScrollViewportTop -> pure ScrollViewportTop
      GhosttyTerminalScrollViewportBottom -> pure ScrollViewportBottom
      GhosttyTerminalScrollViewportDelta -> ScrollViewportDelta <$> (#peek GhosttyTerminalScrollViewport, value.delta) p
      GhosttyTerminalScrollViewportRow -> ScrollViewportRow <$> (#peek GhosttyTerminalScrollViewport, value.row) p
      GhosttyTerminalScrollViewportDeltaPrompt -> ScrollViewportDeltaPrompt <$> (#peek GhosttyTerminalScrollViewport, value.delta_prompt) p
      tag@(GhosttyTerminalScrollViewportTagUnknown _) -> pure (ScrollViewportOther tag)
  poke p = \case
    ScrollViewportTop -> (#poke GhosttyTerminalScrollViewport, tag) p GhosttyTerminalScrollViewportTop
    ScrollViewportBottom -> (#poke GhosttyTerminalScrollViewport, tag) p GhosttyTerminalScrollViewportBottom
    ScrollViewportDelta n -> do
      (#poke GhosttyTerminalScrollViewport, tag) p GhosttyTerminalScrollViewportDelta
      (#poke GhosttyTerminalScrollViewport, value.delta) p n
    ScrollViewportRow n -> do
      (#poke GhosttyTerminalScrollViewport, tag) p GhosttyTerminalScrollViewportRow
      (#poke GhosttyTerminalScrollViewport, value.row) p n
    ScrollViewportDeltaPrompt n -> do
      (#poke GhosttyTerminalScrollViewport, tag) p GhosttyTerminalScrollViewportDeltaPrompt
      (#poke GhosttyTerminalScrollViewport, value.delta_prompt) p n
    ScrollViewportOther tag -> (#poke GhosttyTerminalScrollViewport, tag) p tag

{{layout GhosttyTerminalScrollViewport tag value}}
-- | @ghostty_terminal_scroll_viewport@: @GHOSTTY_INVALID_VALUE@ (the viewport
-- unmoved) for a tag this library does not know. The C function takes the
-- behaviour by value, so this calls a pointer shim (@gvtffi_shims.h@, §3.3).
-- @unsafe@: it does not call back into Haskell.
foreign import capi unsafe "gvtffi_shims.h gvtffi_terminal_scroll_viewport"
  ghosttyTerminalScrollViewport :: GhosttyTerminal -> Ptr GhosttyTerminalScrollViewport -> IO GhosttyResult

-- * Compression

{{enum terminal.h GhosttyTerminalCompressionMode}}
{{enum terminal.h GhosttyTerminalCompressionResult}}
-- | @ghostty_terminal_compression_activity@: an opaque token that changes when
-- compression-relevant state does. @unsafe@: it does not call back into
-- Haskell.
foreign import capi unsafe "ghostty/vt.h ghostty_terminal_compression_activity"
  ghosttyTerminalCompressionActivity :: GhosttyTerminal -> Ptr Word64 -> IO GhosttyResult

-- | @ghostty_terminal_compress@: compress eligible scrollback, one bounded
-- step or a full pass. @safe@: it calls nothing back, but a full pass can
-- stall, and an @unsafe@ call would hold every other Haskell thread up at the
-- next garbage collection.
foreign import capi safe "ghostty/vt.h ghostty_terminal_compress"
  ghosttyTerminalCompress :: GhosttyTerminal -> GhosttyTerminalCompressionMode -> Ptr GhosttyTerminalCompressionResult -> IO GhosttyResult

-- * Grid references

-- | @ghostty_terminal_grid_ref@: an untracked reference to the cell at a point,
-- valid until the next mutating call. The C function takes the point by value,
-- so this calls a pointer shim (@gvtffi_shims.h@, §3.3). @unsafe@: it does not
-- call back into Haskell.
foreign import capi unsafe "gvtffi_shims.h gvtffi_terminal_grid_ref"
  ghosttyTerminalGridRef :: GhosttyTerminal -> Ptr GhosttyPoint -> Ptr GhosttyGridRef -> IO GhosttyResult

-- | @ghostty_terminal_grid_ref_track@: a tracked reference to the cell at a
-- point, to be freed with 'Ghostty.FFI.GridRef.ghosttyTrackedGridRefFree'.
-- The C function takes the point by value, so this calls a pointer shim
-- (@gvtffi_shims.h@, §3.3). @unsafe@: it does not call back into Haskell.
foreign import capi unsafe "gvtffi_shims.h gvtffi_terminal_grid_ref_track"
  ghosttyTerminalGridRefTrack :: GhosttyTerminal -> Ptr GhosttyPoint -> Ptr GhosttyTrackedGridRef -> IO GhosttyResult

-- | @ghostty_terminal_point_from_grid_ref@: an untracked reference's position
-- in a coordinate system, or @GHOSTTY_NO_VALUE@ if it has none there.
-- @unsafe@: it does not call back into Haskell.
foreign import capi unsafe "ghostty/vt.h ghostty_terminal_point_from_grid_ref"
  ghosttyTerminalPointFromGridRef :: GhosttyTerminal -> Ptr GhosttyGridRef -> GhosttyPointTag -> Ptr GhosttyPointCoordinate -> IO GhosttyResult
