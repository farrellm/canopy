{-# LANGUAGE CApiFFI #-}
{-# LANGUAGE PatternSynonyms #-}
{-# LANGUAGE ViewPatterns #-}

-- | @include/ghostty/vt/modes.h@: the packed mode type, its helpers, the
-- named modes, and encoding a mode report (DECRPM).
--
-- A mode is not a C enum but a @uint16_t@ the header builds with a macro, so
-- the named modes are patterns over a plain number and have no @COMPLETE@
-- set: any number is some mode.
module Ghostty.FFI.Modes
  ( -- * Modes
    GhosttyMode,
    ghosttyModeNew,
    ghosttyModeValue,
    ghosttyModeAnsi,

    -- * Named modes
    {{xmodes}}

    -- * Mode reports
    {{xenum modes.h GhosttyModeReportState}}
    ghosttyModeReportEncode,
  )
where

import Foreign.C.Types (CBool (..), CChar, CInt (..), CSize (..))
import Foreign.Ptr (Ptr)
import Foreign.Storable (Storable (..))
import Ghostty.FFI.Layout (CEnum (..), unnamed)
import Ghostty.FFI.Types (GhosttyResult (..))

#include <gvtffi_shims.h>

-- | @GhosttyMode@: a mode number with its kind in the top bit, set for an ANSI
-- mode and clear for a DEC private one.
type GhosttyMode = Word16

-- | @ghostty_mode_new@: pack a mode number and whether it is ANSI.
-- A @static inline@ function, reachable only through @capi@ (§3.3).
-- @unsafe@: it does not call back into Haskell.
foreign import capi unsafe "ghostty/vt.h ghostty_mode_new"
  ghosttyModeNew :: Word16 -> CBool -> GhosttyMode

-- | @ghostty_mode_value@: the mode number without its kind bit. @unsafe@: it
-- does not call back into Haskell.
foreign import capi unsafe "ghostty/vt.h ghostty_mode_value"
  ghosttyModeValue :: GhosttyMode -> Word16

-- | @ghostty_mode_ansi@: whether the mode is an ANSI one. @unsafe@: it does not
-- call back into Haskell.
foreign import capi unsafe "ghostty/vt.h ghostty_mode_ansi"
  ghosttyModeAnsi :: GhosttyMode -> CBool

{{modes}}
-- * Mode reports

{{enum modes.h GhosttyModeReportState}}
-- | @ghostty_mode_report_encode@: encode a DECRPM reply (@CSI ? Ps1 ; Ps2 $ y@
-- for a DEC private mode, without the @?@ for an ANSI one) into a buffer. A
-- null buffer, or one too small, returns @GHOSTTY_OUT_OF_SPACE@ with the size
-- needed. @unsafe@: it does not call back into Haskell.
foreign import capi unsafe "ghostty/vt.h ghostty_mode_report_encode"
  ghosttyModeReportEncode :: GhosttyMode -> GhosttyModeReportState -> Ptr CChar -> CSize -> Ptr CSize -> IO GhosttyResult
