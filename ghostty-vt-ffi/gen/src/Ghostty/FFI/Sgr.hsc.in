{-# LANGUAGE CApiFFI #-}
{-# LANGUAGE DuplicateRecordFields #-}
{-# LANGUAGE PatternSynonyms #-}
{-# LANGUAGE ViewPatterns #-}

-- | @include/ghostty/vt/sgr.h@: a standalone SGR parser, given the parameters
-- of a @CSI … m@ sequence and iterated for the attributes they set.
--
-- An unknown attribute's parameter lists are borrowed from the parser, valid
-- until it is freed.
--
-- Every call here is @unsafe@: none calls back into Haskell, and each is
-- short.
module Ghostty.FFI.Sgr
  ( -- * Handles
    GhosttySgrParser (..),
    GhosttySgrParserImpl,

    -- * Attributes
    {{xenum sgr.h GhosttySgrAttributeTag}}
    {{xenum sgr.h GhosttySgrUnderline}}
    {{xstruct sgr.h GhosttySgrUnknown}}
    GhosttySgrAttribute (..),
    ghosttySgrAttributeLayout,
    GhosttySgrAttributeValue,

    -- * Parsers
    ghosttySgrNew,
    ghosttySgrFree,
    ghosttySgrReset,
    ghosttySgrSetParams,
    ghosttySgrNext,

    -- * Accessors
    ghosttySgrUnknownFull,
    ghosttySgrUnknownPartial,
    ghosttySgrAttributeTag,
    ghosttySgrAttributeValue,
  )
where

import Foreign.C.ConstPtr (ConstPtr (..))
import Foreign.C.Types (CBool (..), CChar, CInt (..), CSize (..))
import Foreign.Ptr (Ptr)
import Foreign.Storable (Storable (..))
import Ghostty.FFI.Allocator (GhosttyAllocator)
import Ghostty.FFI.Color (GhosttyColorPaletteIndex, GhosttyColorRgb)
import Ghostty.FFI.Layout (CEnum (..), CField (..), CStruct (..), unnamed)
import Ghostty.FFI.Types (GhosttyResult (..))

#include <gvtffi_shims.h>

-- * Handles

-- | The C side of a 'GhosttySgrParser'. Never dereferenced.
data GhosttySgrParserImpl

-- | @GhosttySgrParser@: an SGR parser, from 'ghosttySgrNew' and released by
-- 'ghosttySgrFree'.
newtype GhosttySgrParser = GhosttySgrParser (Ptr GhosttySgrParserImpl)
  deriving stock (Eq, Show)
  deriving newtype (Storable)

-- * Attributes

{{enum sgr.h GhosttySgrAttributeTag}}
{{enum sgr.h GhosttySgrUnderline}}
{{struct sgr.h GhosttySgrUnknown}}
-- | @GhosttySgrAttribute@: one attribute of an SGR sequence. A tagged union in
-- C, so a sum here with an arm per tag (§3.3); a tag without data has an arm
-- without a field.
data GhosttySgrAttribute
  = -- | @GHOSTTY_SGR_ATTR_UNSET@.
    SgrAttrUnset
  | -- | @GHOSTTY_SGR_ATTR_UNKNOWN@: @value.unknown@.
    SgrAttrUnknown GhosttySgrUnknown
  | -- | @GHOSTTY_SGR_ATTR_BOLD@.
    SgrAttrBold
  | -- | @GHOSTTY_SGR_ATTR_RESET_BOLD@.
    SgrAttrResetBold
  | -- | @GHOSTTY_SGR_ATTR_ITALIC@.
    SgrAttrItalic
  | -- | @GHOSTTY_SGR_ATTR_RESET_ITALIC@.
    SgrAttrResetItalic
  | -- | @GHOSTTY_SGR_ATTR_FAINT@.
    SgrAttrFaint
  | -- | @GHOSTTY_SGR_ATTR_UNDERLINE@: @value.underline@.
    SgrAttrUnderline GhosttySgrUnderline
  | -- | @GHOSTTY_SGR_ATTR_UNDERLINE_COLOR@: @value.underline_color@.
    SgrAttrUnderlineColor GhosttyColorRgb
  | -- | @GHOSTTY_SGR_ATTR_UNDERLINE_COLOR_256@: @value.underline_color_256@.
    SgrAttrUnderlineColor256 GhosttyColorPaletteIndex
  | -- | @GHOSTTY_SGR_ATTR_RESET_UNDERLINE_COLOR@.
    SgrAttrResetUnderlineColor
  | -- | @GHOSTTY_SGR_ATTR_OVERLINE@.
    SgrAttrOverline
  | -- | @GHOSTTY_SGR_ATTR_RESET_OVERLINE@.
    SgrAttrResetOverline
  | -- | @GHOSTTY_SGR_ATTR_BLINK@.
    SgrAttrBlink
  | -- | @GHOSTTY_SGR_ATTR_RESET_BLINK@.
    SgrAttrResetBlink
  | -- | @GHOSTTY_SGR_ATTR_INVERSE@.
    SgrAttrInverse
  | -- | @GHOSTTY_SGR_ATTR_RESET_INVERSE@.
    SgrAttrResetInverse
  | -- | @GHOSTTY_SGR_ATTR_INVISIBLE@.
    SgrAttrInvisible
  | -- | @GHOSTTY_SGR_ATTR_RESET_INVISIBLE@.
    SgrAttrResetInvisible
  | -- | @GHOSTTY_SGR_ATTR_STRIKETHROUGH@.
    SgrAttrStrikethrough
  | -- | @GHOSTTY_SGR_ATTR_RESET_STRIKETHROUGH@.
    SgrAttrResetStrikethrough
  | -- | @GHOSTTY_SGR_ATTR_DIRECT_COLOR_FG@: @value.direct_color_fg@.
    SgrAttrDirectColorFg GhosttyColorRgb
  | -- | @GHOSTTY_SGR_ATTR_DIRECT_COLOR_BG@: @value.direct_color_bg@.
    SgrAttrDirectColorBg GhosttyColorRgb
  | -- | @GHOSTTY_SGR_ATTR_BG_8@: @value.bg_8@.
    SgrAttrBg8 GhosttyColorPaletteIndex
  | -- | @GHOSTTY_SGR_ATTR_FG_8@: @value.fg_8@.
    SgrAttrFg8 GhosttyColorPaletteIndex
  | -- | @GHOSTTY_SGR_ATTR_RESET_FG@.
    SgrAttrResetFg
  | -- | @GHOSTTY_SGR_ATTR_RESET_BG@.
    SgrAttrResetBg
  | -- | @GHOSTTY_SGR_ATTR_BRIGHT_BG_8@: @value.bright_bg_8@.
    SgrAttrBrightBg8 GhosttyColorPaletteIndex
  | -- | @GHOSTTY_SGR_ATTR_BRIGHT_FG_8@: @value.bright_fg_8@.
    SgrAttrBrightFg8 GhosttyColorPaletteIndex
  | -- | @GHOSTTY_SGR_ATTR_BG_256@: @value.bg_256@.
    SgrAttrBg256 GhosttyColorPaletteIndex
  | -- | @GHOSTTY_SGR_ATTR_FG_256@: @value.fg_256@.
    SgrAttrFg256 GhosttyColorPaletteIndex
  | -- | A tag this binding does not name, whose value it cannot read.
    SgrAttrOther GhosttySgrAttributeTag
  deriving stock (Eq, Show)

instance Storable GhosttySgrAttribute where
  sizeOf _ = (#size GhosttySgrAttribute)
  alignment _ = (#alignment GhosttySgrAttribute)
  peek p =
    (#peek GhosttySgrAttribute, tag) p >>= \case
      GhosttySgrAttrUnset -> pure SgrAttrUnset
      GhosttySgrAttrUnknown -> SgrAttrUnknown <$> (#peek GhosttySgrAttribute, value.unknown) p
      GhosttySgrAttrBold -> pure SgrAttrBold
      GhosttySgrAttrResetBold -> pure SgrAttrResetBold
      GhosttySgrAttrItalic -> pure SgrAttrItalic
      GhosttySgrAttrResetItalic -> pure SgrAttrResetItalic
      GhosttySgrAttrFaint -> pure SgrAttrFaint
      GhosttySgrAttrUnderline -> SgrAttrUnderline <$> (#peek GhosttySgrAttribute, value.underline) p
      GhosttySgrAttrUnderlineColor -> SgrAttrUnderlineColor <$> (#peek GhosttySgrAttribute, value.underline_color) p
      GhosttySgrAttrUnderlineColor256 -> SgrAttrUnderlineColor256 <$> (#peek GhosttySgrAttribute, value.underline_color_256) p
      GhosttySgrAttrResetUnderlineColor -> pure SgrAttrResetUnderlineColor
      GhosttySgrAttrOverline -> pure SgrAttrOverline
      GhosttySgrAttrResetOverline -> pure SgrAttrResetOverline
      GhosttySgrAttrBlink -> pure SgrAttrBlink
      GhosttySgrAttrResetBlink -> pure SgrAttrResetBlink
      GhosttySgrAttrInverse -> pure SgrAttrInverse
      GhosttySgrAttrResetInverse -> pure SgrAttrResetInverse
      GhosttySgrAttrInvisible -> pure SgrAttrInvisible
      GhosttySgrAttrResetInvisible -> pure SgrAttrResetInvisible
      GhosttySgrAttrStrikethrough -> pure SgrAttrStrikethrough
      GhosttySgrAttrResetStrikethrough -> pure SgrAttrResetStrikethrough
      GhosttySgrAttrDirectColorFg -> SgrAttrDirectColorFg <$> (#peek GhosttySgrAttribute, value.direct_color_fg) p
      GhosttySgrAttrDirectColorBg -> SgrAttrDirectColorBg <$> (#peek GhosttySgrAttribute, value.direct_color_bg) p
      GhosttySgrAttrBg8 -> SgrAttrBg8 <$> (#peek GhosttySgrAttribute, value.bg_8) p
      GhosttySgrAttrFg8 -> SgrAttrFg8 <$> (#peek GhosttySgrAttribute, value.fg_8) p
      GhosttySgrAttrResetFg -> pure SgrAttrResetFg
      GhosttySgrAttrResetBg -> pure SgrAttrResetBg
      GhosttySgrAttrBrightBg8 -> SgrAttrBrightBg8 <$> (#peek GhosttySgrAttribute, value.bright_bg_8) p
      GhosttySgrAttrBrightFg8 -> SgrAttrBrightFg8 <$> (#peek GhosttySgrAttribute, value.bright_fg_8) p
      GhosttySgrAttrBg256 -> SgrAttrBg256 <$> (#peek GhosttySgrAttribute, value.bg_256) p
      GhosttySgrAttrFg256 -> SgrAttrFg256 <$> (#peek GhosttySgrAttribute, value.fg_256) p
      tag@(GhosttySgrAttributeTagUnknown _) -> pure (SgrAttrOther tag)
  poke p = \case
    SgrAttrUnset -> (#poke GhosttySgrAttribute, tag) p GhosttySgrAttrUnset
    SgrAttrUnknown v -> do
      (#poke GhosttySgrAttribute, tag) p GhosttySgrAttrUnknown
      (#poke GhosttySgrAttribute, value.unknown) p v
    SgrAttrBold -> (#poke GhosttySgrAttribute, tag) p GhosttySgrAttrBold
    SgrAttrResetBold -> (#poke GhosttySgrAttribute, tag) p GhosttySgrAttrResetBold
    SgrAttrItalic -> (#poke GhosttySgrAttribute, tag) p GhosttySgrAttrItalic
    SgrAttrResetItalic -> (#poke GhosttySgrAttribute, tag) p GhosttySgrAttrResetItalic
    SgrAttrFaint -> (#poke GhosttySgrAttribute, tag) p GhosttySgrAttrFaint
    SgrAttrUnderline v -> do
      (#poke GhosttySgrAttribute, tag) p GhosttySgrAttrUnderline
      (#poke GhosttySgrAttribute, value.underline) p v
    SgrAttrUnderlineColor v -> do
      (#poke GhosttySgrAttribute, tag) p GhosttySgrAttrUnderlineColor
      (#poke GhosttySgrAttribute, value.underline_color) p v
    SgrAttrUnderlineColor256 v -> do
      (#poke GhosttySgrAttribute, tag) p GhosttySgrAttrUnderlineColor256
      (#poke GhosttySgrAttribute, value.underline_color_256) p v
    SgrAttrResetUnderlineColor -> (#poke GhosttySgrAttribute, tag) p GhosttySgrAttrResetUnderlineColor
    SgrAttrOverline -> (#poke GhosttySgrAttribute, tag) p GhosttySgrAttrOverline
    SgrAttrResetOverline -> (#poke GhosttySgrAttribute, tag) p GhosttySgrAttrResetOverline
    SgrAttrBlink -> (#poke GhosttySgrAttribute, tag) p GhosttySgrAttrBlink
    SgrAttrResetBlink -> (#poke GhosttySgrAttribute, tag) p GhosttySgrAttrResetBlink
    SgrAttrInverse -> (#poke GhosttySgrAttribute, tag) p GhosttySgrAttrInverse
    SgrAttrResetInverse -> (#poke GhosttySgrAttribute, tag) p GhosttySgrAttrResetInverse
    SgrAttrInvisible -> (#poke GhosttySgrAttribute, tag) p GhosttySgrAttrInvisible
    SgrAttrResetInvisible -> (#poke GhosttySgrAttribute, tag) p GhosttySgrAttrResetInvisible
    SgrAttrStrikethrough -> (#poke GhosttySgrAttribute, tag) p GhosttySgrAttrStrikethrough
    SgrAttrResetStrikethrough -> (#poke GhosttySgrAttribute, tag) p GhosttySgrAttrResetStrikethrough
    SgrAttrDirectColorFg v -> do
      (#poke GhosttySgrAttribute, tag) p GhosttySgrAttrDirectColorFg
      (#poke GhosttySgrAttribute, value.direct_color_fg) p v
    SgrAttrDirectColorBg v -> do
      (#poke GhosttySgrAttribute, tag) p GhosttySgrAttrDirectColorBg
      (#poke GhosttySgrAttribute, value.direct_color_bg) p v
    SgrAttrBg8 v -> do
      (#poke GhosttySgrAttribute, tag) p GhosttySgrAttrBg8
      (#poke GhosttySgrAttribute, value.bg_8) p v
    SgrAttrFg8 v -> do
      (#poke GhosttySgrAttribute, tag) p GhosttySgrAttrFg8
      (#poke GhosttySgrAttribute, value.fg_8) p v
    SgrAttrResetFg -> (#poke GhosttySgrAttribute, tag) p GhosttySgrAttrResetFg
    SgrAttrResetBg -> (#poke GhosttySgrAttribute, tag) p GhosttySgrAttrResetBg
    SgrAttrBrightBg8 v -> do
      (#poke GhosttySgrAttribute, tag) p GhosttySgrAttrBrightBg8
      (#poke GhosttySgrAttribute, value.bright_bg_8) p v
    SgrAttrBrightFg8 v -> do
      (#poke GhosttySgrAttribute, tag) p GhosttySgrAttrBrightFg8
      (#poke GhosttySgrAttribute, value.bright_fg_8) p v
    SgrAttrBg256 v -> do
      (#poke GhosttySgrAttribute, tag) p GhosttySgrAttrBg256
      (#poke GhosttySgrAttribute, value.bg_256) p v
    SgrAttrFg256 v -> do
      (#poke GhosttySgrAttribute, tag) p GhosttySgrAttrFg256
      (#poke GhosttySgrAttribute, value.fg_256) p v
    SgrAttrOther tag -> (#poke GhosttySgrAttribute, tag) p tag

{{layout GhosttySgrAttribute tag value}}
-- | @GhosttySgrAttributeValue@: an attribute's value union, only ever pointed
-- to ('ghosttySgrAttributeValue'). 'GhosttySgrAttribute' reads the arm its tag
-- selects.
data GhosttySgrAttributeValue

-- * Parsers

-- | @ghostty_sgr_new@: a parser, with the allocator (null for the default).
-- @unsafe@: it does not call back into Haskell.
foreign import capi unsafe "ghostty/vt.h ghostty_sgr_new"
  ghosttySgrNew :: Ptr GhosttyAllocator -> Ptr GhosttySgrParser -> IO GhosttyResult

-- | @ghostty_sgr_free@ (null is a no-op), which ends every unknown attribute's
-- lists too. @unsafe@: it does not call back into Haskell.
foreign import capi unsafe "ghostty/vt.h ghostty_sgr_free"
  ghosttySgrFree :: GhosttySgrParser -> IO ()

-- | @ghostty_sgr_reset@: start the iteration over, keeping the parameters.
-- @unsafe@: it does not call back into Haskell.
foreign import capi unsafe "ghostty/vt.h ghostty_sgr_reset"
  ghosttySgrReset :: GhosttySgrParser -> IO ()

-- | @ghostty_sgr_set_params@: the parameters to parse (copied), with each one's
-- separator, @;@ or @:@ (null for all @;@), and reset. @unsafe@: it does not
-- call back into Haskell.
foreign import capi unsafe "ghostty/vt.h ghostty_sgr_set_params"
  ghosttySgrSetParams :: GhosttySgrParser -> Ptr Word16 -> Ptr CChar -> CSize -> IO GhosttyResult

-- | @ghostty_sgr_next@: the next attribute, through the out pointer; false when
-- there are no more. @unsafe@: it does not call back into Haskell.
foreign import capi unsafe "ghostty/vt.h ghostty_sgr_next"
  ghosttySgrNext :: GhosttySgrParser -> Ptr GhosttySgrAttribute -> IO CBool

-- * Accessors

-- | @ghostty_sgr_unknown_full@: an unknown attribute's whole parameter list,
-- its length, and through the out pointer (which may be null) its address.
-- For a binding that cannot read struct fields. The C function takes the
-- attribute's data by value, so this calls a pointer shim (@gvtffi_shims.h@,
-- §3.3). @unsafe@: it does not call back into Haskell.
foreign import capi unsafe "gvtffi_shims.h gvtffi_sgr_unknown_full"
  ghosttySgrUnknownFull :: Ptr GhosttySgrUnknown -> Ptr (ConstPtr Word16) -> IO CSize

-- | @ghostty_sgr_unknown_partial@: as 'ghosttySgrUnknownFull', for the part of
-- the list where parsing stopped. Through a pointer shim (§3.3). @unsafe@: it
-- does not call back into Haskell.
foreign import capi unsafe "gvtffi_shims.h gvtffi_sgr_unknown_partial"
  ghosttySgrUnknownPartial :: Ptr GhosttySgrUnknown -> Ptr (ConstPtr Word16) -> IO CSize

-- | @ghostty_sgr_attribute_tag@: an attribute's tag. For a binding that cannot
-- read struct fields. The C function takes the attribute by value, so this
-- calls a pointer shim (@gvtffi_shims.h@, §3.3). @unsafe@: it does not call
-- back into Haskell.
foreign import capi unsafe "gvtffi_shims.h gvtffi_sgr_attribute_tag"
  ghosttySgrAttributeTag :: Ptr GhosttySgrAttribute -> IO GhosttySgrAttributeTag

-- | @ghostty_sgr_attribute_value@: the address of an attribute's value union,
-- inside the attribute. @unsafe@: it does not call back into Haskell.
foreign import capi unsafe "ghostty/vt.h ghostty_sgr_attribute_value"
  ghosttySgrAttributeValue :: Ptr GhosttySgrAttribute -> IO (Ptr GhosttySgrAttributeValue)
