{-# LANGUAGE CApiFFI #-}
{-# LANGUAGE DuplicateRecordFields #-}
{-# LANGUAGE PatternSynonyms #-}
{-# LANGUAGE ViewPatterns #-}

-- | The callback half of @include/ghostty/vt/terminal.h@ ("effects"): the
-- function type behind each callback 'Ghostty.FFI.Terminal.GhosttyTerminalOption',
-- the @wrapper@ that makes one from a Haskell function, and the structs the
-- library passes to them.
--
-- Every struct a callback receives is borrowed for the call, and so is every
-- string inside it: copy out with 'Ghostty.FFI.Types.ghosttyStringBytes'
-- before returning. A callback runs inside a VT write, so it must not write to
-- the same terminal, and the call that runs it must be @safe@ (§3.3).
--
-- Two callbacks return a 'GhosttyString' by value, which a @wrapper@ cannot
-- make: @ENQUIRY@ ('GhosttyTerminalEnquiryFn') and @XTVERSION@
-- ('GhosttyTerminalXtversionFn'). Their types are here; a function for either
-- has to be written in C. @ghostty-effectful@ answers both from its
-- configuration (§4.5).
module Ghostty.FFI.Terminal.Callbacks
  ( -- * Callback types
    {{xfn wrapper terminal.h GhosttyTerminalWritePtyFn}}
    {{xfn wrapper terminal.h GhosttyTerminalBellFn}}
    {{xfn wrapper terminal.h GhosttyTerminalTitleChangedFn}}
    {{xfn wrapper terminal.h GhosttyTerminalPwdChangedFn}}
    {{xfn wrapper terminal.h GhosttyTerminalSizeFn}}
    {{xfn wrapper terminal.h GhosttyTerminalColorSchemeFn}}
    {{xfn wrapper terminal.h GhosttyTerminalDeviceAttributesFn}}
    {{xfn wrapper terminal.h GhosttyTerminalClipboardWriteFn}}
    {{xfn wrapper terminal.h GhosttyTerminalClipboardReadFn}}
    {{xfn wrapper terminal.h GhosttyTerminalDesktopNotificationFn}}
    {{xfn wrapper terminal.h GhosttyTerminalProgressReportFn}}
    {{xfn wrapper terminal.h GhosttyTerminalProgramStatusFn}}
    {{xfn wrapper terminal.h GhosttyTerminalSemanticPromptFn}}
    {{xfn wrapper terminal.h GhosttyTerminalResetFn}}
    {{xfn wrapper terminal.h GhosttyTerminalRenderHoldFn}}
    {{xfn wrapper terminal.h GhosttyTerminalUnknownSequenceFn}}
    {{xfn wrapper terminal.h GhosttyTerminalResizeWindowFn}}
    {{xfn wrapper terminal.h GhosttyTerminalEnquiryFn}}
    {{xfn wrapper terminal.h GhosttyTerminalXtversionFn}}

    -- * Unknown sequences
    {{xenum terminal.h GhosttyTerminalUnknownSequenceTag}}
    {{xstruct terminal.h GhosttyTerminalUnknownStringSequence}}
    {{xstruct terminal.h GhosttyTerminalUnknownOscSequence}}
    GhosttyTerminalUnknownSequence (..),
    ghosttyTerminalUnknownSequenceLayout,

    -- * Clipboard
    {{xenum terminal.h GhosttyClipboardLocation}}
    {{xstruct terminal.h GhosttyClipboardContent}}
    {{xenum terminal.h GhosttyClipboardWriteResult}}
    {{xstruct terminal.h GhosttyClipboardWriteReply}}
    {{xstruct terminal.h GhosttyClipboardWrite}}
    {{xfn dynamic terminal.h GhosttyClipboardWriteReplyFn}}
    {{xenum terminal.h GhosttyClipboardReadResult}}
    {{xstruct terminal.h GhosttyClipboardReadReply}}
    {{xstruct terminal.h GhosttyClipboardRead}}
    {{xfn dynamic terminal.h GhosttyClipboardReadReplyFn}}

    -- * Notifications and progress
    {{xstruct terminal.h GhosttyTerminalDesktopNotification}}
    {{xenum terminal.h GhosttyTerminalProgressState}}
    {{xstruct terminal.h GhosttyTerminalProgressReport}}
    {{xenum terminal.h GhosttyProgramStatusState}}
    {{xenum terminal.h GhosttyProgramStatusKind}}
    {{xstruct terminal.h GhosttyTerminalProgramStatus}}

    -- * Semantic prompts
    {{xenum terminal.h GhosttySemanticPromptKind}}
    {{xenum terminal.h GhosttySemanticPromptPromptKind}}
    {{xstruct terminal.h GhosttyTerminalSemanticPrompt}}

    -- * Window resize requests
    {{xenum terminal.h GhosttyTerminalResizeWindowTag}}
    {{xstruct terminal.h GhosttyTerminalResizeWindowGrid}}
    GhosttyTerminalResizeWindow (..),
    ghosttyTerminalResizeWindowLayout,
  )
where

