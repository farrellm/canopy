cabal-version:      3.14
name:               tree-sitter-effectful
version:            0.1.0.0
synopsis:           A pure, typed interface to tree-sitter
description:
  Persistent trees with pure node reads, typed node kinds, typed query
  captures and a confined parser effect (DESIGN.md §5B).

license:            BSD-3-Clause
license-file:       LICENSE
author:             Matthew Farrell
maintainer:         farrellm@alum.mit.edu
category:           Parsing
build-type:         Simple
tested-with:        GHC ==9.12.4

-- DESIGN.md §2.4. CI adds -Werror from the command line. The two common stanzas
-- are copied into every package; scripts/check-common-stanzas.sh keeps them equal.
common warnings
  ghc-options:
    -Wall -Wcompat -Widentities -Wincomplete-record-updates
    -Wincomplete-uni-patterns -Wmissing-export-lists -Wpartial-fields
    -Wredundant-constraints -Wmissing-deriving-strategies -Wunused-type-patterns

common extensions
  default-extensions:
    OverloadedRecordDot
    OverloadedStrings
    OverloadedLabels

library
  import:           warnings, extensions
  exposed-modules:  TreeSitter
  hs-source-dirs:   src
  build-depends:
    , base ^>=4.21.2.0
    , canopy-prelude
    , tree-sitter-ffi

  mixins:
    base hiding (Prelude),
    canopy-prelude (Canopy.Prelude as Prelude)

  default-language: GHC2024

test-suite tree-sitter-effectful-test
  import:           warnings, extensions
  type:             exitcode-stdio-1.0
  hs-source-dirs:   test
  main-is:          Main.hs
  other-modules:    Test.TreeSitter
  build-depends:
    , base ^>=4.21.2.0
    , canopy-prelude
    , tasty ^>=1.5
    , tasty-hunit ^>=0.10.2
    , tree-sitter-effectful

  mixins:
    base hiding (Prelude),
    canopy-prelude (Canopy.Prelude as Prelude)

  default-language: GHC2024
