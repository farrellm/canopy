cabal-version:      3.14
name:               ghostty-effectful
version:            0.1.0.0
synopsis:           A safe effectful interface to libghostty-vt
description:
  Scoped handles, typed keys, and events instead of callbacks over
  ghostty-vt-ffi (DESIGN.md §4).

license:            BSD-3-Clause
license-file:       LICENSE
author:             Matthew Farrell
maintainer:         farrellm@alum.mit.edu
category:           Terminal
build-type:         Simple
tested-with:        GHC ==9.12.4

-- DESIGN.md §2.4. CI adds -Werror from the command line. The two common stanzas
-- are copied into every package; scripts/check-common-stanzas.sh keeps them equal.
common warnings
  ghc-options:
    -Wall -Wcompat -Widentities -Wincomplete-record-updates
    -Wincomplete-uni-patterns -Wmissing-export-lists -Wpartial-fields
    -Wredundant-constraints -Wmissing-deriving-strategies -Wunused-type-patterns

common extensions
  default-extensions:
    OverloadedRecordDot
    OverloadedStrings
    OverloadedLabels

library
  import:           warnings, extensions
  exposed-modules:
    Ghostty.Effectful
    Ghostty.Effectful.Cell
    Ghostty.Effectful.Color
    Ghostty.Effectful.Encode
    Ghostty.Effectful.Error
    Ghostty.Effectful.Event
    Ghostty.Effectful.Format
    Ghostty.Effectful.Input
    Ghostty.Effectful.Internal.Callbacks
    Ghostty.Effectful.Internal.Convert
    Ghostty.Effectful.Internal.Effect
    Ghostty.Effectful.Internal.Encode
    Ghostty.Effectful.Internal.Error
    Ghostty.Effectful.Internal.Feed
    Ghostty.Effectful.Internal.Format
    Ghostty.Effectful.Internal.Keys
    Ghostty.Effectful.Internal.Parse
    Ghostty.Effectful.Internal.Render
    Ghostty.Effectful.Internal.Size
    Ghostty.Effectful.Internal.Terminal
    Ghostty.Effectful.Internal.Unicode
    Ghostty.Effectful.Mode
    Ghostty.Effectful.Parse
    Ghostty.Effectful.Point
    Ghostty.Effectful.Render
    Ghostty.Effectful.Render.Keys
    Ghostty.Effectful.Style
    Ghostty.Effectful.Terminal
    Ghostty.Effectful.Terminal.Keys
    Ghostty.Effectful.Unicode

  hs-source-dirs:   src

  -- ENQ and XTVERSION's answers return a struct by value, which no Haskell
  -- callback can (DESIGN.md §3.3, §4.5); a render hold captures its frame
  -- with a C call inside the callback (§4.3); a paste's MIME reader receives
  -- structs by value (§3.3).
  include-dirs:     include
  includes:
    gveff_terminal.h
    gveff_paste.h

  c-sources:
    cbits/gveff_terminal.c
    cbits/gveff_paste.c

  build-depends:
    , array ^>=0.5.8
    , base ^>=4.21.2.0
    , bytestring ^>=0.12
    , canopy-prelude
    , containers ^>=0.7
    , effectful-core ^>=2.7.1
    , ghostty-vt-ffi
    , text ^>=2.1
    , vector ^>=0.13

  mixins:
    base hiding (Prelude),
    canopy-prelude (Canopy.Prelude as Prelude)

  default-language: GHC2024

test-suite ghostty-effectful-test
  import:           warnings, extensions
  type:             exitcode-stdio-1.0
  hs-source-dirs:   test
  main-is:          Main.hs
  other-modules:
    Test.Ghostty.Effectful
    Test.Ghostty.Effectful.Encode
    Test.Ghostty.Effectful.Error
    Test.Ghostty.Effectful.Events
    Test.Ghostty.Effectful.Format
    Test.Ghostty.Effectful.Keys
    Test.Ghostty.Effectful.Parse
    Test.Ghostty.Effectful.Region
    Test.Ghostty.Effectful.Render
    Test.Ghostty.Effectful.Support
    Test.Ghostty.Effectful.Terminal
    Test.Ghostty.Effectful.TrackedRef
    Test.Ghostty.Effectful.Unicode

  build-depends:
    , base ^>=4.21.2.0
    , bytestring ^>=0.12
    , canopy-prelude
    , effectful-core ^>=2.7.1
    , ghostty-effectful
    , ghostty-vt-ffi
    , tasty ^>=1.5
    , tasty-golden ^>=2.3.5
    , tasty-hunit ^>=0.10.2
    , text ^>=2.1
    , vector ^>=0.13

  mixins:
    base hiding (Prelude),
    canopy-prelude (Canopy.Prelude as Prelude)

  default-language: GHC2024

-- DESIGN.md §12.3. Compiled with -O2, and -T so allocation is reported beside
-- time; the library is at cabal's default optimization, as in every build.
-- CI gates allocation against bench/baseline/ (§2.8 step 8).
benchmark ghostty-effectful-bench
  import:           warnings, extensions
  type:             exitcode-stdio-1.0
  hs-source-dirs:   bench
  main-is:          Main.hs
  other-modules:
    Bench.Ghostty.Effectful.Feed
    Bench.Ghostty.Effectful.Render
  ghc-options:      -O2 -with-rtsopts=-T
  build-depends:
    , base ^>=4.21.2.0
    , bytestring ^>=0.12
    , canopy-prelude
    , effectful-core ^>=2.7.1
    , ghostty-effectful
    , tasty-bench ^>=0.5.1
    , text ^>=2.1
    , vector ^>=0.13

  mixins:
    base hiding (Prelude),
    canopy-prelude (Canopy.Prelude as Prelude)

  default-language: GHC2024
